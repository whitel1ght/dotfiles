#!/usr/bin/env bash
# review-extract <frontmatter|diary|logs|decisions> ...: inputs for /review, kept out of the command
# markdown because Claude Code substitutes positional-looking tokens there.
#   frontmatter <template> <date> <period>   template frontmatter with {{date}} and {{period}} filled
#   diary <vault> <from> <to>                diary files dated in range, one path per line
#   logs <vault> <from> <to>                 log entries dated in range, each file under a '--- path' line
#   decisions <vault> <from> <to>            decision files whose `date:` is in range, one path per line
set -uo pipefail
shopt -s nullglob

in_range() { [[ ! "$1" < "$2" && ! "$1" > "$3" ]]; }

cmd="${1:-}"
case "$cmd" in
  frontmatter)
    [ $# -eq 4 ] || { echo "usage: review-extract frontmatter <template> <date> <period>" >&2; exit 2; }
    awk 'NR==1 && $0!="---"{exit} {print} NR>1 && $0=="---"{exit}' "$2" | sed "s/{{date}}/$3/; s/{{period}}/$4/"
    ;;
  diary)
    [ $# -eq 4 ] || { echo "usage: review-extract diary <vault> <from> <to>" >&2; exit 2; }
    for f in "$2"/diary/20??-??-??.md; do
      n="$(basename "$f" .md)"
      in_range "$n" "$3" "$4" && echo "$f"
    done
    ;;
  logs)
    [ $# -eq 4 ] || { echo "usage: review-extract logs <vault> <from> <to>" >&2; exit 2; }
    echo "# log entries dated $3 to $4 under $2/projects/*/log/"
    for f in "$2"/projects/*/log/*.md; do
      awk -v from="$3" -v to="$4" -v file="$f" '
        /^## 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ { d = substr($2, 1, 10); on = (d >= from && d <= to); if (on) print "--- " file }
        /^## / && !/^## 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ { on = 0 }
        on' "$f"
    done
    ;;
  decisions)
    [ $# -eq 4 ] || { echo "usage: review-extract decisions <vault> <from> <to>" >&2; exit 2; }
    for f in "$2"/projects/*/decisions/*.md; do
      d="$(sed -n 's/^date: *//p' "$f" | head -1)"
      [ -n "$d" ] && in_range "$d" "$3" "$4" && echo "$f"
    done
    ;;
  *)
    echo "usage: review-extract frontmatter|diary|logs|decisions ..." >&2
    exit 2
    ;;
esac
exit 0
