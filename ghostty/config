font-size = 17
theme = TokyoNight Storm
window-padding-x = 10
window-padding-y = 10, 0
window-padding-balance = true

# No titlebar, but still mouse-resizable. "client" keeps GTK client-side
# decorations (invisible resize border + shadow); gtk-titlebar = false
# removes only the headerbar. Do NOT use window-decoration = none here:
# GNOME/Wayland has no server-side decorations, so the window would lose
# its resize edges entirely.
window-decoration = client
gtk-titlebar = false

# Hide the tab bar too (tabs still work: ctrl+shift+t / ctrl+tab, or use a
# keybind for toggle_tab_overview).
# Note: gtk-tabs-location = hidden would put a tab-count button in the
# titlebar, which we just hid, so change window-show-tab-bar instead.
window-show-tab-bar = never

# Keep i3's Super/Mod4 workspace and window bindings available. Use Neovim's
# native leader and navigation mappings instead of intercepting Super here.
# Shift+Enter is intentionally unbound so tmux/Pi can receive the modified key.
