font-size = 17
macos-titlebar-style = hidden
macos-option-as-alt = true
theme = TokyoNight Storm
window-padding-x = 10
window-padding-y = 10, 0
window-padding-balance = true

# Reserved Ctrl-Shift-F1..F9: tmux gates them; Neovim maps them as F37..F45.
keybind = super+p=csi:1;6P
keybind = super+s=csi:1;6Q
keybind = super+w=csi:1;6R
keybind = super+f=csi:1;6S
keybind = super+/=csi:15;6~

keybind = super+h=csi:17;6~
keybind = super+j=csi:18;6~
keybind = super+k=csi:19;6~
keybind = super+l=csi:20;6~
keybind = shift+enter=text:\n
