[Unit]
Description=Run the decisions Telegram bot
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.local/state/run-day/decisions/telegram.json

[Service]
ExecStartPre=/usr/bin/test -x %h/.local/share/decisions/bin/decisions
Type=simple
Restart=on-failure
RestartSec=30s
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/decisions telegram run
StandardOutput=journal
StandardError=journal
