# === Database + Redis ===
# Generic defaults: connect to whatever Postgres is on localhost:5432 and Redis
# is on localhost:6379. Works on:
#   - A developer Mac with `ecfx_postgres` / `ecfx_redis` containers exposing
#     5432/6379 to the host.
#   - Inside a container that has Postgres/Redis sidecars on the same compose
#     network using DNS names — override REDIS_URI / DATASOURCES_DEFAULT_URL
#     in your shell or in $PROJECT_ROOT/.claude/receipts.env in that case.
#
# REDIS_URI maps to redis.uri (AbstractRedisConfiguration.getUri()). The CLI's
# application-local.yml has the non-standard "redis.url" which is silently
# ignored — full redis:// URI required.
REDIS_URI=redis://localhost:6379
DATASOURCES_DEFAULT_URL=jdbc:postgresql://localhost:5432/ecfx?currentSchema=extensions,public_v1

# === AWS ===
AWS_ACCESS_KEY_ID=__FILL_ME_IN__
AWS_SECRET_ACCESS_KEY=__FILL_ME_IN__

# === Core ECFX Config ===
ECFX_ENVIRONMENT=local
ECFX_BASE_DOMAIN=myecfxlocal.com
ECFX_DOCUMENT_BUCKET=ecfx-court-documents-local
DOCUMENT_BUCKET=ecfx-court-documents-local
ECFX_ENC_SERVICE_USERNAME=__FILL_ME_IN__
ECFX_ENC_SERVICE_PW=__FILL_ME_IN__
ECFX_POST_PROCESSING_ENABLED=true
PROCESSOR_LOGGING_BUCKET=ecfx-processor-logging-local
SENTRY_DSN=

