# === New Jersey Courts ===
# NJ Selenium service runs on the host at port 5050 (5000 is taken by macOS Control
# Center / AirPlay). `host.docker.internal` resolves the macOS host from inside
# Docker Desktop networks (including the claude-code-container).
ECFX_NEWJERSEY_SELENIUM_APP_HOST=http://host.docker.internal:5050
# Public-access user is firm-wide; bean is @Requires-gated, so without these the NJ processor
# can't fall back to public access for non-criminal courts.
NEW_JERSEY_PUBLIC_USER_USERNAME=__FILL_ME_IN__
NEW_JERSEY_PUBLIC_USER_PASSWORD=__FILL_ME_IN__
