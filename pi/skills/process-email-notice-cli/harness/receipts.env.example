# === Camoufox WebDriver ===
# Browser-automation grid (Tyler / NYSCEF / Peachcourt providers).
# `host.docker.internal` resolves the macOS host from inside docker-compose networks
# on Docker Desktop, including from the claude-code-container. If you run Camoufox
# as its own sidecar instead, change this to the service DNS name (e.g. http://camoufox:4445).
CAMOUFOX_GRID_URL=http://host.docker.internal:4445

