# === Database + Redis (macOS Docker: use host.docker.internal) ===
# REDIS_URI maps to redis.uri which is read by AbstractRedisConfiguration.getUri() in RedisFactory.
# The CLI's application-local.yml has "redis.url" which is NOT a standard Micronaut Lettuce property
# and is silently ignored. All other services use "redis.uri". Full redis:// URI format required.
REDIS_URI=redis://host.docker.internal:6379
DATASOURCES_DEFAULT_URL=jdbc:postgresql://host.docker.internal:5432/ecfx?currentSchema=extensions,public_v1

# === AWS ===
AWS_ACCESS_KEY_ID=__FILL_ME_IN__
AWS_SECRET_ACCESS_KEY=__FILL_ME_IN__

# === Core ECFX Config ===
ECFX_ENVIRONMENT=local
ECFX_BASE_DOMAIN=myecfxlocal.com
ECFX_DOCUMENT_BUCKET=ecfx-court-documents-local
DOCUMENT_BUCKET=ecfx-court-documents-local
ECFX_ENC_SERVICE_USERNAME=__FILL_ME_IN__
ECFX_ENC_SERVICE_PW=__FILL_ME_IN__
ECFX_POST_PROCESSING_ENABLED=true
PROCESSOR_LOGGING_BUCKET=ecfx-processor-logging-local
SENTRY_DSN=

# === DMS Integrations ===
BOX_CLIENT_KEY=__FILL_ME_IN__
BOX_CLIENT_SECRET=__FILL_ME_IN__
CLIO_AUTH_REDIRECT_URL=localhost:9999
CLIO_CLIENT_KEY=__FILL_ME_IN__
CLIO_CLIENT_SECRET=__FILL_ME_IN__
DROPBOX_CLIENT_KEY=__FILL_ME_IN__
DROPBOX_CLIENT_SECRET=__FILL_ME_IN__
NET_DOCUMENTS_CLIENT_KEY=__FILL_ME_IN__
NET_DOCUMENTS_CLIENT_SECRET=__FILL_ME_IN__
NET_DOCUMENTS_REDIRECT_URL=localhost:9999

# === Email / Notifications ===
POSTMARK_API_TOKEN=__FILL_ME_IN__
SENDGRID_INBOUND_PASSWORD=__FILL_ME_IN__
SOCKETLABS_API_TOKEN=__FILL_ME_IN__
SOCKETLABS_SERVER_ID=__FILL_ME_IN__

# === OpenAI Stamp Comparison ===
OPENAI_STAMP_COMPARISON_API_KEY=__FILL_ME_IN__
OPENAI_STAMP_COMPARISON_ENABLED=true

# === Camoufox WebDriver (running on host, accessed from inside container) ===
CAMOUFOX_GRID_URL=http://host.docker.internal:4445

# === Florida Proxy ===
ECFX_FLORIDA_PROXY_HOST=http://test.myecfxlocal.com
ECFX_FLORIDA_PROXY_PORT=8080

# === Title Extract ===
TITLE_EXTRACT_AUTH_PATH=__FILL_ME_IN__
