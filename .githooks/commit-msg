#!/bin/sh
# Two checks, both opt-out per commit with a line in the message:
#  - docs-check: a change to something the system manual (~/wiki/tools)
#    documents needs that page updated ("Docs: none" opts out).
#  - pi-parity: a change to a Claude playbook needs its pi twin brought in step
#    ("Pi: later" opts out).
root="$(git rev-parse --show-toplevel)"
"$root/bin/docs-check" commit-msg "$1" || exit 1
"$root/bin/pi-parity" commit-msg "$1" || exit 1
