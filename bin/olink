#!/usr/bin/env bash
# Relink the OpenCode config into ~/.config/opencode and refresh the running
# server, without running the whole install.sh.
#
#   olink              relink everything, then reload OpenCode
#   olink -n           show what would change, touch nothing
#   olink --no-reload  relink, but skip the opencode reload
#   olink -h           this help
#
# install.sh links these too, but its create_symlink skips any target that is
# already a symlink — even a broken one, or one pointing at the wrong place.
# olink re-points it. That is the whole reason to reach for it after moving the
# repo, restoring a checkout, or finding a skill that simply never appears.
#
# The destinations mirror install.sh exactly, including `command` singular: this
# build of OpenCode reads ~/.config/opencode/command, and linking the plural
# would be a silent no-op.
#
# Env overrides (used by bin/olink.test.sh):
#   DOTFILES_DIR         repo root; defaults to the parent of this script
#   OPENCODE_CONFIG_DIR  config dir; defaults to ~/.config/opencode
set -uo pipefail

# Resolve this script through any symlink so the repo is found from
# ~/.local/bin/olink as well as from a checkout.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    self_dir="$(cd -P "$(dirname "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
REPO_DIR="$(cd -P "$(dirname "$self")/.." && pwd)"

DOTFILES_DIR="${DOTFILES_DIR:-$REPO_DIR}"
OC_SRC="$DOTFILES_DIR/opencode"
OC_DEST="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()  { echo -e "${GREEN}[olink]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[olink]${NC} $1"; }
log_error() { echo -e "${RED}[olink]${NC} $1" >&2; }

usage() {
    cat <<'EOF'
Usage: olink [options]

Relink the OpenCode config into ~/.config/opencode, then reload OpenCode.

Options:
  -n, --dry-run    show what would change, touch nothing
      --no-reload  skip the opencode reload
  -h, --help       show this help

Env:
  DOTFILES_DIR         repo root (default: parent of this script)
  OPENCODE_CONFIG_DIR  config dir (default: ~/.config/opencode)
EOF
}

DRY_RUN=0
DO_RELOAD=1
CHANGED=0
FAILURES=0

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        --no-reload)  DO_RELOAD=0 ;;
        -h|--help)    usage; exit 0 ;;
        *) log_error "unknown option: $arg"; exit 2 ;;
    esac
done

# Point $dest at $src, repairing rather than skipping what is already there.
link_item() {
    local src="$1" dest="$2"

    if [ -L "$dest" ]; then
        [ "$(readlink "$dest")" = "$src" ] && return 0
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would re-point $dest -> $src (now $(readlink "$dest"))"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        rm -f "$dest"
        ln -s "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_info "re-pointed $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi

    if [ -e "$dest" ]; then
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would back up $dest and link it -> $src"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        mv "$dest" "$dest.backup" || { log_error "failed to back up $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_warn "backed up $dest -> $dest.backup"
    fi

    if [ "$DRY_RUN" = 1 ]; then
        log_info "would link $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi
    ln -s "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
    log_info "linked $dest -> $src"
    CHANGED=$((CHANGED + 1))
}

# Themes and plugins are linked per entry, like install.sh: OpenCode owns those
# directories, so replacing the whole directory would be hostile.
link_dir_entries() {
    local src_dir="$1" dest_dir="$2" entry name
    [ -d "$src_dir" ] || return 0
    mkdir -p "$dest_dir"
    for entry in "$src_dir"/*; do
        [ -e "$entry" ] || continue
        name="$(basename "$entry")"
        [ "$name" = ".gitkeep" ] && continue
        link_item "$entry" "$dest_dir/$name"
    done
}

if [ ! -d "$OC_SRC" ]; then
    log_error "no OpenCode config at $OC_SRC (set DOTFILES_DIR)"
    exit 1
fi

mkdir -p "$OC_DEST"

[ -f "$OC_SRC/opencode.jsonc" ] && link_item "$OC_SRC/opencode.jsonc" "$OC_DEST/opencode.jsonc"

link_item "$OC_SRC/commands" "$OC_DEST/command"
link_item "$OC_SRC/skills"   "$OC_DEST/skills"
link_item "$OC_SRC/agents"   "$OC_DEST/agents"
link_item "$OC_SRC/modules"  "$OC_DEST/modules"

link_dir_entries "$OC_SRC/themes"  "$OC_DEST/themes"
link_dir_entries "$OC_SRC/plugins" "$OC_DEST/plugins"

if [ "$DRY_RUN" = 0 ] && [ "$DO_RELOAD" = 1 ]; then
    if ! command -v opencode >/dev/null 2>&1; then
        log_warn "opencode not found on PATH — skipping reload"
    elif opencode reload >/dev/null 2>&1; then
        log_info "opencode reloaded"
    else
        log_warn "opencode reload failed (no running server?) — start OpenCode to pick up changes"
    fi
fi

if [ "$DRY_RUN" = 1 ]; then
    log_info "$CHANGED change(s) pending (dry run)"
elif [ "$CHANGED" = 0 ]; then
    log_info "already linked; nothing to do"
fi

[ "$FAILURES" -eq 0 ] || exit 1
exit 0
