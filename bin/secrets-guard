#!/usr/bin/env python3
"""PreToolUse hook (Bash): keep agents out of ~/.secrets.

Blocks a shell command that names the folder, runs `secret NAME` where its
output would be shown (only `$(secret NAME)` inside another command is fine),
opens `secrets`, or reads ~/.config/ecfx/jira.env (a link into the folder).
Heredoc bodies are text, not commands, so the `secret` check skips them unless
a shell word (bash, sh, zsh, ssh) appears outside the bodies, the heredoc never
ends, or an unquoted body holds $(...); the folder
and jira.env checks still read the whole command. The folder check skips the
quoted pattern of rg/grep when it names the folder only as `\.secrets` (a scan
for leaked paths); path operands, other options and code-like commands stay checked.
Exit 2 blocks with the reason on stderr; anything unreadable passes.

This stops accidental reads, the way tokens reached transcripts before. It is
not a sandbox: the agent runs as you. Claude Code's file tools are kept out by
the Read/Edit deny rules install.sh adds; pi's by the secrets-guard extension.
Claude Code runs this from ~/.claude/settings.json, pi through claude-hooks.
"""

import json
import re
import sys

FOLDER = re.compile(r"\.secrets\b")
SUBST = re.compile(r"\$\(\s*(?:\S*/)?secret\s+[A-Za-z_][A-Za-z0-9_]*\s*\)")
# Backticks are not command starts here: agents use $(...), and `secrets` in
# markdown text is far more common than legacy `...` substitution.
COMMAND = re.compile(r"(?:^|[;&|(\n]|\$\()\s*(?:\S*/)?(secrets?)(?=\s|$|[;&|)])(\s+-l\b)?")
TEAM_LINK = re.compile(r"ecfx/jira\.env")
READER = re.compile(
    r"(?:^|[\s;&|(`])(?:cat|less|more|head|tail|grep|rg|sed|awk|bat|source|\.|cp|mv|xxd|od|"
    r"strings|base64|python3?|perl|ruby|node|open|nvim|vim?)\s"
)
HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)\s*(['\"]?)([A-Za-z_]\w*)\2")
QUOTED = re.compile(r"""'[^']*'|"(?:\\.|[^"\\])*\"""")
WORDS = re.compile(r"[\s;&|()<>$\"'`]+")
SHELLS = {"bash", "sh", "zsh", "ssh"}
# The pattern of `rg|grep [flags] 'PATTERN'`: one quoted string after value-less flags only.
SEARCH = re.compile(
    r"""(?<![\w./-])(?:rg|grep)((?:[ \t]+-[nilwFHsqvoI]+)*)[ \t]+('[^']*'|"(?:[^"$`\\]|\\\.)*")(?=[ \t]|$|[|;&)])"""
)
SAFE_FLAG = re.compile(r"-[nilwFHsqvoI]+")
SEGMENT_END = re.compile(r"[|;&)\n]")
# Words that could run quoted text as code; the whole command stays checked.
DOT_SOURCE = re.compile(r"(?:^|[;&|(\n])\s*\.\s")
CODE_WORDS = {"eval", "xargs", "source", "env", "exec", "command", "builtin"} | SHELLS | {
    "dash", "ksh", "csh", "tcsh", "fish", "awk", "perl", "tmux",
}
ESCAPED_FOLDER = re.compile(r"\\\.secrets\b")


def without_search_patterns(command: str) -> str:
    """Blank the quoted pattern of rg/grep when it only names the folder as `\\.secrets`.

    A path operand, -g/-f/-e, a path-shaped pattern, or anything that could run
    quoted text as code keeps the whole command checked.
    """
    if "<<" in command or "$'" in command or "#" in command or "`" in command or "\\\n" in command:
        return command
    if DOT_SOURCE.search(command):
        return command
    words = [w for w in WORDS.split(command) if w]
    if any(w.rsplit("/", 1)[-1] in CODE_WORDS or re.fullmatch(r"-[A-Za-z]*c[A-Za-z]*", w) for w in words):
        return command

    def blank(m: re.Match) -> str:
        pattern = m.group(2)[1:-1]
        if FOLDER.search(ESCAPED_FOLDER.sub("", pattern)) or (
            FOLDER.search(pattern) and re.search(r"[/~$]", pattern)
        ):
            return m.group(0)
        end = SEGMENT_END.search(command, m.end())
        after = command[m.end() : end.start() if end else len(command)]
        if any(t.lstrip("'\"").startswith("-") and not SAFE_FLAG.fullmatch(t) for t in after.split()):
            return m.group(0)
        return m.group(0)[: m.start(2) - m.start()] + "''"

    return SEARCH.sub(blank, command)


def strip_heredocs(command: str) -> str:
    """Drop the bodies of heredocs that only feed text to a command.

    A shell word (bash, sh, zsh, ssh) anywhere outside the bodies keeps the whole command checked, as before.
    """
    lines = command.split("\n")
    # (physical lines, joined text) per logical line; `\` newline continues one
    groups: list[tuple[list[str], str]] = []
    bodies: dict[int, list[tuple[list[str], bool]]] = {}
    outside: list[str] = []
    i = 0
    while i < len(lines):
        start = i
        while lines[i].endswith("\\") and i + 1 < len(lines):
            i += 1
        i += 1
        text = " ".join(l.removesuffix("\\") if k < i - start - 1 else l for k, l in enumerate(lines[start:i]))
        groups.append((lines[start:i], text))
        outside.append(text)
        quoted = [m.span() for m in QUOTED.finditer(text)]
        found = [
            (m.group(3), m.group(1) == "-", m.group(2) == "")
            for m in HEREDOC.finditer(text)
            if not any(a < m.start() < b for a, b in quoted)
        ]
        got = bodies.setdefault(len(groups) - 1, [])
        for word, tabs, expands in found:
            body = []
            while i < len(lines) and (lines[i].lstrip("\t") if tabs else lines[i]) != word:
                body.append(lines[i])
                i += 1
            closed = i < len(lines)
            # an open heredoc is not trusted; an unquoted body expands $(...)
            keep = not closed or (expands and any("$(" in b for b in body))
            got.append((body, keep))
            if closed:
                outside.append(lines[i])
                got.append(([lines[i]], True))
                i += 1
    if any(w.rsplit("/", 1)[-1] in SHELLS for t in outside for w in WORDS.split(t)):
        return command
    out: list[str] = []
    for n, (physical, _) in enumerate(groups):
        out.extend(physical)
        for body, keep in bodies[n]:
            if keep:
                out.extend(body)
    return "\n".join(out)


def reason(command: str) -> str | None:
    if FOLDER.search(without_search_patterns(command)):
        return "~/.secrets is off limits to agents. Scripts read a value with $(secret NAME)."
    rest = SUBST.sub("", strip_heredocs(command))
    rest = re.sub(r"'[^']*'", "''", rest)  # quoted text never runs as a command
    rest = re.sub(r'"(?:\\.|[^"\\$]|\$(?!\())*"', '""', rest)  # unless it holds $(...)
    for m in COMMAND.finditer(rest):
        if m.group(1) == "secret" and m.group(2):
            continue
        return "`secret`/`secrets` would show a value. Use $(secret NAME) inside the command that needs it."
    if TEAM_LINK.search(command) and READER.search(command):
        return "~/.config/ecfx/jira.env links into ~/.secrets; let the script that needs it read it."
    return None


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if event.get("tool_name") != "Bash":
            return 0
        command = str(event["tool_input"]["command"])
    except Exception:
        return 0
    why = reason(command)
    if why:
        print(why, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
