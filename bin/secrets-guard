#!/usr/bin/env python3
"""PreToolUse hook (Bash): keep agents out of ~/.secrets.

Blocks a shell command that names the folder, runs `secret NAME` where its
output would be shown (only `$(secret NAME)` inside another command is fine),
opens `secrets`, or reads ~/.config/ecfx/jira.env (a link into the folder).
Exit 2 blocks with the reason on stderr; anything unreadable passes.

This stops accidental reads, the way tokens reached transcripts before. It is
not a sandbox: the agent runs as you. Claude Code's file tools are kept out by
the Read/Edit deny rules install.sh adds; pi's by the secrets-guard extension.
Claude Code runs this from ~/.claude/settings.json, pi through claude-hooks.
"""

import json
import re
import sys

FOLDER = re.compile(r"\.secrets\b")
SUBST = re.compile(r"\$\(\s*(?:\S*/)?secret\s+[A-Za-z_][A-Za-z0-9_]*\s*\)")
# Backticks are not command starts here: agents use $(...), and `secrets` in
# markdown text is far more common than legacy `...` substitution.
COMMAND = re.compile(r"(?:^|[;&|(\n]|\$\()\s*(?:\S*/)?(secrets?)(?=\s|$|[;&|)])(\s+-l\b)?")
TEAM_LINK = re.compile(r"ecfx/jira\.env")
READER = re.compile(
    r"(?:^|[\s;&|(`])(?:cat|less|more|head|tail|grep|rg|sed|awk|bat|source|\.|cp|mv|xxd|od|"
    r"strings|base64|python3?|perl|ruby|node|open|nvim|vim?)\s"
)


def reason(command: str) -> str | None:
    if FOLDER.search(command):
        return "~/.secrets is off limits to agents. Scripts read a value with $(secret NAME)."
    rest = SUBST.sub("", command)
    rest = re.sub(r"'[^']*'", "''", rest)  # quoted text never runs as a command
    rest = re.sub(r'"(?:\\.|[^"\\$]|\$(?!\())*"', '""', rest)  # unless it holds $(...)
    for m in COMMAND.finditer(rest):
        if m.group(1) == "secret" and m.group(2):
            continue
        return "`secret`/`secrets` would show a value. Use $(secret NAME) inside the command that needs it."
    if TEAM_LINK.search(command) and READER.search(command):
        return "~/.config/ecfx/jira.env links into ~/.secrets; let the script that needs it read it."
    return None


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if event.get("tool_name") != "Bash":
            return 0
        command = str(event["tool_input"]["command"])
    except Exception:
        return 0
    why = reason(command)
    if why:
        print(why, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
