#!/usr/bin/env python3
"""Words: the first track of the learning system. A word is a quiz card in $CARDS_DIR
(~/wiki/cards) with tag `word`, so the morning quiz and `cards` work on it as on any card.

  words add WORD [--back TEXT] [--met-in S] [--from F] [--date D]
        save WORD: the back is the first senses from macOS's dictionary (`macdict`, or
        $WORDS_MACDICT) unless --back; the front "What does *WORD* mean?" plus the sentence it
        was met in. Prints the slug; a word already saved prints its slug and writes nothing; a
        word the dictionary lacks, with no --back, exits 1 and writes nothing.
  words today [--date D]
        Merriam-Webster's word of the day ($WORDS_FEED, a URL or a file): the feed item dated D
        (else the newest), its short definition as the back, its example sentence as met_in,
        from mw. Prints the slug, or nothing when it is already saved. Offline, an HTML page or
        a changed feed: one line on stderr, exit 0, nothing written (it runs in /start-day).
  words import-diary [--diary-dir DIR]
        the one-time backfill: every ticked "merriam-webster word of the day (...)" line in
        DIR (~/wiki/diary). "word - meaning" (or "=" or ",") keeps the user's meaning as the
        back; a bare word gets the dictionary's; one the dictionary lacks gets "(look this one up
        again)" and tag word-check. Dated by the diary day, from diary; words already saved are
        skipped. Prints "imported N, already saved M, to check K".
  words stats [--date D] [--json|--line]
        {total, new_today, reviewed_today, known, streak} over the word cards, from their
        `## Reviews` history (cards grade writes it): known = interval of 21 days or more (its
        stage is written `known`); streak = days in a row with a word review, up to D (or D-1
        when D has none yet). --line: "Words: R reviewed, N new, K known of T · streak S days".

A word card's extra front matter: word, met_in, from (mw|lookup|book|diary), captured (date),
stage (learning|known). Cards are written through `cards` ($WORDS_CARDS, default the one next to
this script).
"""
import argparse
import datetime
import email.utils
import html
import json
import os
import re
import subprocess
import sys
import urllib.request
import xml.etree.ElementTree as ET

HERE = os.path.dirname(os.path.realpath(__file__))
CARDS = os.environ.get("WORDS_CARDS") or os.path.join(HERE, "cards")
CARDS_DIR = os.path.expanduser(os.environ.get("CARDS_DIR") or "~/wiki/cards")
MACDICT = os.environ.get("WORDS_MACDICT") or "macdict"
FEED = os.environ.get("WORDS_FEED") or "https://www.merriam-webster.com/wotd/feed/rss2"
MW_NS = "https://www.merriam-webster.com/word-of-the-day"
ITUNES_NS = "http://www.itunes.com/dtds/podcast-1.0.dtd"
BACK_MAX = 300
SECTIONS = re.compile(r"^(ORIGIN|DERIVATIVES|PHRASES|PHRASAL VERBS|USAGE|PRONUNCIATION|COMPARE|PLURAL|ABBREVIATION)\b")


class Fail(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def one_line(s):
    return " ".join((s or "").split())


def norm_word(w):
    return one_line(w).lower()


def clip(text, limit=BACK_MAX):
    text = one_line(text)
    if len(text) <= limit:
        return text
    cut = text[:limit - 1].rsplit(" ", 1)[0].rstrip(",;:")
    return cut + "…"


def lookup(word):
    """macdict's text for word, or None on a miss"""
    try:
        out = subprocess.run([MACDICT, word], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = out.strip()
    if not out or out.startswith(("No definition found", "Dictionary lookup failed", "Usage:")):
        return None
    return out


def short_back(text):
    """the first two senses of a macdict entry: no headword line, no ORIGIN and later sections"""
    senses = []
    for line in text.split("\n")[1:]:
        if SECTIONS.match(line.strip()):
            break
        line = line.strip().lstrip("•").strip()
        if line:
            senses.append(line)
        if len(senses) == 2:
            break
    return clip(" · ".join(senses))


def saved(word):
    """slug of the card already saved for word, or None"""
    want = norm_word(word)
    try:
        names = sorted(n for n in os.listdir(CARDS_DIR) if n.endswith(".md"))
    except OSError:
        return None
    for n in names:
        try:
            with open(os.path.join(CARDS_DIR, n), encoding="utf-8") as f:
                head = f.read(2000)
        except OSError:
            continue
        m = re.search(r"^word:[ \t]*(.*)$", head, re.M)
        if m and norm_word(m.group(1)) == want:
            return n[:-3]
    return None


def add(word, back=None, met_in="", src="lookup", day=None, tags=()):
    """slug of the saved card (new or existing); Fail when the dictionary lacks the word"""
    word = one_line(word)
    if not word:
        raise Fail("a word is needed", 2)
    slug = saved(word)
    if slug:
        return slug
    if back is None:
        text = lookup(word)
        if text is None:
            raise Fail(f"no definition for {word}")
        back = short_back(text)
    back = clip(back)
    met_in = one_line(met_in)
    front = f"What does *{word}* mean?" + (f' — "{met_in}"' if met_in else "")
    day = day or datetime.date.today().isoformat()
    args = [CARDS, "add", "--front", front, "--back", back, "--tags", ",".join(("word",) + tuple(tags)),
            "--source", f"words: {src}",
            "--date", day]
    for k, v in (("word", word), ("met_in", met_in), ("from", src), ("captured", day), ("stage", "learning")):
        args += ["--set", f"{k}={v}"]
    ran = subprocess.run(args, capture_output=True, text=True, env={**os.environ, "CARDS_DIR": CARDS_DIR})
    if ran.returncode != 0:
        raise Fail(f"cards add failed: {ran.stderr.strip()}")
    return ran.stdout.strip()


def cmd_add(a):
    print(add(a.word, a.back, a.met_in, a.src, a.date))


REVIEW_LINE = re.compile(r"^- (\d{4}-\d{2}-\d{2}) grade [0-3] interval \d+", re.M)
KNOWN_DAYS = 21


def word_cards():
    """[(path, text, front matter dict)] of the cards tagged word"""
    out = []
    try:
        names = sorted(n for n in os.listdir(CARDS_DIR) if n.endswith(".md") and not n.startswith("."))
    except OSError:
        return out
    for n in names:
        path = os.path.join(CARDS_DIR, n)
        with open(path, encoding="utf-8") as f:
            text = f.read()
        m = re.match(r"---\n(.*?)\n---\n", text, re.S)
        if not m:
            continue
        fm = {k.strip(): v.strip() for k, _, v in (l.partition(":") for l in m.group(1).split("\n")) if k.strip()}
        if "word" in [t.strip() for t in fm.get("tags", "").strip("[]").split(",")]:
            out.append((path, text, fm))
    return out


def mark_known(path, text):
    new = re.sub(r"^stage:.*$", "stage: known", text, count=1, flags=re.M)
    if new != text:
        tmp = f"{path}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(new)
        os.replace(tmp, path)


def stats(day):
    cards, review_days = word_cards(), set()
    s = {"total": len(cards), "new_today": 0, "reviewed_today": 0, "known": 0, "streak": 0}
    for path, text, fm in cards:
        days = REVIEW_LINE.findall(text.split("\n## Reviews", 1)[1] if "\n## Reviews" in text else "")
        review_days.update(days)
        s["new_today"] += fm.get("captured") == day
        s["reviewed_today"] += day in days
        try:
            known = int(float(fm.get("interval", "0"))) >= KNOWN_DAYS
        except ValueError:
            known = False
        if known:
            s["known"] += 1
            if fm.get("stage") != "known":
                mark_known(path, text)
    d = datetime.date.fromisoformat(day)
    if d.isoformat() not in review_days:
        d -= datetime.timedelta(days=1)
    while d.isoformat() in review_days:
        s["streak"] += 1
        d -= datetime.timedelta(days=1)
    return s


def cmd_stats(a):
    s = stats(a.date or datetime.date.today().isoformat())
    if a.line:
        unit = "day" if s["streak"] == 1 else "days"
        print(f"Words: {s['reviewed_today']} reviewed, {s['new_today']} new, {s['known']} known of {s['total']}"
              f" · streak {s['streak']} {unit}")
    else:
        print(json.dumps(s))


DIARY_LINE = re.compile(r"^\s*-\s*\[[xX]\]\s*merriam-webster word of the day\s*\((.*)\)\s*$", re.I)
SEPARATOR = re.compile(r"\s+-\s+|\s*=\s*|,\s*")
CHECK_BACK = "(look this one up again)"


def diary_words(diary_dir):
    """[(date, word, meaning or "")] from ticked word-of-the-day lines, in date order"""
    out = []
    for name in sorted(os.listdir(diary_dir)):
        m = re.fullmatch(r"(\d{4}-\d{2}-\d{2})\.md", name)
        if not m:
            continue
        with open(os.path.join(diary_dir, name), encoding="utf-8") as f:
            for line in f:
                hit = DIARY_LINE.match(line)
                if not hit:
                    continue
                parts = SEPARATOR.split(hit.group(1).strip(), 1)
                word = one_line(parts[0]).lower()
                if word:
                    out.append((m.group(1), word, one_line(parts[1]) if len(parts) > 1 else ""))
    return out


def cmd_import_diary(a):
    imported = already = check = 0
    for day, word, meaning in diary_words(os.path.expanduser(a.diary_dir)):
        if saved(word):
            already += 1
            continue
        if meaning:
            add(word, back=meaning, src="diary", day=day)
        else:
            text = lookup(word)
            if text is None:
                add(word, back=CHECK_BACK, src="diary", day=day, tags=("word-check",))
                check += 1
            else:
                add(word, back=short_back(text), src="diary", day=day)
        imported += 1
    print(f"imported {imported}, already saved {already}, to check {check}")


def read_feed(src):
    if re.match(r"https?://", src):
        with urllib.request.urlopen(src, timeout=15) as r:
            return r.read()
    with open(src, "rb") as f:
        return f.read()


def feed_items(data):
    """[(date, word, shortdef, example)] from Merriam-Webster's word-of-the-day feed"""
    items = []
    for it in ET.fromstring(data).findall("./channel/item"):
        word = one_line(it.findtext("title"))
        day = email.utils.parsedate_to_datetime(it.findtext("pubDate") or "").date().isoformat()
        short = one_line(html.unescape(it.findtext(f"{{{MW_NS}}}shortdef") or ""))
        summary = it.findtext(f"{{{ITUNES_NS}}}summary") or ""
        example = next((one_line(l.strip()[2:]) for l in summary.split("\n") if l.strip().startswith("//")), "")
        if word and short:
            items.append((day, word, short, example))
    return items


def cmd_today(a):
    """never fails the morning: any problem is one line on stderr, exit 0"""
    day = a.date or datetime.date.today().isoformat()
    try:
        items = feed_items(read_feed(FEED))
        if not items:
            raise ValueError("no words in the feed")
    except Exception as e:  # noqa: BLE001 — offline, a captive portal, a changed feed
        print(f"words today: no word of the day ({one_line(str(e))[:120]})", file=sys.stderr)
        return
    day_, word, short, example = next((i for i in items if i[0] == day), items[0])
    if saved(word):
        return
    print(add(word, back=short, met_in=example, src="mw", day=day))


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"words: {message}", file=sys.stderr)
        sys.exit(2)


def main():
    p = Parser(prog="words", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("add")
    s.add_argument("word")
    s.add_argument("--back")
    s.add_argument("--met-in", default="")
    s.add_argument("--from", dest="src", default="lookup")
    s.add_argument("--date")
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser("today")
    s.add_argument("--date")
    s.set_defaults(fn=cmd_today)
    s = sub.add_parser("stats")
    s.add_argument("--date")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--json", action="store_true")
    g.add_argument("--line", action="store_true")
    s.set_defaults(fn=cmd_stats)
    s = sub.add_parser("import-diary")
    s.add_argument("--diary-dir", default="~/wiki/diary")
    s.set_defaults(fn=cmd_import_diary)
    a = p.parse_args()
    try:
        a.fn(a)
    except Fail as e:
        print(f"words: {e}", file=sys.stderr)
        sys.exit(e.code)


if __name__ == "__main__":
    main()
