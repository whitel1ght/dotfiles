#!/usr/bin/env bash
# Open today's diary in nvim, in a centred tmux popup, at the start-day plan block.
#
#   day-plan [--wait]
#
# Reads $DIARY_DIR/<today>.md (default ~/wiki/diary). Needs tmux (exit 2 with no tmux
# server or pane; with $TMUX empty, `tmux-here` finds the caller's pane and the popup
# targets it) and an existing diary file (exit 1). Without --wait the popup is started through
# `tmux run-shell -b`, so the call returns at once and is safe from a non-interactive
# caller; --wait runs display-popup in the foreground until the popup is closed.
# nvim reloads the file when something else (the day session) edits it.
set -euo pipefail

DIARY_DIR="${DIARY_DIR:-$HOME/wiki/diary}"
START='<!-- start-day:start -->'

die() { echo "day-plan: $1" >&2; exit "${2:-1}"; }

wait=0
case "${1:-}" in
  -h|--help) sed -n '2p;4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --wait) wait=1 ;;
  "") ;;
  *) die "unknown option $1" ;;
esac

HERE="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
# a harness can start its shell without $TMUX: then tmux-here finds the caller's pane
if [ -z "${TMUX:-}" ]; then
  TMUX_PANE="$("$HERE/tmux-here" 2>/dev/null)" || die "needs tmux" 2
fi

file="$DIARY_DIR/$(date +%F).md"
[ -f "$file" ] || die "no diary at $file"

if [ "$wait" = 0 ]; then
  cmd="$(printf '%q ' env "DIARY_DIR=$DIARY_DIR" ${TMUX_PANE:+"TMUX_PANE=$TMUX_PANE"} "$0" --wait)"
  target=()
  [ -z "${TMUX_PANE:-}" ] || target=(-t "$TMUX_PANE")
  exec tmux run-shell -b "${target[@]}" "$cmd"
fi

nvim_args=(-c 'set autoread' -c 'autocmd FocusGained,BufEnter,CursorHold * checktime')
if grep -qF -- "$START" "$file"; then
  nvim_args=("+/\\V$START" -c 'normal! zt' "${nvim_args[@]}")
fi

# No tmux border (-B): with a busy pane underneath, tmux 3.7 paints that pane over the popup's
# top border row and the title vanishes. nvim draws the frame instead: the diary opens in a float
# with a rounded lavender border and the title in it (nvim/lua/whitelight/day_plan.lua).
nvim_args+=(-c "lua require('whitelight.day_plan').float('plan · $(date '+%a %F')')")

target=()
[ -z "${TMUX_PANE:-}" ] || target=(-t "$TMUX_PANE")
exec tmux display-popup -E -B -w 85% -h 85% "${target[@]}" \
  nvim "${nvim_args[@]}" -- "$file"
