#!/usr/bin/env python3
"""Keep the system manual (~/wiki/tools) in step with dotfiles.

Each manual page names the dotfiles paths it documents on one line:

    <!-- covers: bin/localai bin/webui pi/local-model/* -->

(shell-style globs relative to the repo root; * also crosses /).

  docs-check commit-msg <file>  git commit-msg hook: if staged changes touch a
                                covered path, the page covering it must have
                                been edited since; otherwise the commit stops
                                and names the page. A commit with no
                                user-visible change says so with a line
                                "Docs: none" in its message.
  docs-check coverage           every bin/ script (tests excluded) is mentioned
                                somewhere in the manual, and every covers entry
                                still matches a tracked file.

SYSTEM_DOCS overrides the manual folder (default ~/wiki/tools). A missing
manual folder never blocks a commit.
"""

import fnmatch
import os
import re
import subprocess
import sys
import time
from pathlib import Path

DOCS = Path(os.environ.get("SYSTEM_DOCS", "~/wiki/tools")).expanduser()
COVERS = re.compile(r"<!--\s*covers:(.*?)-->", re.DOTALL)
DOCS_NONE = re.compile(r"(?im)^docs:\s*none\s*$")
RECENT = 24 * 3600  # a deleted file has no mtime; the page must be this fresh


def git(*args: str) -> list[str]:
    out = subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout
    return [line for line in out.splitlines() if line]


def pages() -> dict[Path, list[str]]:
    found = {}
    for page in sorted(DOCS.glob("*.md")):
        match = COVERS.search(page.read_text(errors="replace"))
        found[page] = match.group(1).split() if match else []
    return found


def covered_by(path: str, globs: list[str]) -> bool:
    return any(fnmatch.fnmatch(path, g) for g in globs)


def commit_msg(msg_file: str) -> int:
    if not DOCS.is_dir():
        return 0
    if DOCS_NONE.search(Path(msg_file).read_text(errors="replace")):
        return 0
    staged = git("diff", "--cached", "--name-only")
    now = time.time()
    stale = {}
    for page, globs in pages().items():
        hits = [p for p in staged if covered_by(p, globs)]
        if not hits:
            continue
        newest = max(Path(p).stat().st_mtime if Path(p).exists() else now - RECENT for p in hits)
        if page.stat().st_mtime < newest:
            stale[page] = hits
    if not stale:
        return 0
    print("docs-check: this commit changes what the system manual documents.", file=sys.stderr)
    for page, hits in stale.items():
        print(f"  update {page}  (covers {', '.join(hits)})", file=sys.stderr)
    print("Edit the page(s), then commit again. If nothing user-visible changed, add a line\n"
          "'Docs: none' to the commit message.", file=sys.stderr)
    return 1


def coverage() -> int:
    tracked = git("ls-files")
    manual = pages()
    text = "\n".join(p.read_text(errors="replace") for p in manual)
    problems = []
    for path in tracked:
        name = Path(path).name
        if path.startswith("bin/") and "/" not in path[4:] and not name.endswith((".test.sh", ".bak")):
            if not re.search(rf"(?<![\w-]){re.escape(name)}(?![\w-])", text):
                problems.append(f"undocumented script: {path}")
    for page, globs in manual.items():
        for g in globs:
            if not any(fnmatch.fnmatch(p, g) for p in tracked):
                problems.append(f"{page.name}: covers entry matches nothing: {g}")
    for line in problems:
        print(line)
    return 1 if problems else 0


def main() -> int:
    if len(sys.argv) >= 3 and sys.argv[1] == "commit-msg":
        return commit_msg(sys.argv[2])
    if len(sys.argv) == 2 and sys.argv[1] == "coverage":
        return coverage()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
