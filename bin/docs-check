#!/usr/bin/env python3
"""Keep the system pages in step with the system repos.

Each page names the paths it documents on one line:

    <!-- covers: bin/localai bin/webui decisions:src/* -->

(shell-style globs relative to the repo root; * also crosses /; an entry
without "repo:" means dotfiles). Pages live in two folders: the tools manual
and the system part pages (SYSTEM_PAGES, default ~/wiki/work/system, minus
README.md and map.md). The system repos are dotfiles, decisions and articles.

  docs-check commit-msg <file>  git commit-msg hook: if staged changes touch a
                                covered path, each page covering it must have
                                been edited since; otherwise the commit stops
                                and names the page. A message line "Docs: none"
                                skips every rule; "Docs: internal" skips only
                                the tools page, the system page stays required.
  docs-check coverage           every bin/ script (tests excluded) is mentioned
                                somewhere in the manual, and every covers entry
                                still matches a tracked file.

SYSTEM_DOCS overrides the manual folder (default ~/wiki/tools), SYSTEM_REPOS
the repo roots ("name=path:name=path"). Missing page folders never block a
commit, and a commit in any other repo is never checked.
"""

import fnmatch
import os
import re
import subprocess
import sys
import time
from pathlib import Path

DOCS = Path(os.environ.get("SYSTEM_DOCS", "~/wiki/tools")).expanduser()
SYSTEM = Path(os.environ.get("SYSTEM_PAGES", "~/wiki/work/system")).expanduser()
DEFAULT_REPOS = "dotfiles=~/projects/dotfiles:decisions=~/projects/decisions:articles=~/projects/articles"
REPOS = {
    name: Path(path).expanduser().resolve()
    for name, path in (e.split("=", 1) for e in os.environ.get("SYSTEM_REPOS", DEFAULT_REPOS).split(":") if "=" in e)
}
NOT_PARTS = {"README.md", "map.md"}
COVERS = re.compile(r"<!--\s*covers:(.*?)-->", re.DOTALL)
OPT_OUT = re.compile(r"(?im)^docs:\s*(none|internal)\s*$")
RECENT = 24 * 3600  # a deleted file has no mtime; the page must be this fresh


def git(*args: str) -> list[str]:
    out = subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout
    return [line for line in out.splitlines() if line]


def repo_name() -> str | None:
    try:
        common = git("rev-parse", "--path-format=absolute", "--git-common-dir")[0]
    except (subprocess.CalledProcessError, IndexError):
        return None
    root = Path(common).resolve().parent
    return next((name for name, path in REPOS.items() if path == root), None)


def parse_entry(entry: str) -> tuple[str, str]:
    repo, sep, glob = entry.partition(":")
    return (repo, glob) if sep else ("dotfiles", entry)


def pages() -> dict[Path, list[tuple[str, str]]]:
    files = sorted(DOCS.glob("*.md")) + [p for p in sorted(SYSTEM.glob("*.md")) if p.name not in NOT_PARTS]
    found = {}
    for page in files:
        match = COVERS.search(page.read_text(errors="replace"))
        found[page] = [parse_entry(e) for e in match.group(1).split()] if match else []
    return found


def page_kind(page: Path) -> str:
    return "system" if page.parent == SYSTEM else "tools"


def covered_by(repo: str, path: str, globs: list[tuple[str, str]]) -> bool:
    return any(r == repo and fnmatch.fnmatch(path, g) for r, g in globs)


def covering(repo: str, path: str) -> list[Path]:
    return [page for page, globs in pages().items() if covered_by(repo, path, globs)]


def opt_out(msg: str) -> str:
    match = OPT_OUT.search(msg)
    return match.group(1).lower() if match else ""


def commit_msg(msg_file: str) -> int:
    repo = repo_name()
    if repo is None:
        return 0
    skip = opt_out(Path(msg_file).read_text(errors="replace"))
    if skip == "none":
        return 0
    staged = git("diff", "--cached", "--name-only")
    top = Path(git("rev-parse", "--show-toplevel")[0])
    now = time.time()
    stale = {}
    for page, globs in pages().items():
        if skip == "internal" and page_kind(page) == "tools":
            continue
        hits = [p for p in staged if covered_by(repo, p, globs)]
        if not hits:
            continue
        newest = max((top / p).stat().st_mtime if (top / p).exists() else now - RECENT for p in hits)
        if page.stat().st_mtime < newest:
            stale[page] = hits
    if not stale:
        return 0
    print("docs-check: this commit changes what the system documents.", file=sys.stderr)
    for page, hits in stale.items():
        print(f"  update {page} [{page_kind(page)}]  (covers {', '.join(hits)})", file=sys.stderr)
    print("Edit the page(s), then commit again. If nothing user-visible changed, add a line\n"
          "'Docs: none' to the commit message. If only the system page needs the update,\n"
          "add 'Docs: internal'.", file=sys.stderr)
    return 1


def coverage() -> int:
    tracked = git("ls-files")
    manual = pages()
    text = "\n".join(p.read_text(errors="replace") for p in manual)
    problems = []
    for path in tracked:
        name = Path(path).name
        if path.startswith("bin/") and "/" not in path[4:] and not name.endswith((".test.sh", ".bak")):
            if not re.search(rf"(?<![\w-]){re.escape(name)}(?![\w-])", text):
                problems.append(f"undocumented script: {path}")
    tracked_by = {"dotfiles": tracked}
    for page, globs in manual.items():
        for repo, g in globs:
            if repo not in tracked_by:
                root = REPOS.get(repo)
                tracked_by[repo] = git("-C", str(root), "ls-files") if root and root.is_dir() else None
            if tracked_by[repo] is not None and not any(fnmatch.fnmatch(p, g) for p in tracked_by[repo]):
                label = g if repo == "dotfiles" else f"{repo}:{g}"
                problems.append(f"{page.name}: covers entry matches nothing: {label}")
    for line in problems:
        print(line)
    return 1 if problems else 0


def main() -> int:
    if len(sys.argv) >= 3 and sys.argv[1] == "commit-msg":
        return commit_msg(sys.argv[2])
    if len(sys.argv) == 2 and sys.argv[1] == "coverage":
        return coverage()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
