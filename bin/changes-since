#!/usr/bin/env bash
# What changed on my tickets and MRs since I last looked, one JSON event per line.
#
#   changes-since [--cursor NAME] [--peek]
#
# Event: {kind, project, ticket, mr, repo, summary, url, at}
#   kind     review | comment | pipeline_failed | pipeline_fixed | assigned |
#            ticket_updated | mention | approved | merged
#   project  "ecfx" for Jira keys of $JIRA_PROJECT and GitLab paths under ecfx/, else null
#   ticket   Jira key, or null; mr the MR iid, or null; repo the GitLab repo name
#            (last path segment, e.g. ecfx-dashboard), or null
#   at       UTC, second precision, e.g. 2026-10-08T07:12:33Z
#   approved_by_me  true, only on a mention or review to-do for someone else's MR
#            I already approved; its summary starts "[approved by you — reply
#            only, never review] ". Review requests on such an MR are dropped.
# Events are sorted by `at`. Per run there is at most one event per kind per MR,
# and one per kind per ticket for Jira events.
#
# Sources: Jira (assigned to me; updated, where I am assignee, reporter or
# watcher), GitLab pending to-dos, and my MRs updated since: new notes from
# others (inline diff notes make a `review`, others a `comment`), approvals,
# merges, and head-pipeline failures and recoveries.
#
# The cursor is a UTC timestamp in ~/.local/state/changes-since/NAME (default
# "default"); events are those at or after it. With no cursor file, since
# local midnight. It moves to this run's start time only after every source
# answered and the events were printed, so a failure loses nothing, and --peek
# never moves it. A failing source is an error: exit 1, nothing on stdout.
# Nothing changed: exit 0 and no output.
#
# A GitLab outage is probed once per run (glab api user). When the probe or a
# GitLab feed fails, one service_down line is logged and a marker in the state
# dir shared with the other glab callers (glab-gate; F-021) holds off both the probe
# and the log for 15 minutes; runs in that window exit 1 at once, like any failing
# source, so nothing is lost.
#
# Every Jira and glab call is bounded: CHANGES_SINCE_CALL_TIMEOUT seconds (10),
# one retry after CHANGES_SINCE_BACKOFF seconds (1) on a timeout or any other
# failure (gitlab.com drops connections now and then; F-021), and the whole run stops at
# CHANGES_SINCE_BUDGET seconds (40), inside the 60 s the daily watcher allows. A
# call that times out twice fails the run with exit 75 and "timed out" on
# stderr, no service_down line and no cursor move: the caller skips that tick.
# The one exception is the approvals lookup behind approved_by_me (one call per
# MR): one attempt, no retry, CHANGES_SINCE_APPROVALS_TIMEOUT seconds (5) each and
# CHANGES_SINCE_APPROVALS_BUDGET seconds (10) for all of them. When it fails,
# times out or the budget is spent, that MR's events go out unmarked, with a
# note on stderr and a gitlab-approvals friction line, and the run carries on.
#
# When Jira is down (not on a timeout), `wait-for <source> --detach`
# starts in the background (CHANGES_SINCE_WAIT_FOR names another command), so
# the recovery is noted; its output is dropped and a failing waiter changes nothing.
#
# Needs jira-api (it reads the Jira token from ~/.secrets), glab and jq.
set -euo pipefail

JIRA_BASE="${JIRA_BASE:-https://ecfxdev.atlassian.net}"
JIRA_PROJECT="${JIRA_PROJECT:-ECFX}"
JIRA_API="${JIRA_API:-jira-api}"
STATE_DIR="${CHANGES_SINCE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/changes-since}"

die() { echo "changes-since: $*" >&2; exit 1; }
friction_log() { command -v friction >/dev/null 2>&1 && friction "$@" >/dev/null 2>&1 || true; }
down() {
  [ ! -e "$TIMED_OUT" ] || { echo "changes-since: timed out waiting for Jira or GitLab" >&2; exit 75; }
  friction_log --source "$1" service_down "$2"
  case "$1" in jira) "${CHANGES_SINCE_WAIT_FOR:-wait-for}" "$1" --detach </dev/null >/dev/null 2>&1 || true ;; esac
  die "$2"
}
HERE="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
iso() { date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
epoch_of() { date -j -u -f %Y-%m-%dT%H:%M:%SZ "$1" +%s 2>/dev/null || date -u -d "$1" +%s; }

name=default peek=0
while [ $# -gt 0 ]; do
  case "$1" in
    --cursor) shift; name="${1:-}"; [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "--cursor needs a name of letters, digits, . _ -" ;;
    --peek) peek=1 ;;
    -h|--help) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
  shift
done

now=$(date +%s); NOW=$(iso "$now")
if [ -s "$STATE_DIR/$name" ]; then
  SINCE=$(cat "$STATE_DIR/$name")
  [[ "$SINCE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || die "cursor $STATE_DIR/$name is not a UTC timestamp: $SINCE"
else
  SINCE=$(iso $((now - 10#$(date +%H) * 3600 - 10#$(date +%M) * 60 - 10#$(date +%S))))
fi

# Timestamps from GitLab and Jira, as UTC to the second, so they compare as strings.
JQ_DEFS='
def utc: if test("Z$") or test("\\+00:?00$") then sub("\\.[0-9]+"; "") | sub("\\+00:?00$"; "Z")
  else capture("^(?<t>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
    | ((.t + "Z") | fromdateiso8601) - ((.s + "1" | tonumber) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60)) | todate end;
'
EVENTS="$(mktemp)"; TIMED_OUT="$EVENTS.timeout"; JIRA_ERR="$EVENTS.jira-err"; trap 'rm -f "$EVENTS" "$TIMED_OUT" "$JIRA_ERR"' EXIT

CALL_TIMEOUT="${CHANGES_SINCE_CALL_TIMEOUT:-10}" BACKOFF="${CHANGES_SINCE_BACKOFF:-1}" BUDGET="${CHANGES_SINCE_BUDGET:-40}"

with_timeout() {
  perl -e '
    my $t = shift;
    my $pid = fork // exit 127;
    if (!$pid) { setpgrp(0, 0); exec @ARGV; exit 127 }
    my $kill = sub { kill "KILL", -$pid; waitpid $pid, 0 };
    $SIG{ALRM} = sub { $kill->(); exit 124 };
    $SIG{INT} = $SIG{TERM} = sub { $kill->(); exit 130 };
    alarm $t;
    waitpid $pid, 0;
    exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
  ' "$@"
}

# A failed attempt's output is dropped, so a connection cut mid-page never prints half a body.
bounded() {
  local attempt left t rc=124 out
  for attempt in 1 2; do
    left=$((BUDGET - ($(date +%s) - now)))
    [ "$left" -gt 0 ] || break
    t=$CALL_TIMEOUT; [ "$t" -le "$left" ] || t=$left
    if out=$(with_timeout "$t" "$@"); then
      [ -z "$out" ] || printf '%s\n' "$out"
      return 0
    else
      rc=$?
    fi
    [ "$attempt" -eq 2 ] || sleep "$BACKOFF"
  done
  [ "$rc" -eq 124 ] || return "$rc"
  : > "$TIMED_OUT"
  return 124
}

APPROVALS_TIMEOUT="${CHANGES_SINCE_APPROVALS_TIMEOUT:-5}" APPROVALS_BUDGET="${CHANGES_SINCE_APPROVALS_BUDGET:-10}"
# One attempt inside the approvals lookups' own budget (and the run's), so a
# hung endpoint costs the run at most APPROVALS_BUDGET; 124 once it is spent.
approvals_call() {
  local left run_left t
  left=$((APPROVALS_BUDGET - ($(date +%s) - approvals_start)))
  run_left=$((BUDGET - ($(date +%s) - now)))
  [ "$run_left" -ge "$left" ] || left=$run_left
  [ "$left" -gt 0 ] || return 124
  t=$APPROVALS_TIMEOUT; [ "$t" -le "$left" ] || t=$left
  with_timeout "$t" "$@"
}

feed_jira() {
  local jql_since assigned updated tz
  # JQL reads dates in the Jira profile's time zone, not this machine's.
  JIRA_REPLY=$(bounded "$JIRA_API" GET myself 2>>"$JIRA_ERR") || return 1
  tz=$(jq -er .timeZone <<<"$JIRA_REPLY") || return 1
  jql_since=$(TZ="$tz" date -r "$(epoch_of "$SINCE")" '+%Y/%m/%d %H:%M' 2>/dev/null || TZ="$tz" date -d "$SINCE" '+%Y/%m/%d %H:%M')
  jira_issues() {
    JIRA_REPLY=$(bounded "$JIRA_API" POST search/jql "$(jq -cn --arg jql "$1" \
      '{jql: $jql, fields: ["summary", "status", "updated"], maxResults: 100}')" 2>>"$JIRA_ERR") || return 1
    jq -e '.issues | type == "array"' <<<"$JIRA_REPLY" >/dev/null
  }
  # The JQL window is minute-granular and the cursor is not, so jq filters exactly.
  # Called without $(...), so JIRA_REPLY survives for jira_down.
  jira_issues "assignee = currentUser() AND assignee CHANGED TO currentUser() AFTER \"$jql_since\"" || return 1
  assigned=$(jq -c .issues <<<"$JIRA_REPLY")
  jira_issues "(assignee = currentUser() OR reporter = currentUser() OR watcher = currentUser()) AND updated >= \"$jql_since\" ORDER BY updated DESC" || return 1
  updated=$(jq -c .issues <<<"$JIRA_REPLY")
  local kind issues
  for kind in assigned ticket_updated; do
    if [ "$kind" = assigned ]; then issues="$assigned"; else issues="$updated"; fi
    jq -c --arg kind "$kind" --arg since "$SINCE" --arg base "$JIRA_BASE" --arg jp "$JIRA_PROJECT" "$JQ_DEFS"'
      .[] | (.fields.updated | utc) as $at | select($at >= $since)
      | {kind: $kind, project: (if (.key | sub("-.*$"; "")) == $jp then "ecfx" else null end), ticket: .key,
         mr: null, repo: null, summary: "\(.fields.summary) [\(.fields.status.name)]",
         url: "\($base)/browse/\(.key)", at: $at}' <<<"$issues" >> "$EVENTS" || return 1
  done
}

gitlab_json() { bounded glab api --paginate "$1" | jq -s 'add // []'; }

TODO_DEFS='
def kind: {assigned: "assigned", review_requested: "assigned", approval_required: "assigned",
           mentioned: "mention", directly_addressed: "mention", build_failed: "pipeline_failed",
           review_submitted: "review"}[.] // "mention";
def mr_ref: (.target.project_id // .project.id // (.project.path_with_namespace | @uri)) | tostring;
'

# MRs of others among the to-dos that I already approved, as ["<project>:<iid>", ...].
# A failed lookup is logged and leaves that MR out, so its events stay unmarked.
approved_by_me() {
  local approved='[]' ref iid resp rc approvals_start
  approvals_start=$(date +%s)
  while IFS=$'\t' read -r ref iid; do
    rc=0; resp=$(approvals_call glab api "projects/$ref/merge_requests/$iid/approvals") || rc=$?
    if [ "$rc" -eq 0 ] && jq -e '.approved_by | type == "array"' <<<"$resp" >/dev/null 2>&1; then
      if jq -e --arg me "$ME" 'any(.approved_by[]; .user.username == $me)' <<<"$resp" >/dev/null; then
        approved=$(jq -c --arg k "$ref:$iid" '. + [$k]' <<<"$approved")
      fi
    else
      echo "changes-since: approvals of $ref!$iid unavailable; its to-dos stay unmarked" >&2
      friction_log --source gitlab-approvals "$([ "$rc" -eq 124 ] && echo timeout || echo tool_error)" "approvals lookup failed for $ref!$iid"
    fi
  done < <(jq -r --arg since "$SINCE" --arg me "$ME" "$JQ_DEFS$TODO_DEFS"'
    [.[] | select(.target_type == "MergeRequest" and (.target.author.username // "") != $me
           and (.action_name | kind) != "pipeline_failed" and (.created_at | utc) >= $since)
     | [mr_ref, (.target.iid | tostring)]] | unique[] | @tsv' <<<"$1")
  printf '%s\n' "$approved"
}

feed_gitlab_todos() {
  local todos approved
  todos=$(gitlab_json 'todos?state=pending&per_page=100') || return 1
  jq -e 'type == "array"' <<<"$todos" >/dev/null || return 1
  approved=$(approved_by_me "$todos")
  # D-011: no review round on an MR I approved, so its review requests go and
  # anything else on it is marked reply-only.
  jq -c --arg since "$SINCE" --arg jp "$JIRA_PROJECT" --argjson approved "$approved" "$JQ_DEFS$TODO_DEFS"'
    .[] | (.created_at | utc) as $at | select($at >= $since)
    | (.action_name | kind) as $kind
    | (mr_ref + ":" + (.target.iid | tostring)) as $k
    | (.target_type == "MergeRequest" and any($approved[]; . == $k)) as $approved_mr
    | select(($approved_mr and $kind == "assigned") | not)
    | ($approved_mr and ($kind == "mention" or $kind == "review")) as $mark
    | (.project.path_with_namespace // "") as $path
    | (if .target_type == "MergeRequest" then .target.iid else null end) as $iid
    | ([((.target.source_branch // "") + " " + (.target.title // "")) | capture("(?<k>(?i:" + $jp + ")-[0-9]+)").k | ascii_upcase][0]) as $ticket
    | {kind: $kind,
       project: (if ($path | split("/")[0]) == "ecfx" then "ecfx" else null end),
       ticket: $ticket, mr: $iid, repo: (if $path == "" then null else ($path | split("/") | last) end),
       summary: ((if $mark then "[approved by you — reply only, never review] " else "" end)
         + "@\(.author.username // "?") \(.action_name | gsub("_"; " ")): \(.target.title // .body)"),
       url: (.target_url // .target.web_url), at: $at}
    | if $mark then . + {approved_by_me: true} else . end' <<<"$todos" >> "$EVENTS"
}

# One MR's lookup failing says nothing about GitLab: fail the run (no cursor move) without the shared outage marker.
mr_failed() {
  [ ! -e "$TIMED_OUT" ] || down gitlab-mrs "GitLab MRs unavailable"
  friction_log --source gitlab-mrs tool_error "MR lookup failed for $1!$2"; die "MR lookup failed for $1!$2"
}

feed_gitlab_mrs() {
  local mrs pid iid detail notes pipelines
  mrs=$(gitlab_json "merge_requests?scope=created_by_me&state=all&updated_after=$SINCE&per_page=100") || return 1
  jq -e 'type == "array"' <<<"$mrs" >/dev/null || return 1
  while IFS=$'\t' read -r pid iid; do
    detail=$(bounded glab api "projects/$pid/merge_requests/$iid") || mr_failed "$pid" "$iid"
    notes=$(bounded glab api "projects/$pid/merge_requests/$iid/notes?sort=desc&order_by=created_at&per_page=100") || mr_failed "$pid" "$iid"
    pipelines='[]'
    # The previous pipeline only matters when the head one just went green.
    if jq -e --arg since "$SINCE" "$JQ_DEFS"'.state == "opened" and .head_pipeline.status == "success" and (.head_pipeline.updated_at | utc) >= $since' <<<"$detail" >/dev/null; then
      pipelines=$(bounded glab api "projects/$pid/merge_requests/$iid/pipelines") || mr_failed "$pid" "$iid"
    fi
    jq -c --arg since "$SINCE" --arg me "$ME" --arg jp "$JIRA_PROJECT" --argjson notes "$notes" --argjson pipelines "$pipelines" "$JQ_DEFS"'
      def latest: map(.created_at | utc) | max;
      def names: map("@" + .author.username) | unique | join(", ");
      (.references.full | sub("!.*$"; "")) as $path
      | ([((.source_branch // "") + " " + (.title // "")) | capture("(?<k>(?i:" + $jp + ")-[0-9]+)").k | ascii_upcase][0]) as $ticket
      | . as $d
      | def ev($kind; $summary; $at): {kind: $kind, project: (if ($path | split("/")[0]) == "ecfx" then "ecfx" else null end),
          ticket: $ticket, mr: $d.iid, repo: ($path | split("/") | last), summary: $summary, url: $d.web_url, at: $at};
      ($notes | map(select(.author.username != $me and (.created_at | utc) >= $since))) as $new
      | ($new | map(select(.system | not))) as $human
      | ($human | map(select(.type == "DiffNote"))) as $inline
      | ($human | map(select(.type != "DiffNote"))) as $plain
      | ($new | map(select(.system and (.body | test("^approved this merge request"))))) as $approvals
      | ($d.head_pipeline // null) as $hp
      | ( if ($d.state == "merged" and (($d.merged_at // "") | length) > 0 and ($d.merged_at | utc) >= $since)
            then ev("merged"; "merged: \($d.title)"; $d.merged_at | utc) else empty end ),
        ( if ($inline | length) > 0
            then ev("review"; "\($inline | names): \($inline | length) inline comment(s) on \($d.title)"; $inline | latest) else empty end ),
        ( if ($plain | length) > 0
            then ev("comment"; "\($plain | names): \($plain | length) comment(s) on \($d.title)"; $plain | latest) else empty end ),
        ( if ($approvals | length) > 0
            then ev("approved"; "\($approvals | names) approved \($d.title)"; $approvals | latest) else empty end ),
        ( if $d.state == "opened" and $hp != null and $hp.status == "failed" and ($hp.updated_at | utc) >= $since
            then ev("pipeline_failed"; "pipeline failed on \($d.title)"; $hp.updated_at | utc) else empty end ),
        ( if $d.state == "opened" and $hp != null and $hp.status == "success" and ($hp.updated_at | utc) >= $since
              and ([$pipelines[] | select(.id < $hp.id)][0].status == "failed")
            then ev("pipeline_fixed"; "pipeline green again on \($d.title)"; $hp.updated_at | utc) else empty end )' <<<"$detail" >> "$EVENTS" || return 1
  done < <(jq -r '.[] | [.project_id, .iid] | @tsv' <<<"$mrs")
}

gitlab_down() { [ ! -e "$TIMED_OUT" ] || down "$@"; "$HERE/glab-gate" down --source "$1" "$2" || true; die "$2"; }

gate_rc=0; "$HERE/glab-gate" check || gate_rc=$?
[ "$gate_rc" -ne 1 ] || die "GitLab unavailable (holding off until the 15-minute window since the last failure passes)"

# jira-api exits 0 on a 401/403 and prints Jira's error body, so the last reply tells an
# auth failure from an outage; a missing secret stops it with "missing in" on stderr.
jira_down() {
  [ ! -s "$JIRA_ERR" ] || cat "$JIRA_ERR" >&2
  if grep -Eiq 'must be authenticated|unauthori[sz]ed|"status(Code)?" *: *40[13]' <<<"${JIRA_REPLY:-}" || grep -q 'missing in' "$JIRA_ERR" 2>/dev/null; then
    down jira "Jira unavailable (are JIRA_USER/JIRA_TOKEN in ~/.secrets/secrets.env still valid?)"
  fi
  down jira "Jira unavailable, retry in a few minutes"
}
feed_jira || jira_down
ME=$(bounded glab api user | jq -er .username) || gitlab_down gitlab "GitLab unavailable"
"$HERE/glab-gate" up || true
feed_gitlab_todos || gitlab_down gitlab-todos "GitLab to-dos unavailable"
feed_gitlab_mrs || gitlab_down gitlab-mrs "GitLab MRs unavailable"

out=$(jq -sc '
  (map(select(.kind == "assigned" and .mr == null) | .ticket)) as $assigned
  | map(select(.kind != "ticket_updated" or (.ticket as $t | $assigned | index($t) | not)))
  | group_by([.kind, .repo, .mr, (if .mr == null then .ticket else null end)])
  | map(max_by(.at)) | sort_by(.at, .kind) | .[]' "$EVENTS") || die "could not assemble events"
[ -z "$out" ] || printf '%s\n' "$out"
if [ "$peek" -eq 0 ]; then
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$NOW" > "$STATE_DIR/$name.tmp" && mv "$STATE_DIR/$name.tmp" "$STATE_DIR/$name"
fi
