#!/usr/bin/env bash
# Add skills to a Claude Code session that is already running.
#
# Claude Code rescans its skill directories while a session is live, so a skill
# that appears on disk becomes usable a turn or two later without a restart.
# What it does NOT reload is plugins: --plugin-dir and enabledPlugins are read
# once at launch, so anything plugin-shaped still needs a new session.
#
# Everything lands in the repository's own .claude/skills/, never ~/.claude/.
# That is the one directory visible to both kinds of session: a plain `claude`
# scans it, and so does a `cs` session, whose whole method is dropping the user
# settings source that ~/.claude/skills rides on. Linking into ~/.claude would
# work for one of the two and silently do nothing for the other.
#
# Because that directory is usually version-controlled, every link is also
# written to .git/info/exclude — local to the clone, never committed — so an
# activated skill cannot turn into an accidental commit. That exclude block is
# the only record kept: --remove and --clear act on it, which is what keeps this
# from ever deleting a skill the repository actually owns.
#
# An installed plugin can be named with +, because a plugin's skills are kept
# on disk as ordinary directories and can be linked like any other. What that
# does not bring across is the rest of the plugin: its hooks and MCP servers
# stay unloaded, and its skills arrive unnamespaced, as `brainstorming` rather
# than `superpowers:brainstorming`. Start the session with `cs +superpowers`
# when the whole plugin is wanted; +name here is for reaching one mid-session.
#
# Usage:
#   cs-add ~/bundles/frontend        link every skill in a bundle
#   cs-add ~/bundles/frontend/skills/vue-expert    link one skill
#   cs-add +superpowers              link an installed plugin's skills
#   cs-add --list                    show what this tool has activated
#   cs-add --remove vue-expert       unlink one
#   cs-add --clear                   unlink everything it activated
set -uo pipefail

BEGIN_MARK="# >>> cs-add session skills >>>"
END_MARK="# <<< cs-add session skills <<<"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()  { echo -e "${GREEN}[cs-add]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[cs-add]${NC} $1" >&2; }
log_error() { echo -e "${RED}[cs-add]${NC} $1" >&2; }

usage() {
    sed -n '/^# Usage:/,/^set -/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
}

# The repo whose .claude/skills is being written to. Overridable so the tests
# can run against a fixture instead of the checkout they live in.
repo_root() {
    if [ -n "${CS_ADD_REPO:-}" ]; then
        printf '%s\n' "$CS_ADD_REPO"
        return 0
    fi
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        log_error "Not inside a git repository — cs-add needs one to write .claude/skills"
        return 1
    }
    printf '%s\n' "$root"
}

skills_dir() { printf '%s\n' "$(repo_root)/.claude/skills"; }
exclude_file() { printf '%s\n' "$(repo_root)/.git/info/exclude"; }

# Names currently inside the marker block, one per line. The block stores
# gitignore patterns, so strip the leading path back down to the skill name.
active_names() {
    local ex; ex="$(exclude_file)"
    [ -f "$ex" ] || return 0
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        inside && /^\/\.claude\/skills\// { sub(/^\/\.claude\/skills\//, ""); print }
    ' "$ex"
}

# Replace the marker block with exactly the names given. Content outside the
# markers is copied through untouched — the file belongs to the user, and other
# tools (dotfiles' own installer among them) write their own blocks into it.
write_exclude() {
    local ex tmp name
    ex="$(exclude_file)"
    mkdir -p "$(dirname "$ex")"
    touch "$ex"

    tmp="$(mktemp)" || return 1
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        !inside { print }
    ' "$ex" > "$tmp" || { rm -f "$tmp"; return 1; }

    if [ "$#" -gt 0 ]; then
        {
            printf '%s\n' "$BEGIN_MARK"
            for name in "$@"; do printf '/.claude/skills/%s\n' "$name"; done
            printf '%s\n' "$END_MARK"
        } >> "$tmp"
    fi

    mv "$tmp" "$ex"
}

# Expand an argument into the skill directories it names: a bundle contributes
# each child of its skills/, a lone skill contributes itself.
skill_sources() {
    local src="$1" d
    if [ -f "$src/SKILL.md" ]; then
        printf '%s\n' "$src"
        return 0
    fi
    if [ -d "$src/skills" ]; then
        local found=false
        for d in "$src"/skills/*/; do
            [ -f "$d/SKILL.md" ] || continue
            printf '%s\n' "${d%/}"
            found=true
        done
        [ "$found" = true ] && return 0
        log_error "$src/skills contains no skills"
        return 1
    fi
    log_error "$src is neither a skill (SKILL.md) nor a bundle (skills/)"
    return 1
}

is_active() {
    local name="$1"
    active_names | grep -qxF -- "$name"
}

# Where an installed plugin's files actually live. Read from installPath rather
# than globbing the cache: a plugin updated in place leaves its older versions
# behind, and frontend-design currently has two of them, so a glob would be a
# coin toss between the installed one and a stale one.
resolve_plugin_path() {
    local name="$1" installed matches path
    installed="${CS_ADD_INSTALLED:-$HOME/.claude/plugins/installed_plugins.json}"

    if [ ! -f "$installed" ]; then
        log_error "No installed plugins at $installed"
        return 1
    fi

    matches="$(jq -r --arg n "$name" \
        '.plugins | keys[] | select(. == $n or startswith($n + "@"))' "$installed" 2>/dev/null)"

    case "$(printf '%s\n' "$matches" | grep -c .)" in
        1) ;;
        0) log_error "No installed plugin named '$name'. Try: claude plugin list"; return 1 ;;
        *) log_error "'$name' is ambiguous: $(echo "$matches" | tr '\n' ' ')"; return 1 ;;
    esac

    # The entry is an array because one plugin can be installed at more than one
    # scope. Taking [0] is right for the usual single entry and a silent coin
    # toss otherwise, so say so rather than pick quietly.
    if [ "$(jq -r --arg k "$matches" '.plugins[$k] | length' "$installed" 2>/dev/null)" -gt 1 ]; then
        log_warn "'$name' is installed at several scopes; using the first"
    fi

    path="$(jq -r --arg k "$matches" \
        '.plugins[$k][0].installPath // ""' "$installed" 2>/dev/null)"
    if [ -z "$path" ] || [ ! -d "$path" ]; then
        log_error "'$name' resolves to a missing install path: ${path:-<none>}"
        return 1
    fi

    warn_if_already_enabled "$matches"
    printf '%s\n' "$path"
}

# A plugin enabled in user settings is already loaded in any session started
# with a plain `claude`, under its namespaced names. Linking it again adds a
# second, unnamespaced copy of every skill — twice the always-on cost, and no
# visible change, which reads as the command having done nothing.
warn_if_already_enabled() {
    local key="$1" settings enabled
    settings="${CS_ADD_SETTINGS:-$HOME/.claude/settings.json}"
    [ -f "$settings" ] || return 0

    enabled="$(jq -r --arg k "$key" '.enabledPlugins[$k] // false' "$settings" 2>/dev/null)"
    [ "$enabled" = "true" ] || return 0

    log_warn "'$key' is enabled in your user settings."
    log_warn "A session started with plain 'claude' already has these skills, namespaced."
    log_warn "Linking them adds unnamespaced duplicates. This is only useful in a cs session."
}

# Link one skill. A name already taken by a real directory is refused rather
# than replaced: that is a skill the repository itself ships, and clobbering it
# would look like this tool working right up until the commit.
add_one() {
    local src="$1" dir name target
    dir="$(skills_dir)"
    name="$(basename "$src")"
    target="$dir/$name"

    mkdir -p "$dir" || return 1

    if [ -e "$target" ] && [ ! -L "$target" ]; then
        log_error "$name already exists in the repo and is not a cs-add link — skipping"
        return 1
    fi
    if [ -L "$target" ] && ! is_active "$name"; then
        log_error "$name is a symlink this tool did not create — skipping"
        return 1
    fi

    ln -sfn "$(cd "$src" && pwd)" "$target" || return 1
    printf '%s\n' "$name"
}

remove_one() {
    local name="$1" target
    target="$(skills_dir)/$name"

    if ! is_active "$name"; then
        log_error "$name was not activated by cs-add — leaving it alone"
        return 1
    fi
    if [ -L "$target" ]; then
        rm -f "$target"
    elif [ -e "$target" ]; then
        log_error "$name is not a symlink — refusing to delete it"
        return 1
    fi
    return 0
}

cmd_list() {
    local names name target
    names="$(active_names)"
    if [ -z "$names" ]; then
        log_info "nothing activated in $(repo_root)"
        return 0
    fi
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        target="$(skills_dir)/$name"
        if [ -L "$target" ]; then
            printf '  %-32s -> %s\n' "$name" "$(readlink "$target")"
        else
            printf '  %-32s (recorded but missing)\n' "$name"
        fi
    done <<< "$names"
}

cmd_remove() {
    local -a keep=()
    local failed=0 name existing
    for name in "$@"; do
        remove_one "$name" || failed=1
    done

    while IFS= read -r existing; do
        [ -n "$existing" ] || continue
        local dropped=false
        for name in "$@"; do
            [ "$existing" = "$name" ] && dropped=true
        done
        [ "$dropped" = false ] && keep+=("$existing")
    done <<< "$(active_names)"

    write_exclude ${keep[@]+"${keep[@]}"} || return 1
    log_info "removed; the session drops them within a turn or two"
    return "$failed"
}

cmd_clear() {
    local name
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        remove_one "$name" >/dev/null 2>&1
    done <<< "$(active_names)"
    write_exclude || return 1
    log_info "cleared"
}

cmd_add() {
    local -a added=()
    local failed=0 src sub name from_plugin=false

    for src in "$@"; do
        case "$src" in
            +*)
                if ! src="$(resolve_plugin_path "${src#+}")"; then
                    failed=1
                    continue
                fi
                from_plugin=true
                ;;
        esac
        if [ ! -d "$src" ]; then
            log_error "Not a directory: $src"
            failed=1
            continue
        fi

        # Captured first rather than piped straight into the loop: a command
        # substitution feeding `done <<<` discards its exit status, so a source
        # that resolves to nothing would report success having linked nothing.
        local subs
        if ! subs="$(skill_sources "$src")"; then
            failed=1
            continue
        fi

        while IFS= read -r sub; do
            [ -n "$sub" ] || continue
            if name="$(add_one "$sub")"; then
                added+=("$name")
            else
                failed=1
            fi
        done <<< "$subs"
    done

    if [ "${#added[@]}" -eq 0 ]; then
        return "$failed"
    fi

    # The block is rewritten from the union, so re-adding a skill is a no-op
    # rather than a duplicate line.
    local -a union=()
    local existing a seen
    while IFS= read -r existing; do
        [ -n "$existing" ] && union+=("$existing")
    done <<< "$(active_names)"
    for a in "${added[@]}"; do
        seen=false
        for existing in ${union[@]+"${union[@]}"}; do
            [ "$existing" = "$a" ] && seen=true
        done
        [ "$seen" = false ] && union+=("$a")
    done

    write_exclude ${union[@]+"${union[@]}"} || return 1

    log_info "linked ${#added[@]} skill(s): ${added[*]}"
    log_info "they go live when Claude Code next rescans: a few exchanges, not instantly."
    log_info "the session's skill listing is what tells you they arrived."
    if [ "$from_plugin" = true ]; then
        log_warn "linked as plain skills: no namespacing, and the plugin's hooks and"
        log_warn "MCP servers stay unloaded. Use 'cs +<name>' for the whole plugin."
    fi
    return "$failed"
}

main() {
    [ "$#" -eq 0 ] && { usage; return 0; }

    case "$1" in
        --help|-h)   usage; return 0 ;;
        --list|-l)   cmd_list; return $? ;;
        --clear)     cmd_clear; return $? ;;
        --remove|-r) shift
                     [ "$#" -gt 0 ] || { log_error "--remove needs a name"; return 1; }
                     cmd_remove "$@"; return $? ;;
    esac

    repo_root >/dev/null || return 1
    cmd_add "$@"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
