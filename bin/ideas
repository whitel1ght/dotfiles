#!/usr/bin/env python3
"""Keep the system's memory copy of the user's ideas file, for the idle idea review.

  ideas sync      read $IDEAS_FILE (~/wiki/IDEA.md) into one entry per idea under $IDEAS_DIR
                  (~/wiki/work/ideas): I-NNN.md files and index.md. Prints
                  {"new": [ids], "edited": [ids], "closed": [ids], "gone": [ids]}.
  ideas due [--limit N] [--id I-NNN ...]
                  JSON [{id, text, section, status}] of ideas to review: new or edited, not
                  answered no, "later" date passed; oldest first. --id: those ideas, whatever
                  their state.
  ideas record I-NNN --verdict stale|actionable|elaborate --summary TEXT --file F
                  the review: F's text becomes the entry's `## Review`; status reviewed.
  ideas answer I-NNN yes|no|later [--days N]
                  the user's answer; later is due again after N days (7).
sync, record and answer hold a lock (IDEAS_DIR/.lock, 30 s wait, a dead holder's taken over).

IDEA.md is only ever read. Its top lines (before any `##` heading, or under a heading other than
the two below) are loose ideas; `## review & implement:` items are review ideas; `## implemented:`
items are implemented. A bullet may carry a checkbox: `[ ]` open, `[X]`/`[x]` done, `[-]` dropped.
An indented line under a bullet continues it. A done or dropped idea is recorded, never reviewed.
A changed line keeps its entry: a small fix (similarity 0.9 and up) keeps the review and the
user's answer; a bigger edit (0.6 to 0.9) re-opens it as `edited`, answer cleared; below 0.6 the
line is a new idea and the old entry is `gone`, as is any entry whose line is no longer there. A
tick alone closes an entry (done or dropped), never re-opens it.
Entry ids (I-001 up) are never reused. A file is rewritten only when its content changes.
"""
import difflib
import json
import os
import re
import shutil
import sys
import time
from contextlib import contextmanager
from datetime import date, timedelta

IDEAS_FILE = os.environ.get("IDEAS_FILE", os.path.expanduser("~/wiki/IDEA.md"))
IDEAS_DIR = os.environ.get("IDEAS_DIR", os.path.expanduser("~/wiki/work/ideas"))
KEYS = ["id", "text", "section", "mark", "first_seen", "last_seen", "status", "verdict", "summary",
        "reviewed_on", "answer", "answered_on", "later_until"]
# a changed line keeps its entry from EDITED_AT up; below SAME_AT it re-opens the entry's review
SAME_AT, EDITED_AT = 0.9, 0.6
BULLET = re.compile(r"^[-*]\s+(.*)$")
BOX = re.compile(r"^\[( |x|X|-)\]\s*(.*)$")


def today():
    return os.environ.get("IDEAS_TODAY") or date.today().isoformat()


def die(msg, code=1):
    print(f"ideas: {msg}", file=sys.stderr)
    sys.exit(code)


def normalize(text):
    return re.sub(r"[.!?;:,]+$", "", re.sub(r"\s+", " ", text.strip().lower()))


def parse_ideas(path):
    """[(text, section, mark)] in file order."""
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    ideas, section, current = [], "loose", None
    for line in lines:
        if line.startswith("## "):
            head = line[3:].strip().lower()
            section = "implemented" if head.startswith("implemented") else "review" if "review" in head else "loose"
            current = None
            continue
        if line.startswith("#") or not line.strip():
            current = None
            continue
        m = BULLET.match(line)
        if m:
            body, mark = m.group(1).strip(), "none"
            b = BOX.match(body)
            if b:
                mark = {" ": "open", "-": "dropped"}.get(b.group(1), "done")
                body = b.group(2).strip()
            if not body:
                current = None
                continue
            current = {"text": body, "section": section, "mark": mark}
            ideas.append(current)
        elif line[:1].isspace() and current is not None:
            current["text"] = f"{current['text']} {line.strip()}"
    return [(i["text"], i["section"], i["mark"]) for i in ideas]


def read_entry(path):
    entry, body, in_fm, seen = {}, [], False, 0
    with open(path, encoding="utf-8") as f:
        for line in f.read().split("\n"):
            if line == "---" and seen < 2:
                seen += 1
                in_fm = seen == 1
                continue
            if in_fm:
                key, _, val = line.partition(":")
                entry[key.strip()] = val.strip()
            elif seen >= 2:
                body.append(line)
    entry["_body"] = "\n".join(body).strip("\n")
    return entry


def render(entry):
    fm = "\n".join(f"{k}: {entry.get(k, '')}".rstrip() for k in KEYS)
    body = entry.get("_body") or "## Review"
    return f"---\n{fm}\n---\n\n{body}\n"


def load_entries():
    entries = {}
    if os.path.isdir(IDEAS_DIR):
        for name in sorted(os.listdir(IDEAS_DIR)):
            if re.fullmatch(r"I-\d+\.md", name):
                e = read_entry(os.path.join(IDEAS_DIR, name))
                entries[e["id"]] = e
    return entries


def write_if_changed(path, content):
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() == content:
                return
    except FileNotFoundError:
        pass
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp, path)


def save(entries):
    os.makedirs(IDEAS_DIR, exist_ok=True)
    for e in entries.values():
        write_if_changed(os.path.join(IDEAS_DIR, f"{e['id']}.md"), render(e))
    rows = ["# Ideas (memory copy of ~/wiki/IDEA.md; written by `ideas`, never by hand)", "",
            "| id | status | verdict | text |", "|---|---|---|---|"]
    for e in sorted(entries.values(), key=lambda e: e["id"]):
        rows.append(f"| {e['id']} | {e.get('status', '')} | {e.get('verdict', '')} | {e['text'].replace('|', '/')} |")
    write_if_changed(os.path.join(IDEAS_DIR, "index.md"), "\n".join(rows) + "\n")


def status_for(mark):
    return {"done": "done", "dropped": "dropped"}.get(mark)


def match(ideas, entries):
    """{line index: (entry, ratio)}: exact normalized text first, then the closest remaining
    entry (difflib ratio, highest pairs first) at or above EDITED_AT."""
    live = [e for e in entries.values() if e.get("status") != "gone"]
    by_norm, found, used = {}, {}, set()
    for e in live:
        by_norm.setdefault(normalize(e["text"]), e)
    for i, (text, _, _) in enumerate(ideas):
        e = by_norm.get(normalize(text))
        if e is not None and e["id"] not in used:
            found[i] = (e, 1.0)
            used.add(e["id"])
    pairs = []
    for i, (text, _, _) in enumerate(ideas):
        if i in found:
            continue
        for e in live:
            if e["id"] not in used:
                r = difflib.SequenceMatcher(None, normalize(text), normalize(e["text"])).ratio()
                if r >= EDITED_AT:
                    pairs.append((r, i, e))
    for r, i, e in sorted(pairs, key=lambda p: -p[0]):
        if i not in found and e["id"] not in used:
            found[i] = (e, r)
            used.add(e["id"])
    return found


def cmd_sync():
    if not os.path.isfile(IDEAS_FILE):
        die(f"no ideas file at {IDEAS_FILE}")
    ideas = parse_ideas(IDEAS_FILE)
    entries = load_entries()
    found = match(ideas, entries)
    next_n = max([int(i[2:]) for i in entries] + [0]) + 1
    out = {"new": [], "edited": [], "closed": [], "gone": []}
    seen, day = set(), today()
    for i, (text, section, mark) in enumerate(ideas):
        e, ratio = found.get(i, (None, 0.0))
        if e is None:
            e = {"id": f"I-{next_n:03d}", "text": text, "section": section, "mark": mark,
                 "first_seen": day, "last_seen": day, "status": status_for(mark) or "new"}
            next_n += 1
            entries[e["id"]] = e
            if e["status"] == "new":
                out["new"].append(e["id"])
        else:
            closed = status_for(mark)
            if closed and e.get("status") != closed:
                out["closed"].append(e["id"])
                e["status"] = closed
            elif not closed and e.get("status") in ("done", "dropped"):
                e["status"] = "new"
                out["new"].append(e["id"])
            elif not closed and ratio < SAME_AT and e.get("status") != "new":
                e.update({"status": "edited", "answer": "", "answered_on": "", "later_until": ""})
                out["edited"].append(e["id"])
            e.update({"text": text, "section": section, "mark": mark, "last_seen": day})
        seen.add(e["id"])
    for e in entries.values():
        if e["id"] not in seen and e.get("status") != "gone":
            e["status"] = "gone"
            out["gone"].append(e["id"])
    save(entries)
    print(json.dumps(out))


def due(entries, day):
    return [e for e in entries.values()
            if e.get("status") in ("new", "edited") and e.get("answer") != "no"
            and (not e.get("later_until") or e["later_until"] <= day)]


def cmd_due(limit, ids):
    entries = load_entries()
    if ids:
        picked = [entries[i] for i in ids if i in entries]
    else:
        picked = sorted(due(entries, today()), key=lambda e: (e.get("first_seen", ""), e["id"]))
        picked = picked[:limit] if limit is not None else picked
    print(json.dumps([{k: e.get(k, "") for k in ("id", "text", "section", "status")} for e in picked]))


def entry_or_die(entries, eid):
    if eid not in entries:
        die(f"no idea {eid}")
    return entries[eid]


def cmd_record(eid, verdict, summary, file):
    if verdict not in ("stale", "actionable", "elaborate"):
        die(f"verdict is stale, actionable or elaborate, not {verdict}", 2)
    with open(file, encoding="utf-8") as f:
        review = f.read().strip()
    entries = load_entries()
    e = entry_or_die(entries, eid)
    e.update({"status": "reviewed", "verdict": verdict, "summary": " ".join(summary.split()),
              "reviewed_on": today(), "_body": f"## Review\n\n{review}"})
    save(entries)


def cmd_answer(eid, answer, days):
    if answer not in ("yes", "no", "later"):
        die(f"answer is yes, no or later, not {answer}", 2)
    entries = load_entries()
    e = entry_or_die(entries, eid)
    later = (date.fromisoformat(today()) + timedelta(days=days)).isoformat() if answer == "later" else ""
    e.update({"answer": answer, "answered_on": today(), "later_until": later})
    save(entries)


@contextmanager
def lock():
    """mkdir lock in IDEAS_DIR (pid inside); waits 30 s; a dead holder's lock is taken over."""
    os.makedirs(IDEAS_DIR, exist_ok=True)
    d = os.path.join(IDEAS_DIR, ".lock")
    for _ in range(150):
        try:
            os.mkdir(d)
            break
        except FileExistsError:
            try:
                with open(os.path.join(d, "pid")) as f:
                    pid = int(f.read().strip() or 0)
                os.kill(pid, 0)
            except (FileNotFoundError, ValueError, ProcessLookupError):
                shutil.rmtree(d, ignore_errors=True)
                continue
            except PermissionError:
                pass
            time.sleep(0.2)
    else:
        die("another ideas run holds the lock")
    with open(os.path.join(d, "pid"), "w") as f:
        f.write(str(os.getpid()))
    try:
        yield
    finally:
        shutil.rmtree(d, ignore_errors=True)


def opts(args, spec):
    """parse --flag value pairs; spec maps flag to 'one' or 'many'"""
    out, i = {}, 0
    while i < len(args):
        flag = args[i]
        if flag not in spec or i + 1 >= len(args):
            die(f"bad option {flag}", 2)
        if spec[flag] == "many":
            out.setdefault(flag, []).append(args[i + 1])
        else:
            out[flag] = args[i + 1]
        i += 2
    return out


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "sync" and not args:
        with lock():
            cmd_sync()
    elif cmd == "due":
        o = opts(args, {"--limit": "one", "--id": "many"})
        cmd_due(int(o["--limit"]) if "--limit" in o else None, o.get("--id", []))
    elif cmd == "record" and args:
        o = opts(args[1:], {"--verdict": "one", "--summary": "one", "--file": "one"})
        if not all(k in o for k in ("--verdict", "--summary", "--file")):
            die("record needs --verdict, --summary and --file", 2)
        with lock():
            cmd_record(args[0], o["--verdict"], o["--summary"], o["--file"])
    elif cmd == "answer" and len(args) >= 2:
        o = opts(args[2:], {"--days": "one"})
        with lock():
            cmd_answer(args[0], args[1], int(o.get("--days", 7)))
    else:
        die(f"unknown command: {' '.join(argv)}", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
