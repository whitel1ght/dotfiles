#!/usr/bin/env python3
"""Find what a usage coach can teach from: repeated prompts, restated rules, secrets in
files and concept questions. Prints JSON, read-only, no network, no model.

  coach-mine [--date YYYY-MM-DD]

Prints {"groups": [...], "concepts": [...]}.
groups use friction-mine's shape {sig, source, kind, count, keys, confidence, samples,
evidence} plus `days` (distinct dates in the window; 1 for secret):
  repeat    the same prompt (normalised) typed 2+ times in the date and the 13 days
            before, at least once on the date; high at 3+ times on 2+ days, else low
  restated  a prompt with a rule marker (remember, new rule, always, never, from now
            on) typed 2+ times in the window, at least once on the date; a match with
            a standing direction in directions.md is noted in samples as
            "(restates D-NNN)"; high
  secret    a token or private-key pattern in a scanned file right now; samples and
            evidence are "<path>:<line> <pattern>", never the value; high
concepts: [{harness, session, at, question, answer}] for the date: explain-style
questions that are not task requests, with the last assistant text of the turn.

Inputs, each overridable for tests:
  CLAUDE_PROJECTS_DIR  */<sid>.jsonl transcripts          (~/.claude/projects)
  PI_SESSIONS_DIR      **/*.jsonl transcripts             (~/.pi/agent/sessions)
  ZSH_HISTORY          scanned for secrets                (~/.zsh_history)
  FRICTION_WIKI        directions.md lives here           (~/wiki/work/friction)
  COACH_SCAN_DIRS      colon list of dirs scanned for secrets, git-listed
                       (~/wiki:~/projects/dotfiles:~/projects/decisions:~/projects/articles)
Unreadable files and malformed JSONL lines are skipped silently.
"""
import datetime
import glob
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
WINDOW_DAYS = 14
MAX_PROMPT = 3000
MAX_RULE = 600
MAX_CONCEPT_Q = 1200
MAX_ANSWER = 1500
MIN_ANSWER = 200
MAX_SECRET_FILE = 1_000_000

INJECTED_PREFIXES = ("<", "[", "# /", "Base directory", "The daily plugin sent", "Caveat:",
                     "inbox:", "A GitLab merge request", "This session is being continued")
INJECTED_ANYWHERE = ("task-notification", "system-reminder", "[daily-event]")
SMOKE = re.compile(r"^(reply|say|answer)\b.{0,40}(ok|pong)", re.I)
ACK_WORDS = set("""yes yeah yep no nope ok okay k sure fine good great nice right correct looks look
    go on ahead continue proceed please thanks thank you done it that this do so lets let's
    and then now next again retry try merge approve commit push post send""".split())
RULE_MARKER = re.compile(r"\b(remember|new rule|always|never|from now on)\b", re.I)

CONCEPT = re.compile(r"\b(explain|eli5|teach me|walk me through|what is|what are|what's|what does|"
                     r"how does|how do|why does|why do|why is|why are|difference between|"
                     r"i don't understand|don't get|how come|what exactly)\b", re.I)
EXPLAIN = re.compile(r"\b(explain|eli5|walk me through)\b", re.I)
POLITE_TASK = re.compile(r"^\s*(could|can|would|will) (you|we)\b", re.I)
STATUS_PING = re.compile(r"^\s*(so |okay,? |ok,? )?(where|how far|how is (it|the)|what('s| is) (left|next))\b", re.I)
AGENT_STATE = re.compile(r"\b(current session|session id|what model|which model|did you run)\b", re.I)

SECRET_PATTERNS = [
    ("bearer", re.compile(r"Bearer\s+[A-Za-z0-9._~+/=-]{20,}")),
    ("sk", re.compile(r"\bsk-[A-Za-z0-9_-]{20,}")),
    ("glpat", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}")),
    ("ghp", re.compile(r"\bghp_[A-Za-z0-9]{30,}")),
    ("aws", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("private-key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
]


def die(msg):
    print(f"coach-mine: {msg}", file=sys.stderr)
    sys.exit(1)


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def local_date(ts):
    try:
        if isinstance(ts, (int, float)):
            dt = datetime.datetime.fromtimestamp(ts / 1000)
        else:
            dt = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).astimezone()
        return dt.date()
    except (ValueError, TypeError, OverflowError, OSError):
        return None


def words(s):
    return re.findall(r"[a-z0-9']+", s.lower())


def realprompt(t):
    if not t or len(t) > MAX_PROMPT:
        return False
    t = t.lstrip()
    if t.startswith(INJECTED_PREFIXES) or any(x in t for x in INJECTED_ANYWHERE) or SMOKE.match(t):
        return False
    return True


def is_ack(t):
    w = words(t)
    return len(w) < 4 or all(x in ACK_WORDS for x in w)


def ticket_key(cwd):
    m = re.findall(r"[A-Z]{2,}-[0-9]+", cwd or "")
    return m[-1] if m else ""


def read_turns(path, harness):
    """Yield dicts {role, text, date, at, line, cwd} for real user prompts and assistant text."""
    cwd = ""
    try:
        fh = open(path, errors="replace")
    except OSError:
        return
    with fh:
        for n, line in enumerate(fh, 1):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            if harness == "pi":
                if e.get("type") == "session":
                    cwd = e.get("cwd") or cwd
                m = e.get("message")
                if e.get("type") != "message" or not isinstance(m, dict):
                    continue
                role = m.get("role")
                content = m.get("content")
                meta = False
            else:
                if e.get("type") not in ("user", "assistant") or e.get("isSidechain"):
                    continue
                cwd = e.get("cwd") or cwd
                m = e.get("message")
                if not isinstance(m, dict):
                    continue
                role = m.get("role")
                content = m.get("content")
                meta = bool(e.get("isMeta"))
                if role == "user" and isinstance(content, list) and any(
                        isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
                    continue
            if role not in ("user", "assistant") or meta:
                continue
            ts = e.get("timestamp")
            d = local_date(ts)
            yield {"role": role, "text": text_of(content).strip(), "date": d, "at": ts, "line": n,
                   "cwd": cwd, "path": path}


def transcripts(since):
    cutoff = datetime.datetime.combine(since, datetime.time.min).timestamp()
    cdir = os.environ.get("CLAUDE_PROJECTS_DIR", os.path.join(HOME, ".claude/projects"))
    pdir = os.environ.get("PI_SESSIONS_DIR", os.path.join(HOME, ".pi/agent/sessions"))
    found = [(p, "claude") for p in glob.glob(os.path.join(glob.escape(cdir), "*", "*.jsonl"))]
    found += [(p, "pi") for p in glob.glob(os.path.join(glob.escape(pdir), "**", "*.jsonl"), recursive=True)]
    for p, h in sorted(found):
        try:
            if os.path.getmtime(p) >= cutoff:
                yield p, h
        except OSError:
            continue


def collect(date):
    """Return (prompts in the window, concept turns on date)."""
    since = date - datetime.timedelta(days=WINDOW_DAYS - 1)
    prompts, concepts = [], []
    seen = set()
    for path, harness in transcripts(since):
        session = os.path.splitext(os.path.basename(path))[0]
        current = None
        for t in read_turns(path, harness):
            if t["role"] == "user":
                current = None
                if t["date"] is None or not (since <= t["date"] <= date) or not realprompt(t["text"]):
                    continue
                p = dict(t, harness=harness, session=session, answer="")
                # resumed sessions replay the same prompt: one entry per (day, text)
                k = (t["date"], t["text"])
                if k in seen:
                    continue
                seen.add(k)
                prompts.append(p)
                current = p
            elif current is not None and t["text"]:
                current["answer"] = t["text"]
    for p in prompts:
        if p["date"] == date:
            concepts.append(p)
    return prompts, concepts


def normalise(t):
    s = t.lower()
    s = re.sub(r"```.*?```", " <q> ", s, flags=re.S)
    s = re.sub(r"`[^`]*`|\"[^\"]*\"|“[^”]*”", " <q> ", s)
    s = re.sub(r"(?<!\w)'[^']{2,}'(?!\w)", " <q> ", s)
    s = re.sub(r"https?://\S+", " <url> ", s)
    s = re.sub(r"[a-z]{2,}-\d+", " <key> ", s)
    s = re.sub(r"!\d+", " <mr> ", s)
    s = re.sub(r"(?<!\w)[~.]?/?[\w.@-]+(/[\w.@-]+)+/?", " <path> ", s)
    s = re.sub(r"\d+", " <n> ", s)
    s = re.sub(r"[^\w<>\s]", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def norm_rule(t):
    return re.sub(r"\s+", " ", re.sub(r"[^\w\s]", "", t.lower())).strip()


def directions():
    path = os.path.join(os.environ.get("FRICTION_WIKI", os.path.join(HOME, "wiki/work/friction")), "directions.md")
    rows = []
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                c = [x.strip() for x in line.split("|")]
                if len(c) > 6 and re.fullmatch(r"D-\d+", c[1]) and c[6] == "active":
                    rows.append((c[1], norm_rule(c[2])))
    except OSError:
        pass
    return rows


def group(sig, kind, items, conf, extra_samples=()):
    samples = []
    for i in items:
        s = i["text"][:200]
        if s not in samples:
            samples.append(s)
    return {
        "sig": sig, "source": "user", "kind": kind, "count": len(items),
        "days": len({i["date"] for i in items}),
        "keys": sorted({k for k in (ticket_key(i["cwd"]) for i in items) if k}),
        "confidence": conf,
        "samples": (samples + list(extra_samples))[:3 + len(extra_samples)],
        "evidence": [f"{i['path']}:{i['line']}" for i in items][:5],
    }


def repeats_and_restated(prompts, date):
    clusters, rules = {}, {}
    for p in prompts:
        if is_ack(p["text"]):
            continue
        if len(p["text"]) <= MAX_RULE and RULE_MARKER.search(p["text"]):
            n = normalise(p["text"])
            if n:
                rules.setdefault(n[:120], []).append(p)
        elif len(p["text"]) <= MAX_RULE:
            n = normalise(p["text"])
            if n:
                clusters.setdefault(n[:120], []).append(p)
    out = []
    for key, items in clusters.items():
        if len(items) < 2 or not any(i["date"] == date for i in items):
            continue
        high = len(items) >= 3 and len({i["date"] for i in items}) >= 2
        out.append(group(f"user:repeat:{key}", "repeat", items, "high" if high else "low"))
    dirs = directions()
    for key, items in rules.items():
        if not any(i["date"] == date for i in items):
            continue
        hits = []
        for did, rule in dirs:
            if len(rule) >= 20 and (rule in norm_rule(items[0]["text"]) or norm_rule(items[0]["text"]) in rule):
                hits.append(did)
        if len(items) < 2 and not hits:
            continue
        extra = [f"(restates {hits[0]})"] if hits else []
        out.append(group(f"user:restated:{key}", "restated", items, "high", extra))
    return out


def concept_turns(candidates):
    out, seen = [], set()
    for p in candidates:
        q, a = p["text"], p["answer"]
        if len(q) > MAX_CONCEPT_Q or len(a) < MIN_ANSWER or not CONCEPT.search(q):
            continue
        if STATUS_PING.match(q) or AGENT_STATE.search(q):
            continue
        if POLITE_TASK.match(q) and not EXPLAIN.search(q):
            continue
        k = (q, a[:100])
        if k in seen:
            continue
        seen.add(k)
        out.append({"harness": p["harness"], "session": p["session"], "at": p["at"],
                    "question": q, "answer": a[:MAX_ANSWER]})
    return out


def scan_files():
    paths = []
    zsh = os.environ.get("ZSH_HISTORY", os.path.join(HOME, ".zsh_history"))
    paths.append(zsh)
    dirs = os.environ.get("COACH_SCAN_DIRS") or ":".join(
        os.path.join(HOME, d) for d in ("wiki", "projects/dotfiles", "projects/decisions", "projects/articles"))
    for d in filter(None, dirs.split(":")):
        if not os.path.isdir(d):
            continue
        try:
            r = subprocess.run(["git", "-C", d, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                               capture_output=True, timeout=60)
            if r.returncode == 0:
                paths += [os.path.join(d, x.decode(errors="replace")) for x in r.stdout.split(b"\0") if x]
                continue
        except (OSError, subprocess.SubprocessError):
            pass
        for root, subdirs, files in os.walk(d):
            subdirs[:] = [x for x in subdirs if x not in (".git", "node_modules")]
            paths += [os.path.join(root, x) for x in files]
    return paths


def secrets():
    found = {}
    for path in scan_files():
        try:
            if not os.path.isfile(path) or os.path.getsize(path) > MAX_SECRET_FILE:
                continue
            with open(path, "rb") as fh:
                data = fh.read()
        except OSError:
            continue
        if b"\0" in data[:8000]:
            continue
        for n, line in enumerate(data.decode(errors="replace").splitlines(), 1):
            for name, rx in SECRET_PATTERNS:
                if rx.search(line):
                    found.setdefault((name, path), []).append(n)
    out = []
    for (name, path), lines in sorted(found.items()):
        ev = [f"{path}:{n} {name}" for n in lines[:5]]
        out.append({"sig": f"files:secret:{name}:{path}", "source": "files", "kind": "secret",
                    "count": len(lines), "days": 1, "keys": [], "confidence": "high",
                    "samples": ev[:3], "evidence": ev})
    return out


def main(argv):
    date = datetime.date.today()
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--date" and args:
            v = args.pop(0)
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", v):
                die(f"--date must be YYYY-MM-DD, got {v}")
            try:
                date = datetime.date.fromisoformat(v)
            except ValueError:
                die(f"--date must be YYYY-MM-DD, got {v}")
        elif a == "--date":
            die("--date needs a value")
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return
        else:
            die(f"unknown option {a}")
    prompts, today = collect(date)
    groups = repeats_and_restated(prompts, date) + secrets()
    groups.sort(key=lambda g: (-g["count"], g["sig"]))
    json.dump({"groups": groups, "concepts": concept_turns(today)}, sys.stdout, separators=(",", ":"))
    print()


if __name__ == "__main__":
    main(sys.argv[1:])
