#!/usr/bin/env python3
"""Read one secret from ~/.secrets/secrets.env.

  secret NAME    print its value (no newline), for $(secret NAME) in scripts
  secret -l      list the names, never the values

The file is plain KEY=value lines (comments, blanks, an `export ` prefix and
one pair of quotes allowed; no $-expansion), so it stays readable by the
ecfx-credentials loader that ~/.config/ecfx/jira.env links to it for. Edit it
with `secrets`. Agents are kept out of ~/.secrets; a script that needs a token
calls this inline, so the value never reaches an agent's output.

SECRETS_FILE overrides the path (tests).
"""

import os
import sys
from pathlib import Path

FILE = Path(os.environ.get("SECRETS_FILE", "~/.secrets/secrets.env")).expanduser()


def parse(path: Path) -> dict[str, str]:
    out = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip().removeprefix("export ").strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        if value:
            out[key] = value
    return out


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not FILE.is_file():
        print(f"secret: {FILE} not found", file=sys.stderr)
        return 1
    values = parse(FILE)
    if sys.argv[1] == "-l":
        print("\n".join(values))
        return 0
    name = sys.argv[1]
    if name not in values:
        print(f"secret: {name} is not set in {FILE} (edit it with `secrets`)", file=sys.stderr)
        return 1
    sys.stdout.write(values[name])
    return 0


if __name__ == "__main__":
    sys.exit(main())
