#!/usr/bin/env bash
#
# session-picker — an fzf picker over tmux windows running AI coding agents
# (Claude Code, pi, opencode, codex); jump to the one you choose. Shows a
# per-row preview of each session's recap.
#
# Windows are identified by process (a "claude", "pi", "opencode", or "codex"
# process in the pane's subtree), not by version string, so it survives agent
# updates. "Busy" — a turn in flight — is inferred from the live status line;
# a pane parked at the prompt is treated as idle.
#
# Usage:
#   session-picker            # fzf picker of BUSY agent windows; jump to the pick
#   session-picker --all      # picker over ALL agent windows, busy or not
#   session-picker --list     # just print the windows (one "session:window" per line)
#   session-picker --print    # picker, but print the choice instead of switching
#
# Intended to be driven from a tmux key binding (see .tmux.conf), but works
# standalone. The binding runs it inside `tmux popup`; the script reads the
# invoking client via #{client_name} at runtime so switch-client targets the
# right terminal rather than the popup's own client.

set -euo pipefail

# Signals that an AI agent turn is in flight. Distinct on-screen shapes:
#
#  Claude Code:
#       ✽ Inferring… (37s · ↓ 2.0k tokens)
#       ✻ Bloviating… (2m 37s · ↓ 1.7k tokens)      <- minutes appear past 60s
#       ✻ Cerebrating… (12s · ↑ 3.2k tokens · esc to interrupt)
#     Background-agent rows (NOT parenthesised):
#       ○ general-purpose  Review Task 8: loaders    1m 40s · ↓ 90.4k tokens
#
#  pi (ponytail extension):
#       LSP Inactive ● 🐴 ponytail: ⚡ FULL          <- ● = busy, ○ = idle
#       ── ⠼ Working ───                            <- braille spinner + Working
#
#  opencode:
#       ⬝⬝⬝⬝⬝⬝⬝⬝ esc interrupt                      <- progress bar + "esc interrupt"
#
#  codex:
#       ⠋ Working (0s • esc to interrupt)           <- spinner + Working + timer
#
# For the unparenthesised Claude form the "↓/↑" arrow before "tokens" is what
# keeps it output-safe: agent rows always carry it, ordinary text never does.
# That also stops "✻ Cooked for 16m 38s" (a FINISHED turn) from matching.
# Bare words ("Working") are avoided; they collide with "working tree clean".
#
# NOTE: unlike pane identification (which is version-independent), this DOES read
# each agent's status-line wording, so a future UI change could require updating
# it. It degrades gracefully: if the wording changes, identification and `--all`
# keep working — only the busy *filter* would need a new pattern here.
# (Defined up here because the --preview subcommand below uses it and exits early.)
BUSY_RE='esc to interrupt|esc interrupt|\([0-9]+[ms][^)]*·[^)]*tokens|[0-9]+[ms]([[:space:]]+[0-9]+s)?[[:space:]]*·[[:space:]]*[↓↑][^|]*tokens|●|[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏] Working|Working \([0-9]+[ms]'

# Extract a window's session recap: the "※ recap:" one-liner Claude Code and pi
# print to summarize what the session is about. It is the single most useful thing
# to show in the preview — better than the window name or raw pane content. The
# recap can wrap onto indented continuation lines, so we grab from the recap
# marker until the next unindented line or the input chrome, and drop the marker
# and the "(disable recaps in /config)" trailer. Prints nothing if there is none.
window_recap() {
    local loc="$1"
    # Anchor on the actual recap marker "※ recap:" at the start of a
    # line, so we don't match the literal word "recap:" appearing elsewhere in
    # content. The "※" glyph is passed in as an awk variable (matching it via
    # byte escapes is unreliable in BSD awk). The recap's first line is
    # "※ recap: <text>"; continuation lines are indented. Grab from the
    # recap line until a blank line, a horizontal rule, or the input chrome.
    tmux capture-pane -p -t "$loc" 2>/dev/null | awk -v m='※' '
        !grab && index($0, m " recap:") { grab=1 }
        grab {
            if (started && ($0 ~ /^[[:space:]]*$/ || $0 ~ /-- INSERT --/ \
                || $0 ~ /new task\? \/clear/)) exit
            line=$0
            sub(/^[^:]*recap:[[:space:]]*/, "", line)   # drop "… recap:" prefix
            gsub(/\(disable recaps in \/config\)/, "", line)  # drop the trailer
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
            if (line != "" && line !~ /^[-─]+$/) { print line; started=1 }
        }
    '
}

# Hidden subcommand: render the preview for a highlighted row. Argument is a
# "session:window" (possibly with a trailing " (here)" tag). Must run before the
# rest of setup so it stays cheap and side-effect-free.
if [ "${1:-}" = "--preview" ]; then
    loc="${2:-}"
    loc="${loc% (here)}"
    [ -n "$loc" ] || exit 0

    g() { grep "$@" || true; }  # tolerate no-match under set -e/pipefail

    # Show ONLY the session recap — the agent's own one-line summary — which is far
    # more useful than the window name or a raw pane tail. If there is no recap,
    # print nothing; the picker then hides the preview pane (a raw tail is noise).
    recap="$(window_recap "$loc")"
    [ -n "$recap" ] || exit 0

    # Prefix with the live status line when a turn is in flight.
    status="$(tmux capture-pane -p -t "$loc" 2>/dev/null \
              | g -iE "$BUSY_RE" | tail -n1 | sed 's/^[[:space:]]*//')"
    [ -n "$status" ] && printf '  %s\n\n' "$status"

    printf '%s\n' "$recap"
    exit 0
fi

# Hidden subcommand: exit 0 if the window has a recap, 1 otherwise. fzf's focus
# binding uses this to show the preview pane only for rows that have something
# worth previewing, and hide it (a bare blank pane is noise) for those that don't.
if [ "${1:-}" = "--has-recap" ]; then
    loc="${2:-}"
    loc="${loc% (here)}"
    [ -n "$loc" ] || exit 1
    [ -n "$(window_recap "$loc")" ]
    exit $?
fi

# Hidden subcommand: close (kill) the given windows. Each argument is a row's
# field-1 value (a "session:window", possibly with a trailing " (here)"). Called
# from fzf's ctrl-x / ctrl-r binds. Safety rules:
#   - never kill the window the picker was invoked from (the "(here)" one);
#   - skip a window that is busy (a turn in flight), UNLESS --force is given;
#   - re-check busy state live here, not from the (possibly stale) list;
#   - a kill of an already-gone window is a no-op, not an error.
# Runs via execute-silent, so it must stay quiet on stdout.
if [ "${1:-}" = "--close" ]; then
    shift
    force=0
    if [ "${1:-}" = "--force" ]; then force=1; shift; fi
    # The window we were invoked from — never batch-close it.
    self="$(tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null || true)"
    for row in "$@"; do
        loc="${row% (here)}"
        [ -n "$loc" ] || continue
        [ "$loc" = "$self" ] && continue          # never kill the current window
        if [ "$force" -ne 1 ]; then
            # Re-check busy state at kill time; skip if a turn is in flight.
            snap="$(tmux capture-pane -p -t "$loc" 2>/dev/null || true)"
            if printf '%s\n' "$snap" | grep -qiE "$BUSY_RE"; then
                continue
            fi
        fi
        tmux kill-window -t "$loc" 2>/dev/null || true
    done
    exit 0
fi

MODE="pick"     # pick | list | print
SCOPE="busy"    # busy | all

# --rows is handled by a dedicated block further down (it needs functions defined
# after this loop). It's a flag, not a scope carrier — the scope still comes from
# --all, exactly like the interactive path. Recognize it here so it isn't rejected
# by the catch-all below.
rows_mode=0
for arg in "$@"; do
    case "$arg" in
        --list)  MODE="list" ;;
        --print) MODE="print" ;;
        --all)   SCOPE="all" ;;
        --rows)  rows_mode=1 ;;
        -h|--help)
            sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

if [ -z "${TMUX:-}" ] && ! tmux info >/dev/null 2>&1; then
    echo "no tmux server running" >&2
    exit 1
fi

# Absolute path to this script, so fzf's --preview can re-invoke it.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Emit "session:window" for every pane that is an AI agent session.
#
# Identification is version-independent: a pane is an agent session if its
# process subtree contains a process named "claude", "pi", "opencode", or
# "codex" (the binary). We deliberately do NOT match the version string the
# agent reports as its command name (e.g. "2.1.218") — that changes on every
# update — nor the pane title glyph, which is an animated spinner while a turn
# runs and so is not a stable marker.
#
# The check uses a SINGLE `ps` snapshot walked in awk, not a per-pane `pgrep -P`.
# That matters for correctness as much as speed: agents spawn short-lived
# children, so per-pane pgrep calls race against a moving process tree and
# intermittently miss the agent child. One consistent snapshot does not.
#
# awk walks, for each pane_pid, its descendants and reports whether any is an
# agent process; the shell then maps the matching pids back to "session:window".
agent_panes() {
    # pane_pid -> "session:window" map, tab-separated.
    local map
    map="$(tmux list-panes -a -F '#{pane_pid}	#{session_name}:#{window_index}')"

    # One ps snapshot; awk marks each root pid whose subtree contains an agent.
    printf '%s\n' "$map" | awk '
        NR==FNR { loc[$1]=$2; next }           # first pass: the tmux map
        { comm[$1]=$3; ppid[$1]=$2 }           # second pass: ps snapshot
        END {
            for (root in loc) {
                # BFS over descendants of this pane_pid
                delete seen; qn=0; q[qn++]=root; hit=0
                for (i=0; i<qn; i++) {
                    cur=q[i]
                    for (pid in ppid) {
                        if (ppid[pid]==cur && !(pid in seen)) {
                            seen[pid]=1; q[qn++]=pid
                            # comm may be a bare name ("claude") or a full path
                            # ("/Users/.../claude"); match the basename either way.
                            c=comm[pid]; sub(/^.*\//, "", c)
                            if (c ~ /^(claude|pi|opencode|codex)$/) hit=1
                        }
                    }
                }
                if (hit) print loc[root]
            }
        }
    ' - <(ps -ax -o pid=,ppid=,comm=) \
        | sort -u
}

# Print windows to consider, one "session:window" per line, honoring SCOPE.
select_windows() {
    local loc snap
    while IFS= read -r loc; do
        [ -n "$loc" ] || continue
        if [ "$SCOPE" = "all" ]; then
            echo "$loc"
            continue
        fi
        snap="$(tmux capture-pane -p -t "$loc" 2>/dev/null || true)"
        if printf '%s\n' "$snap" | grep -qiE "$BUSY_RE"; then
            echo "$loc"
        fi
    done < <(agent_panes)
}

# Build each picker row as TAB-separated columns for fzf:
#   1: raw "session:window" (hidden; used for selection + as the preview argument)
#   2: status icon  — ● busy, ○ idle
#   3: location, padded to align (+ " (here)" for the current window)
#   4: window name (agents name the window after the task, so this is the useful
#      label; the live pane content is shown in the preview pane instead of inline)
# The window we were invoked from (passed as $1) is tagged "(here)"; selecting it
# is a no-op that just closes the popup.
annotate() {
    local self="$1" loc name snap icon here_tag label
    while IFS= read -r loc; do
        [ -n "$loc" ] || continue
        name="$(tmux display-message -p -t "$loc" '#{window_name}' 2>/dev/null || echo '?')"
        snap="$(tmux capture-pane -p -t "$loc" 2>/dev/null || true)"
        if printf '%s\n' "$snap" | grep -qiE "$BUSY_RE"; then
            icon='●'
        else
            icon='○'
        fi
        here_tag=""
        [ "$loc" = "$self" ] && here_tag=' (here)'
        label="$loc$here_tag"
        # Leading space on the icon field keeps a gap between fzf's selection
        # marker (●, shown for checked rows) and the busy/idle icon — otherwise
        # they render flush against each other as one blob.
        printf '%s\t%s\t%-18s\t%s\n' "$loc$here_tag" " $icon" "$label" "$name"
    done
}

# Hidden subcommand: print the annotated picker rows for the selected scope.
# Used both to fill fzf initially and as its reload() command after a close, so
# the list regenerates from one code path. SCOPE was already set by the argument
# loop above (--rows [busy|all]); this block just emits the rows. Placed here
# (not with the top subcommands) because it calls select_windows/annotate, which
# are defined above this point.
if [ "$rows_mode" -eq 1 ]; then
    here="$(tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null || true)"
    select_windows | annotate "$here"
    exit 0
fi

windows="$(select_windows)"

# The window the user is currently viewing. It's kept in the picker (tagged
# "(here)") so the list is complete; selecting it just closes the popup.
here="$(tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null || true)"

if [ "$MODE" = "list" ]; then
    printf '%s\n' "$windows"
    exit 0
fi

# Everything below is the interactive picker. Pauses on any dead-end message so a
# tmux popup doesn't blink shut before it can be read.
notice() { echo "$1" >&2; [ -t 1 ] && sleep 1.4; }

if [ -z "$windows" ]; then
    label="busy agent"
    [ "$SCOPE" = "all" ] && label="agent"
    notice "No $label windows right now."
    exit 0
fi

# Show every busy window, including the current one. Plain fzf (not fzf-tmux):
# the caller runs us inside a `tmux popup`, which already frames the overlay — so
# fzf itself uses no outer border (avoids a double frame), only a thin separator
# line on the preview.
#
# Column layout from annotate (tab-separated):
#   f1 = raw "session:window" (hidden; used for selection + preview arg)
#   f2 = icon  f3 = location  f4 = window name
# --with-nth=2.. shows only the display columns; f1 is what we read back.
title="Busy agent sessions"
[ "$SCOPE" = "all" ] && title="Agent sessions"

# Flags to reproduce the current scope when re-invoking ourselves for the row
# list (initial fill and reload after a close). --rows emits the annotated rows;
# --all carries the scope, matching how the interactive path is invoked.
rows_flags="--rows"
[ "$SCOPE" = "all" ] && rows_flags="--rows --all"

# Responsive preview placement: a side-by-side preview needs width. Below a
# threshold, stack it BELOW the list (not above) so the list stays anchored at
# the top and only the area beneath it appears/disappears — otherwise showing
# and hiding the preview between recap and no-recap rows makes the list jump.
# Very narrow terminals hide it entirely. Width comes from the terminal columns.
cols="$(tput cols 2>/dev/null || echo 80)"
if   [ "$cols" -ge 120 ]; then preview_win='right,50%,border-left,wrap'
elif [ "$cols" -ge 80  ]; then preview_win='down,45%,border-top,wrap'
else                           preview_win='hidden'
fi

# Per-row preview visibility: on every focus change, show the preview in the
# responsive layout only when the highlighted window actually has a recap;
# otherwise hide it, so rows with nothing to show don't leave a blank pane.
# ctrl-/ still toggles it manually. On very narrow terminals it stays hidden.
if [ "$preview_win" = "hidden" ]; then
    focus_bind='focus:hide-preview'
else
    focus_bind="focus:transform:[ \"\$($SELF --has-recap {1}; echo \$?)\" = 0 ] && echo 'change-preview-window($preview_win)' || echo 'hide-preview'"
fi

choice="$("$SELF" $rows_flags \
    | fzf --delimiter='\t' \
        --with-nth='2..' \
        --no-sort --cycle --multi \
        --layout=reverse \
        --info=inline \
        --border=none \
        --padding=0 --margin=0 \
        --prompt="$title  ›  " \
        --pointer='▎' --marker='●' \
        --header='enter jump · tab mark · ctrl-x close · ctrl-r force · ctrl-/ preview' --header-first \
        --preview="$SELF --preview {1}" \
        --preview-window="$preview_win" \
        --preview-label=' recap ' \
        --bind='ctrl-/:toggle-preview' \
        --bind="$focus_bind" \
        --bind="ctrl-x:execute-silent($SELF --close {+1})+reload($SELF $rows_flags)" \
        --bind="ctrl-r:execute-silent($SELF --close --force {+1})+reload($SELF $rows_flags)" \
        --color='fg:-1,bg:-1,hl:6,fg+:15,bg+:-1,hl+:14,border:8,label:7,prompt:6,pointer:5,header:8,info:8,preview-border:8' \
    | cut -f1 | sed 's/ (here)$//')"

[ -n "$choice" ] || exit 0

if [ "$MODE" = "print" ]; then
    printf '%s\n' "$choice"
    exit 0
fi

# Picking the current window is a no-op: just close the popup, no switch needed.
if [ "$choice" = "$here" ]; then
    exit 0
fi

# Switch the caller's client to the chosen window. When run inside a `tmux popup`,
# `display-message -p '#{client_name}'` still resolves to the client that opened
# the popup, so targeting it explicitly switches the right terminal. (tmux does
# NOT expand #{client_name} in a binding's `display-popup -e`, so it must be read
# here, at runtime, rather than passed in as an environment variable.)
client="$(tmux display-message -p '#{client_name}' 2>/dev/null)"
if [ -n "$client" ]; then
    tmux switch-client -c "$client" -t "$choice"
else
    tmux switch-client -t "$choice"
fi
