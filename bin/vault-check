#!/usr/bin/env bash
# Warn when the machine-rebuild vault is behind the files it mirrors.
#
# Called from .zshrc. Compares modification times only — it never opens the
# vault, so it needs no passphrase and costs nothing at shell startup.
#
# The list of managed files lives in the vault's own library rather than here,
# so there is one source of truth and this public repo names none of those
# paths. Silent when that library or the vault is absent, which is the normal
# state on a fresh machine until the wiki is restored.
set -uo pipefail

LIB="${VAULT_LIB:-$HOME/wiki/vault-lib.sh}"
[ -r "$LIB" ] || exit 0

# shellcheck source=/dev/null
. "$LIB" 2>/dev/null || exit 0
DB="${VAULT_DEFAULT:-}"
[ -n "$DB" ] && [ -f "$DB" ] || exit 0

stale=()
check() { [ -f "$1" ] && [ "$1" -nt "$DB" ] && stale+=("${1##*/}"); }

for spec in "${VAULT_NOTE_ENTRIES[@]:-}"; do
  [ -n "$spec" ] && check "${spec#*:}"
done
for spec in "${VAULT_ATTACHMENTS[@]:-}"; do
  [ -n "$spec" ] || continue
  rest="${spec#*:}"; check "${rest#*:}"
done

[ ${#stale[@]} -eq 0 ] && exit 0

printf '\033[1;33m⚠ vault is behind:\033[0m %s\n' "$(printf '%s, ' "${stale[@]}" | sed 's/, $//')"
printf '  run \033[1mvault-sync.sh\033[0m to update it and refresh the offline copy\n'
