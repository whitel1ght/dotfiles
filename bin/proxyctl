#!/usr/bin/env bash
# Control the sing-box TUN proxy.
#
# Routing lives in dotfiles/proxy/. Edit proxy-domains.txt (tunnelled),
# block-domains.txt (rejected) or reader-domains.txt (blocked except for the
# feed reader), then `proxyctl reload`.
# Secrets live in ~/.config/sing-box/secrets.env and never enter git.
#
# The iPhone runs Happ with the same proxy list and blocks nothing. `proxyctl
# happ` shows its routing profile as a QR code to scan with the camera, rendered
# from proxy-domains.txt, so re-run it after editing that list. `proxyctl happ server` shows the VPS itself, for
# a first-time setup; that QR carries the credentials, so show it only to the phone.
# The QR opens as an image in Preview; add --terminal to print it in the shell.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/projects/dotfiles}"
PROXY_DIR="$DOTFILES/proxy"
SECRETS="$HOME/.config/sing-box/secrets.env"
RUNTIME_DIR="/usr/local/etc/sing-box"
RUNTIME_CFG="$RUNTIME_DIR/config.json"
PLIST="/Library/LaunchDaemons/local.singbox.plist"
LABEL="local.singbox"
API="http://127.0.0.1:9090"
LOG="/var/log/sing-box.log"

die() { echo "proxyctl: $*" >&2; exit 1; }

render() {
  [ -f "$SECRETS" ] || die "missing $SECRETS (copy proxy/secrets.env.example)"
  local tmp; tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN
  "$PROXY_DIR/render.py" "$PROXY_DIR/config.template.json" \
    "$PROXY_DIR/proxy-domains.txt" "$PROXY_DIR/block-domains.txt" \
    "$PROXY_DIR/reader-domains.txt" "$SECRETS" "$tmp"
  sing-box check -c "$tmp" || die "rendered config is invalid; not installing"
  sudo mkdir -p "$RUNTIME_DIR"
  sudo install -m 600 -o root -g wheel "$tmp" "$RUNTIME_CFG"
}

# Flip the default-route selector without restarting the daemon.
selector() {
  curl -fsS -X PUT -H 'Content-Type: application/json' \
    -d "{\"name\":\"$1\"}" "$API/proxies/final-out" >/dev/null \
    || die "control API unreachable — is the daemon running?"
  echo "default route -> $1"
}

current_route() {
  curl -fsS --max-time 3 "$API/proxies/final-out" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("now","unknown"))' 2>/dev/null \
    || echo "unknown"
}

case "${1:-status}" in
  on)
    render
    sudo launchctl bootstrap system "$PLIST" 2>/dev/null \
      || sudo launchctl kickstart -k "system/$LABEL"
    echo "proxy on"
    ;;
  off)
    sudo launchctl bootout "system/$LABEL" 2>/dev/null || true
    echo "proxy off"
    ;;
  reload)
    render
    sudo launchctl kickstart -k "system/$LABEL"
    # render() already printed the proxied/blocked counts; recounting here
    # only creates a second number that can drift from the rendered config.
    echo "reloaded"
    ;;
  logs)   sudo tail -f "$LOG" ;;
  all)    selector proxy ;;
  direct) selector direct ;;
  status)
    # Deliberately sudo-free: `sudo launchctl print` fails silently in a
    # non-interactive shell and reports a running daemon as stopped.
    if pgrep -f "sing-box run -c $RUNTIME_CFG" >/dev/null 2>&1; then
      echo "daemon        : running"
      echo "default route : $(current_route)"
      echo -n "egress        : "
      curl -s --max-time 8 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null \
        | sed -n 's/^ip=//p' || echo "unreachable"
    else
      echo "daemon        : stopped"
    fi
    ;;
  happ)
    if [ "${2:-}" = server ]; then
      [ -f "$SECRETS" ] || die "missing $SECRETS (copy proxy/secrets.env.example)"
      link="$("$PROXY_DIR/render-happ.py" server "$SECRETS")"
      what="the VPS server (contains credentials; don't share or screenshot it)"
    else
      link="$("$PROXY_DIR/render-happ.py" routing "$PROXY_DIR/proxy-domains.txt")"
      what="the routing profile (only the proxy-domains.txt list goes through the VPS)"
    fi
    command -v qrencode >/dev/null || { echo "$link"; die "qrencode not installed (brew install qrencode); send the link above to the phone instead"; }
    if [ "${3:-${2:-}}" = --terminal ]; then
      qrencode -t ansiutf8 -m 2 "$link"
    else
      # The link runs to ~1.4 KB, so the code is ~120 modules a side: too big for
      # a terminal, sharp as an image. The file holds the link, credentials
      # included for `server`, so it is private and removed shortly after.
      png="$(mktemp -t happ-qr)"
      qrencode -t PNG -o "$png" -s 8 -m 4 "$link"
      open -a Preview "$png"
      (sleep 120; rm -f "$png") >/dev/null 2>&1 &
    fi
    echo "Scan with the iPhone camera, open in Happ: $what."
    ;;
  *)
    echo "usage: proxyctl {on|off|status|reload|logs|all|direct|happ [server] [--terminal]}" >&2
    exit 1
    ;;
esac
