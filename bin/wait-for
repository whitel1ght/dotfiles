#!/usr/bin/env bash
# Wait for a down service to come back, then tell the run-day inbox. Spends no tokens.
#
#   wait-for gitlab|jira [--key KEY] [--max-hours N] [--detach]
#
#   --key        Jira key of the item that hit the outage; goes on the inbox note
#   --max-hours  give up after N hours (default 8); decimals are fine
#   --detach     start in the background, detached from the terminal; prints the pid
#
# Probes with `glab api user` (gitlab) or `jira-api GET myself` (jira), up only when
# the answer names a user (an HTTP error body is not up), starting at once and then
# after 30 s, doubling up to 10 min between probes. When the probe
# succeeds it leaves `day-note --kind service` ("<service> is back") and logs a
# friction event (service_down, with the outage duration). On give-up it leaves
# a note ("<service> still down after <N>h — gave up") and the friction event, and exits 1.
# One instance per service: a lock directory $WAIT_FOR_DIR/<service>.lock (default
# ~/.local/state/wait-for); a second instance exits 0 quietly. A detached run logs
# to $WAIT_FOR_DIR/<service>.log.
# Test hooks: WAIT_FOR_GITLAB_PROBE, WAIT_FOR_JIRA_PROBE (a shell command, exit 0 =
# up), WAIT_FOR_SLEEP (command taking seconds), WAIT_FOR_NOW (command printing epoch
# seconds), DAY_NOTE and FRICTION (commands to call).
set -euo pipefail

WAIT_FOR_DIR="${WAIT_FOR_DIR:-$HOME/.local/state/wait-for}"
DAY_NOTE="${DAY_NOTE:-day-note}"
FRICTION="${FRICTION:-friction}"
WAIT_FOR_SLEEP="${WAIT_FOR_SLEEP:-sleep}"
WAIT_FOR_NOW="${WAIT_FOR_NOW:-date +%s}"

die() { echo "wait-for: $*" >&2; exit 1; }
need() { [ $# -ge 2 ] || die "$1 needs a value"; }

service="" key="" max_hours=8 detach=no
while [ $# -gt 0 ]; do
  case "$1" in
    --key) need "$@"; key="$(tr '[:lower:]' '[:upper:]' <<<"$2")"; shift ;;
    --max-hours) need "$@"; max_hours="$2"; shift ;;
    --detach) detach=yes ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) [ -z "$service" ] || die "usage: wait-for gitlab|jira [--key KEY] [--max-hours N] [--detach]"; service="$1" ;;
  esac
  shift
done

case "$service" in
  gitlab) probe="${WAIT_FOR_GITLAB_PROBE:-glab api user | jq -e .id}" ;;
  jira) probe="${WAIT_FOR_JIRA_PROBE:-jira-api GET myself | jq -e .accountId}" ;;
  *) die "SERVICE must be gitlab or jira, got ${service:-nothing}" ;;
esac
[ -z "$key" ] || [[ "$key" =~ ^[A-Z]+-[0-9]+$ ]] || die "KEY must look like ECFX-18169, got $key"
[[ "$max_hours" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--max-hours must be a number, got $max_hours"

lock="$WAIT_FOR_DIR/$service.lock"
# held: the lock's pid is alive and is a wait-for; a lock dir without a pid file is
# held for 5 s (its owner is between mkdir and the pid write), stale after that
held() {
  local pid age
  if [ ! -f "$lock/pid" ]; then
    [ -d "$lock" ] || return 1
    age=$(( $(date +%s) - $(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock") ))
    [ "$age" -lt 5 ]
    return
  fi
  pid="$(cat "$lock/pid" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && [[ "$(ps -o command= -p "$pid" 2>/dev/null)" == *wait-for* ]]
}

if [ "$detach" = yes ]; then
  held && exit 0
  mkdir -p "$WAIT_FOR_DIR"
  args=("$service" --max-hours "$max_hours")
  [ -z "$key" ] || args+=(--key "$key")
  nohup "$0" "${args[@]}" </dev/null >>"$WAIT_FOR_DIR/$service.log" 2>&1 &
  echo $!
  disown 2>/dev/null || true
  exit 0
fi

mkdir -p "$WAIT_FOR_DIR"
if ! mkdir "$lock" 2>/dev/null; then
  held && exit 0
  rm -rf "$lock"
  mkdir "$lock" 2>/dev/null || exit 0
fi
echo $$ > "$lock/pid.tmp" && mv "$lock/pid.tmp" "$lock/pid"
trap 'rm -rf "$lock"' EXIT

friction() {
  command -v "$FRICTION" >/dev/null 2>&1 || return 0
  "$FRICTION" --source wait-for ${key:+--key "$key"} service_down "$1" || true
}
human() { local s=$1; if [ "$s" -ge 3600 ]; then echo "$((s / 3600))h$((s % 3600 / 60))m"; elif [ "$s" -ge 60 ]; then echo "$((s / 60))m"; else echo "${s}s"; fi; }

start=$($WAIT_FOR_NOW)
limit=$(awk -v h="$max_hours" 'BEGIN { printf "%d", h * 3600 }')
delay=30
while :; do
  if bash -c "$probe" >/dev/null 2>&1; then
    down=$(human $(( $($WAIT_FOR_NOW) - start )))
    "$DAY_NOTE" --kind service --session wait-for ${key:+"$key"} "$service is back"
    friction "$service was down for $down"
    exit 0
  fi
  elapsed=$(( $($WAIT_FOR_NOW) - start ))
  if [ "$elapsed" -ge "$limit" ]; then
    "$DAY_NOTE" --kind service --session wait-for ${key:+"$key"} "$service still down after ${max_hours}h — gave up" || true
    friction "$service still down after $(human "$elapsed"), gave up"
    echo "wait-for: $service still down after $(human "$elapsed"), gave up" >&2
    exit 1
  fi
  [ $((elapsed + delay)) -le "$limit" ] && nap=$delay || nap=$((limit - elapsed))
  $WAIT_FOR_SLEEP "$nap"
  delay=$((delay * 2 > 600 ? 600 : delay * 2))
done
