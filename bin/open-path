#!/usr/bin/env bash
#
# open-path — pick a file path out of a tmux pane and open it in your editor in
# a new tmux window. Bound to prefix-o by tmux/.tmux.conf.
#
# Vendored from whitel1ght/tmux-claude-picker's claude-open-path.sh (same token
# extraction, resolve and picker logic) with one addition: it reads the session
# transcripts of BOTH Claude Code (~/.claude/projects/<slug>/) and pi
# (~/.pi/agent/sessions/<slug>/), so prefix-o works in a pi pane too. The
# plugin's own copy stays Claude-only, which is why .tmux.conf rebinds o here.
#
# Exists because Claude Code and pi print paths to files they just created, and
# clicking one in Ghostty hands it to macOS `open` — which lands you in Finder.
# Ghostty has no "run a command on click" hook (its `link` option reports
# error.NotImplemented as of 1.3.1), so the click cannot be redirected without
# hijacking the system default handler for every text file. This is the keyboard
# route instead.
#
# Two sources are merged, because neither alone is enough:
#
#   1. The visible pane. Claude Code and pi — like any full-screen TUI — run on
#      the alternate screen, where tmux keeps NO scrollback (`history_size` is
#      2). capture-pane returns the visible rows and nothing more, whatever -S
#      you pass. So this source sees only what is on screen right now.
#
#   2. Session transcripts. Every path the agent wrote, read or printed is
#      recorded in its session jsonl, including ones that have scrolled away. A
#      pane cannot be mapped to an exact session id (the appends and closes, so
#      lsof shows no handle, and the id is not in the process environment), so
#      the project slug is derived from the pane's cwd and the most recently
#      modified transcripts there are read newest-first — with several sessions
#      open on one project, the freshest transcript is the one you are looking
#      at. Claude and pi share the slug convention (path with non-alphanumerics
#      replaced by '-'), so one derivation finds both.
#
# Ordering is the whole game: the visible pane comes first, then the newest
# transcript, then older ones. Candidates are filtered by whether they actually
# exist on disk, which is what keeps the list clean — no regex precision is
# needed, since anything that is not a real file simply drops out.
#
# Paths containing spaces are not detected. Finding where such a path ends in
# free-form text means guessing, and guessing wrong is worse than skipping.

set -uo pipefail

# Both rg calls below end in 2>/dev/null and this script deliberately runs
# without `set -e`, so a missing ripgrep would otherwise surface as an empty
# candidate list and a misleading "no paths found" — name the real problem.
missing=""
command -v rg  >/dev/null 2>&1 || missing="$missing ripgrep"
command -v fzf >/dev/null 2>&1 || missing="$missing fzf"
if [ -n "$missing" ]; then
    echo "open-path: missing required tool(s):$missing" >&2
    command -v tmux >/dev/null 2>&1 &&
        tmux display-message "open-path: missing required tool(s):$missing"
    exit 1
fi

list_only=0
if [ "${1:-}" = "--list" ]; then
    list_only=1
    shift
fi

pane="${1:-}"
if [ -z "$pane" ]; then
    echo "usage: open-path [--list] <pane-id>" >&2
    exit 2
fi

# How many recently-modified transcripts to read per project, how much of each,
# and how many candidates to hand the picker.
TRANSCRIPTS=3
TRANSCRIPT_BYTES=400000
MAX_TOKENS=8000
MAX_CANDIDATES=300

# Editor: @claude-picker-editor, else $EDITOR, else nvim.
EDITOR_CMD="$(tmux show-option -gqv '@claude-picker-editor')"
[ -n "$EDITOR_CMD" ] || EDITOR_CMD="${EDITOR:-nvim}"

# Two calls rather than one with a \t separator: tmux emits format escapes
# literally, so a combined lookup comes back unsplittable.
cwd="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
if [ -z "$cwd" ]; then
    echo "open-path: no such pane: $pane" >&2
    exit 1
fi
session="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)"

# Path-ish tokens. ':' is included so file:line references survive; resolve()
# peels the line number back off. Tokens without a '/' or '.' are dropped, which
# discards most ordinary prose before the (comparatively costly) disk check.
token_re='[A-Za-z0-9._~/+@:-]{2,}'

# stdin -> tokens, newest first. Reversal happens per source so that each
# source stays internally newest-first when they are concatenated.
tokens_newest_first() {
    rg -oN "$token_re" 2>/dev/null \
        | rg -N '[/.]' 2>/dev/null \
        | awk '{ a[NR] = $0 } END { for (i = NR; i > 0; i--) print a[i] }'
}

collect_tokens() {
    # What you were actually looking at.
    tmux capture-pane -p -J -t "$pane" 2>/dev/null | tokens_newest_first

    local slug f dir
    slug="$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')"

    # Claude Code and pi both keep per-project session transcripts as jsonl
    # under different roots, with the same slug. Read the newest few from each;
    # the disk check in resolve() drops anything that is not a real file, so
    # merging the two is safe.
    for dir in "$HOME/.claude/projects/$slug" "$HOME/.pi/agent/sessions/$slug"; do
        [ -d "$dir" ] || continue
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            tail -c "$TRANSCRIPT_BYTES" "$f" 2>/dev/null | tokens_newest_first
        done < <(ls -t "$dir"/*.jsonl 2>/dev/null | head -n "$TRANSCRIPTS")
    done
}

# One token -> "<path>\t<line>", or nothing if it is not a real file. Tries the
# token as-is, then as path:LINE / path:LINE:COL, then with trailing prose
# punctuation peeled off; `test -f` decides which reading was right.
resolve() {
    local tok="$1" cand line attempt

    for attempt in 1 2 3; do
        line=""
        case "$attempt" in
            1) cand="$tok" ;;
            2) if [[ "$tok" =~ ^(.+):([0-9]+):[0-9]+$ ]] || [[ "$tok" =~ ^(.+):([0-9]+)$ ]]; then
                   cand="${BASH_REMATCH[1]}"
                   line="${BASH_REMATCH[2]}"
               else
                   continue
               fi ;;
            3) cand="${tok%%[.,;:)\]\}]}"
               [ "$cand" = "$tok" ] && continue ;;
        esac

        [ -n "$cand" ] || continue
        case "$cand" in
            '~'/*) cand="$HOME/${cand#\~/}" ;;
            /*)    ;;
            *)     cand="$cwd/$cand" ;;
        esac

        # Collapse '/./' so that "./foo" and "foo" dedupe to one entry. Purely
        # textual — resolving symlinks would merge ~/.tmux.conf with the
        # dotfiles file it points at, and those are worth offering separately.
        cand="${cand//\/.\//\/}"

        if [ -f "$cand" ]; then
            printf '%s\t%s\n' "$cand" "$line"
            return 0
        fi
    done
    return 1
}

candidates="$(
    collect_tokens \
        | awk '!seen[$0]++' \
        | head -n "$MAX_TOKENS" \
        | while IFS= read -r tok; do resolve "$tok"; done \
        | awk -F'\t' '!seen[$1]++' \
        | head -n "$MAX_CANDIDATES"
)"

# --list prints what would be offered, without the picker. Useful when a path
# you expected is missing and you need to see whether extraction or the
# existence filter dropped it.
if [ "$list_only" = 1 ]; then
    [ -n "$candidates" ] && printf '%s\n' "$candidates"
    exit 0
fi

if [ -z "$candidates" ]; then
    tmux display-message "open-path: no existing file paths found in this pane"
    exit 0
fi

# Extract editor basename for the prompt (handle editors with arguments like 'code -w').
editor_name="$(basename "${EDITOR_CMD%% *}")"

# Display paths relative to the pane's cwd where possible: the interesting part
# of a long scratchpad path is its tail, and the full path pushes that off.
picked="$(
    printf '%s\n' "$candidates" \
        | awk -F'\t' -v cwd="$cwd/" -v home="$HOME/" '{
            disp = $1
            if (index(disp, cwd) == 1)       disp = substr(disp, length(cwd) + 1)
            else if (index(disp, home) == 1) disp = "~/" substr(disp, length(home) + 1)
            if ($2 != "") disp = disp ":" $2
            print disp "\t" $1 "\t" $2
          }' \
        | fzf --delimiter='\t' --with-nth=1 --scheme=path \
              --height=100% --layout=reverse --border=none \
              --prompt="open in $editor_name > " \
              --preview='sed -n 1,200p {2}' \
              --preview-window='down,60%,border-top'
)"

[ -n "$picked" ] || exit 0

file="$(printf '%s' "$picked" | cut -f2)"
line="$(printf '%s' "$picked" | cut -f3)"

# `+LINE` is understood by vi-likes, emacs and nano; for anything else the line
# number is dropped rather than passed to a program that would read `+123` as a
# filename.
case "$(basename "${EDITOR_CMD%% *}")" in
    nvim|vim|vi|view|emacs|emacsclient|nano) supports_line=1 ;;
    *) supports_line=0 ;;
esac

if [ -n "$line" ] && [ "$supports_line" = 1 ]; then
    cmd="$(printf '%q ' $EDITOR_CMD "+$line" "$file")"
else
    cmd="$(printf '%q ' $EDITOR_CMD "$file")"
fi

tmux new-window -t "$session" -c "$(dirname "$file")" -n "$(basename "$file")" "$cmd"
