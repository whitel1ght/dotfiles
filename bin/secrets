#!/usr/bin/env bash
# Edit the one place secrets live: ~/.secrets/secrets.env (tokens, KEY=value)
# and ~/.secrets/recovery.md (2FA codes, passwords to type by hand).
#
#   secrets            edit secrets.env
#   secrets recovery   edit recovery.md
#
# nvim runs without swap, undo or shada files, so no copy of a value lands in
# ~/.local/state where agents can read. Scripts read a value with `secret NAME`.
# After an edit, `~/wiki/vault-sync.sh` copies both files into the encrypted
# vault that iCloud backs up (vault-check reminds you when it is behind).
set -euo pipefail

DIR="${SECRETS_DIR:-$HOME/.secrets}"
case "${1:-}" in
    "") file="$DIR/secrets.env" ;;
    recovery) file="$DIR/recovery.md" ;;
    *) echo "usage: secrets [recovery]" >&2; exit 2 ;;
esac

mkdir -p "$DIR" && chmod 700 "$DIR"
[ -f "$file" ] || : > "$file"
chmod 600 "$file"
exec nvim -n -i NONE --cmd 'set noundofile nobackup nowritebackup' "$file"
