#!/usr/bin/env bash
# Fuzzy picker over today's plan: a ticket opens in `jt`, an MR opens in the browser.
#
#   plan-pick [--list]
#
# Rows (--list prints them, tab-separated kind<TAB>id<TAB>label<TAB>target), in plan order, each
# line's MRs after it: a `ticket` row for every top-level plan line with a ticket key, then the
# line's `mr` rows labelled `repo!iid (key)`. The key is the line's <!-- pN --> id, else its
# ticket key (a keyless pN line gets MR rows only). New-format day (the agent file
# $DIARY_DIR/.agent/<date>.md exists): the MRs are `day-agent mrs` rows for that key. Old format:
# they are the line's `[↗][label]` refs, resolved through the block's `[label]: url`
# definitions; definitions no line references come last, labelled without a key. Rows are
# de-duplicated by target. With no plan or no rows it prints "plan-pick: nothing to pick" on
# stderr and exits 0 without starting fzf.
# Picking a ticket replaces the picker with `jt KEY` (same tmux popup, jt's pager stays until q);
# picking an MR opens its url and exits; cancelling exits 0.
# DIARY_DIR (default ~/wiki/diary) and DAY_AGENT_DATE (default today) pick the plan.
# Tests and stubs: PLAN_PICK_FZF, PLAN_PICK_JT, PLAN_PICK_OPEN (default fzf, jt, open).
set -euo pipefail

DIARY_DIR="${DIARY_DIR:-$HOME/wiki/diary}"
DATE="${DAY_AGENT_DATE:-$(date +%F)}"
FZF="${PLAN_PICK_FZF:-fzf}"
JT="${PLAN_PICK_JT:-jt}"
OPEN="${PLAN_PICK_OPEN:-open}"
T=$'\t'

list=0
case "${1:-}" in
  -h|--help) sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
  --list) list=1 ;;
  "") ;;
  *) echo "plan-pick: unknown option $1" >&2; exit 2 ;;
esac

file="$DIARY_DIR/$DATE.md"
block=""
if [ -f "$file" ]; then
  block=$(awk '/<!-- start-day:start -->/{on=1;next} /<!-- start-day:end -->/{on=0} on' "$file")
fi

agent_rows=""
if [ -f "$DIARY_DIR/.agent/$DATE.md" ]; then
  agent_rows=$(DIARY_DIR="$DIARY_DIR" DAY_AGENT_DATE="$DATE" "$(dirname "$0")/day-agent" mrs 2>/dev/null || true)
fi

rows=""
seen=$'\n'
# add <kind> <id> <label> <target>: append a row unless its target is already there
add() {
  case "$seen" in *$'\n'"$4"$'\n'*) return 0 ;; esac
  seen="$seen$4"$'\n'
  rows="$rows$1$T$2$T$3$T$4"$'\n'
}

re_item='^-[[:space:]]\[([ xX/!>])\][[:space:]](.*)$'
re_id='<!--[[:space:]](p[0-9]+)[[:space:]]-->[[:space:]]*$'
re_key='(^|[^A-Za-z0-9])([A-Za-z]{2,10}-[0-9]{2,6})([^0-9]|$)'
re_def='^\[([^]]+)\]:[[:space:]]*([^[:space:]]+)'

# definitions: label<TAB>url lines, and the labels no plan line referenced
defs=""
while IFS= read -r line; do
  if [[ $line =~ $re_def ]]; then defs="$defs${BASH_REMATCH[1]}$T${BASH_REMATCH[2]}"$'\n'; fi
done <<<"$block"
used=$'\n'

while IFS= read -r line; do
  [[ $line =~ $re_item ]] || continue
  text="${BASH_REMATCH[2]}"
  tkey=""
  if [[ $text =~ $re_key ]]; then tkey=$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:lower:]' '[:upper:]'); fi
  if [[ $text =~ $re_id ]]; then key="${BASH_REMATCH[1]}"; else key=$(printf '%s' "$tkey" | tr 'A-Z' 'a-z'); fi
  suffix=""; [ -z "$key" ] || suffix=" ($key)"
  if [ -n "$tkey" ]; then
    label="${text%% · *}"
    label="${label%%  \[↗\]*}"
    label=$(printf '%s' "$label" | sed -E 's/[[:space:]]*<!--[[:space:]]p[0-9]+[[:space:]]-->[[:space:]]*$//')
    add ticket "$(printf '%s' "$tkey" | tr 'A-Z' 'a-z')" "$label" "$tkey"
  fi
  if [ -n "$agent_rows" ]; then
    if [ -n "$key" ]; then
      while IFS="$T" read -r k ref url; do
        [ "$k" = "$key" ] || continue
        add mr "$ref" "$ref$suffix" "$url"
      done <<<"$agent_rows"
    fi
  else
    refs=$(printf '%s\n' "$text" | grep -oE '\[↗\]\[[^]]+\]' | sed -E 's/^\[↗\]\[(.*)\]$/\1/' || true)
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      used="$used$ref"$'\n'
      url=$(awk -F'\t' -v r="$ref" '$1 == r { print $2; exit }' <<<"$defs")
      [ -z "$url" ] || add mr "$ref" "$ref$suffix" "$url"
    done <<<"$refs"
  fi
done <<<"$block"

if [ -z "$agent_rows" ]; then
  while IFS="$T" read -r ref url; do
    [ -n "$ref" ] || continue
    case "$used" in *$'\n'"$ref"$'\n'*) continue ;; esac
    add mr "$ref" "$ref" "$url"
  done <<<"$defs"
fi

if [ -z "$rows" ]; then
  echo "plan-pick: nothing to pick" >&2
  exit 0
fi

if [ "$list" = 1 ]; then
  printf '%s' "$rows"
  exit 0
fi

rc=0
pick=$(printf '%s' "$rows" | $FZF --with-nth=3 --delimiter='\t') || rc=$?
[ "$rc" = 0 ] && [ -n "$pick" ] || exit 0

kind="${pick%%$T*}"
target="${pick##*$T}"
case "$kind" in
  ticket) exec $JT "$target" ;;
  mr) $OPEN "$target" ;;
esac
