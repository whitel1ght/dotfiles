#!/usr/bin/env bash
# Keep ~/wiki backed up in its git repo on the VPS. Replaces the old rsync
# `notes push/pull`.
#
#   wiki-sync           commit whatever changed, rebase onto the VPS copy, push
#   wiki-sync status    last good sync, pending changes, ahead/behind, last error
#   wiki-sync check     one warning line at shell start when a sync failed or
#                       none succeeded for a day; silent otherwise
#
# A LaunchAgent (macos/local.wiki-sync.plist) runs it every 15 minutes and
# /end-day runs it after its own commit, so nothing has to be remembered.
#
# It never leaves the repo half-way: a rebase that conflicts is aborted, the
# local commit stays, and the reason lands in $WIKI_SYNC_STATE/failed for
# `check` to report. Fix it by hand (git -C ~/wiki pull --rebase), then run
# wiki-sync again. A run that finds another one in progress, or git busy,
# skips quietly; the next run picks the changes up.
#
# Env: WIKI_DIR (default ~/wiki), WIKI_SYNC_STATE (default
# ~/.local/state/wiki-sync), WIKI_SYNC_NAME (default wiki: the name in check's
# warnings). The same script backs up ~/artifacts with its own agent and state
# (install.sh sets the three for it).
set -uo pipefail

WIKI="${WIKI_DIR:-$HOME/wiki}"
STATE="${WIKI_SYNC_STATE:-$HOME/.local/state/wiki-sync}"
NAME="${WIKI_SYNC_NAME:-wiki}"
LOCK="$STATE/lock"
STALE_LOCK_MIN=30

g() { git -C "$WIKI" "$@"; }

failed() {
    mkdir -p "$STATE"
    printf '%s %s\n' "$(date '+%F %H:%M')" "$*" > "$STATE/failed"
    echo "wiki-sync: $*" >&2
    exit 1
}

sync() {
    [ -d "$WIKI/.git" ] || failed "$WIKI is not a git repo"
    g remote get-url origin >/dev/null 2>&1 || failed "no 'origin' remote in $WIKI"

    mkdir -p "$STATE"
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +"$STALE_LOCK_MIN" 2>/dev/null)" ]; then
        rmdir "$LOCK" 2>/dev/null
    fi
    mkdir "$LOCK" 2>/dev/null || exit 0
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT

    [ -f "$WIKI/.git/index.lock" ] && exit 0
    if [ -d "$WIKI/.git/rebase-merge" ] || [ -d "$WIKI/.git/rebase-apply" ] || [ -f "$WIKI/.git/MERGE_HEAD" ]; then
        failed "a rebase or merge is in progress in $WIKI; finish it, then run wiki-sync"
    fi

    local branch err n
    branch="$(g branch --show-current)"
    [ -n "$branch" ] || failed "$WIKI is on a detached HEAD"

    if [ -n "$(g status --porcelain)" ]; then
        g add -A || failed "git add failed"
        n="$(g diff --cached --name-only | wc -l | tr -d ' ')"
        err="$(g commit -q -m "autosync: $n file(s) from $(scutil --get LocalHostName 2>/dev/null || hostname -s)" 2>&1)" \
            || failed "commit failed: $err"
    fi

    err="$(g fetch -q origin 2>&1)" || failed "fetch failed: $err"
    if g rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
        if ! err="$(g rebase -q "origin/$branch" 2>&1)"; then
            g rebase --abort >/dev/null 2>&1
            failed "the VPS copy and this one changed the same lines; resolve with: git -C $WIKI pull --rebase"
        fi
    fi
    err="$(g push -q origin "HEAD:$branch" 2>&1)" || failed "push failed: $err"

    rm -f "$STATE/failed"
    date '+%F %H:%M' > "$STATE/last-ok"
}

check() {
    if [ -s "$STATE/failed" ]; then
        printf '\033[1;33m⚠ %s sync failed:\033[0m %s\n' "$NAME" "$(cut -d' ' -f3- "$STATE/failed")"
        printf '  details: \033[1mwiki-sync status\033[0m\n'
    elif [ -f "$STATE/last-ok" ] && [ -n "$(find "$STATE/last-ok" -mmin +1440 2>/dev/null)" ]; then
        printf '\033[1;33m⚠ %s not backed up since %s\033[0m (is its sync agent loaded? run: wiki-sync)\n' \
            "$NAME" "$(cat "$STATE/last-ok")"
    fi
    return 0
}

status() {
    echo "last good sync: $(cat "$STATE/last-ok" 2>/dev/null || echo never)"
    [ -s "$STATE/failed" ] && echo "last failure:   $(cat "$STATE/failed")"
    [ -d "$WIKI/.git" ] || return 0
    echo "pending files:  $(g status --porcelain | wc -l | tr -d ' ')"
    local branch; branch="$(g branch --show-current)"
    if g rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
        echo "ahead/behind:   $(g rev-list --left-right --count "HEAD...origin/$branch" | tr '\t' '/') (as of the last fetch)"
    fi
    echo "remote:         $(g remote get-url origin 2>/dev/null || echo none)"
}

case "${1:-sync}" in
    sync) sync ;;
    check) check ;;
    status) status ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "usage: wiki-sync [status|check]" >&2; exit 2 ;;
esac
