#!/usr/bin/env bash
# Remove worktrees whose work is finished: merged or closed MRs, reviews of them.
#
#   clean-worktrees        clean <projects>/worktrees/<repo>/<name>
#   clean-worktrees -n     dry run, print what would go
#
# "Merged" is asked of GitLab, not git: MRs are squash-merged, so the branch is
# never an ancestor of master and `git branch --merged` would miss every one.
#
# Removed, with the local branch when there is one:
#   - a branch whose latest MR is merged, when HEAD is the commit the MR merged,
#     an ancestor of it, or on a remote (no local-only commit is lost)
#   - a branch whose latest MR is closed, when HEAD is on a remote
#   - a branch of a repo not on GitLab (dotfiles is on GitHub) once it is merged
#     into the local default branch
#   - a review worktree (detached HEAD, named review-<iid> or <...>-review-<iid>)
#     once that MR is merged or closed: its HEAD is the MR's head, never ours
#   - a leftover directory git doesn't know that holds only a .vite cache
# In every case the tree must be clean. Files the tools regenerate on their own
# (GENERATED below) and ignored files don't count as changes.
# Anything else is reported and left alone: open MRs, no MR, other detached
# HEADs, worktrees on the default branch, other unknown directories.
# Stale worktree entries whose directory is already gone are pruned.
#
# A worktree it keeps loses its Gradle build output when no file in it changed
# for CLEAN_BUILD_IDLE_DAYS (14) days: each `build` directory that git ignores
# and that sits next to a build.gradle(.kts). Gradle rebuilds it on the next
# run; an ecfx-backend worktree carries 0.1-1.7 GB of it.
set -euo pipefail

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"
WORKTREES_DIR="${WORKTREES_DIR:-$PROJECTS_DIR/worktrees}"
BUILD_IDLE_DAYS="${CLEAN_BUILD_IDLE_DAYS:-14}"
# vite's auto-import plugins rewrite these in every dashboard worktree that runs; pi keeps sessions in .pi/
GENERATED=(':(exclude)src/components.d.ts' ':(exclude)src/typed-router.d.ts' ':(exclude).pi')

dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "clean-worktrees: unknown option $1" >&2; exit 1 ;;
  esac
  shift
done

[ -d "$WORKTREES_DIR" ] || { echo "clean-worktrees: no $WORKTREES_DIR" >&2; exit 1; }

removed=0 kept=0 failed=0
repos=""
keep() { echo "  keep    $1 — $2"; kept=$((kept + 1)); }
is_dirty() { [ -n "$(git -C "$1" status --porcelain -- . "${GENERATED[@]}")" ]; }
on_remote() { [ -z "$(git -C "$1" rev-list -1 HEAD --not --remotes)" ]; }

# remove <wt> <name> <main> <why> [branch]
remove() {
  if [ "$dry" -eq 1 ]; then
    echo "  would   remove $2 ($4)"; removed=$((removed + 1)); return
  fi
  # --force because git refuses worktrees with submodules or regenerated files; real changes were checked.
  if git -C "$3" worktree remove --force "$1" && { [ -z "${5:-}" ] || git -C "$3" branch -D -q "$5"; }; then
    echo "  removed $2 ($4)"; removed=$((removed + 1))
  else
    failed=$((failed + 1))
  fi
}

# mr_api <wt> <path after projects/<id>/>: GitLab JSON for the worktree's project
mr_api() {
  local project
  project=$(git -C "$1" remote get-url origin | sed -E 's#^(https?://[^/]+/|git@[^:]+:)##; s#\.git$##')
  glab api "projects/$(jq -rn --arg p "$project" '$p | @uri')/$2" 2>/dev/null
}

for wt in "$WORKTREES_DIR"/*/*/; do
  [ -d "$wt" ] || continue
  wt="${wt%/}"; name="${wt#"$WORKTREES_DIR"/}"

  if [ ! -e "$wt/.git" ] || ! main=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    if [ -d "$wt/.vite" ] && [ -z "$(ls -A "$wt" | grep -vx '.vite')" ]; then
      if [ "$dry" -eq 1 ]; then echo "  would   remove $name (only a .vite cache)"; else rm -rf "$wt" && echo "  removed $name (only a .vite cache)"; fi
      removed=$((removed + 1))
    else
      keep "$name" "not a git worktree"
    fi
    continue
  fi
  main="${main%/.git}"
  case $'\n'"$repos"$'\n' in *$'\n'"$main"$'\n'*) ;; *) repos="$repos${repos:+$'\n'}$main" ;; esac

  branch=$(git -C "$wt" branch --show-current)
  if [ -z "$branch" ]; then
    iid=$(sed -nE 's/^(.*-)?review-([0-9]+)$/\2/p' <<<"${name#*/}")
    [ -n "$iid" ] || { keep "$name" "detached HEAD"; continue; }
    state=$(mr_api "$wt" "merge_requests/$iid" | jq -r '.state // empty' 2>/dev/null) || state=""
    [ -n "$state" ] || { keep "$name" "GitLab lookup failed for !$iid"; failed=$((failed + 1)); continue; }
    case "$state" in merged|closed) ;; *) keep "$name" "review of !$iid, which is $state"; continue ;; esac
    ! is_dirty "$wt" || { keep "$name" "review of !$iid ($state), but has uncommitted changes"; continue; }
    remove "$wt" "$name" "$main" "review of !$iid, $state"
    continue
  fi

  default=$(git -C "$wt" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) \
    || { git -C "$wt" show-ref -q --verify refs/heads/main && default=origin/main; } || default=origin/master
  default="${default#origin/}"
  [ "$branch" != "$default" ] || { keep "$name" "on $branch"; continue; }

  case "$(git -C "$wt" remote get-url origin 2>/dev/null)" in
    *gitlab.com*) ;;
    *)
      git -C "$wt" merge-base --is-ancestor HEAD "refs/heads/$default" 2>/dev/null || { keep "$name" "not merged into $default"; continue; }
      ! is_dirty "$wt" || { keep "$name" "merged into $default, but has uncommitted changes"; continue; }
      remove "$wt" "$name" "$main" "merged into $default, branch $branch" "$branch"
      continue
      ;;
  esac

  mr=$(mr_api "$wt" "merge_requests?source_branch=$(jq -rn --arg b "$branch" '$b | @uri')&state=all" \
    | jq -c 'sort_by(.updated_at) | last // empty' 2>/dev/null) || { keep "$name" "GitLab lookup failed"; failed=$((failed + 1)); continue; }
  [ -n "$mr" ] || { keep "$name" "no MR for $branch"; continue; }
  state=$(jq -r .state <<<"$mr"); ref="!$(jq -r .iid <<<"$mr")"
  case "$state" in merged|closed) ;; *) keep "$name" "$ref is $state"; continue ;; esac

  ! is_dirty "$wt" || { keep "$name" "$ref $state, but has uncommitted changes"; continue; }

  if [ "$state" = closed ]; then
    on_remote "$wt" || { keep "$name" "$ref closed, but has commits that exist nowhere else"; continue; }
  else
    head=$(git -C "$wt" rev-parse HEAD); merged_sha=$(jq -r .sha <<<"$mr")
    if [ "$head" != "$merged_sha" ] \
      && ! git -C "$wt" merge-base --is-ancestor "$head" "$merged_sha" 2>/dev/null \
      && ! on_remote "$wt"; then
      keep "$name" "$ref merged, but has commits made after it that exist nowhere else"; continue
    fi
  fi
  remove "$wt" "$name" "$main" "$ref $state, branch $branch" "$branch"
done

gb() { awk -v k="$1" 'BEGIN { printf "%.1f GB", k / 1048576 }'; }

# Gradle build output of the worktrees still here, when nothing in them changed for BUILD_IDLE_DAYS.
trimmed=0 trimmed_kb=0
for wt in "$WORKTREES_DIR"/*/*/; do
  wt="${wt%/}"; name="${wt#"$WORKTREES_DIR"/}"
  [ -e "$wt/.git" ] || continue
  [ -z "$(find "$wt" \( -name node_modules -o -name .git \) -prune -o -type f -mtime "-$BUILD_IDLE_DAYS" -print -quit 2>/dev/null)" ] || continue
  dirs=()
  while IFS= read -r d; do
    { [ -f "${d%/build}/build.gradle" ] || [ -f "${d%/build}/build.gradle.kts" ]; } || continue
    git -C "$wt" check-ignore -q "$d" || continue
    [ -z "$(git -C "$wt" ls-files -- "$d" | head -1)" ] || continue
    dirs+=("$d")
  done < <(find "$wt" \( -name node_modules -o -name .git \) -prune -o -type d -name build -prune -print 2>/dev/null)
  [ "${#dirs[@]}" -gt 0 ] || continue
  kb=$(du -sk "${dirs[@]}" | awk '{ s += $1 } END { print s + 0 }')
  if [ "$dry" -eq 1 ]; then
    echo "  would   trim $name (Gradle build output, $(gb "$kb"); nothing changed in $BUILD_IDLE_DAYS+ days)"
  else
    rm -rf "${dirs[@]}"
    echo "  trimmed $name (Gradle build output, $(gb "$kb"); nothing changed in $BUILD_IDLE_DAYS+ days)"
  fi
  trimmed=$((trimmed + 1)); trimmed_kb=$((trimmed_kb + kb))
done

if [ "$dry" -eq 0 ]; then
  while IFS= read -r main; do
    [ -n "$main" ] && git -C "$main" worktree prune
  done <<<"$repos"
  find "$WORKTREES_DIR" -mindepth 1 -maxdepth 1 -type d -empty -delete
fi

echo "$removed removed, $kept kept, $failed failed$([ "$trimmed" -gt 0 ] && echo ", build output trimmed in $trimmed ($(gb "$trimmed_kb"))")$([ "$dry" -eq 1 ] && echo ' (dry run)')"
[ "$failed" -eq 0 ]
