#!/usr/bin/env bash
# Move my Jira tickets to match the state of my GitLab MRs.
#
#   sync-tickets              MRs updated since the last run (since midnight on the first)
#   sync-tickets --since 3d   override the window: Nd, Nh, or an ISO-8601 timestamp
#   sync-tickets -n           dry run, print what would change
#   sync-tickets -v           also print tickets skipped and why
#
# Each ticket is judged on ALL of its MRs, across every repo, found by the key in
# the branch name (title as fallback): any open ready MR → In MR; otherwise any
# open draft → In Progress; otherwise merged → In QA. Closed MRs don't count.
#
# Changes only go forward (To-Do → In Progress → In MR → In QA), because they are
# applied unattended: a draft follow-up must not pull a ticket back out of QA.
# A ticket behind its MRs is reported, never moved back. Tickets assigned to
# someone else, or in any other status (Rejected Incomplete, Awaiting Details,
# Done, Closed), are left alone.
#
# Every MR is also linked on its ticket with the same globalId GitLab's own
# integration uses, so a link that already exists is updated, not duplicated.
#
# Needs JIRA_EMAIL and JIRA_API_TOKEN (~/.config/mrglass/secrets.env) and glab.
set -euo pipefail

JIRA_BASE="${JIRA_BASE:-https://ecfxdev.atlassian.net}"
JIRA_PROJECT="${JIRA_PROJECT:-ECFX}"
STATE_FILE="${SYNC_TICKETS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/sync-tickets/last-run}"

dry=0 verbose=0 since=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -v|--verbose) verbose=1 ;;
    --since) shift; since="${1:-}"; [ -n "$since" ] || { echo "sync-tickets: --since needs a value" >&2; exit 1; } ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "sync-tickets: unknown option $1" >&2; exit 1 ;;
  esac
  shift
done

: "${JIRA_EMAIL:?sync-tickets: JIRA_EMAIL unset — see ~/.config/mrglass/secrets.env}"
: "${JIRA_API_TOKEN:?sync-tickets: JIRA_API_TOKEN unset — see ~/.config/mrglass/secrets.env}"

iso() { date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }

now=$(date +%s)
started="$(iso "$now")"
case "$since" in
  "")
    if [ -s "$STATE_FILE" ]; then since="$(cat "$STATE_FILE")"
    else since="$(iso $((now - 10#$(date +%H) * 3600 - 10#$(date +%M) * 60 - 10#$(date +%S))))"; fi ;;
  *[0-9]d) since="$(iso $((now - ${since%d} * 86400)))" ;;
  *[0-9]h) since="$(iso $((now - ${since%h} * 3600)))" ;;
esac

# Prints the body; fails with the HTTP status so an expired token reads as one.
jira() {
  local method="$1" path="$2" out code
  local data=()
  [ -z "${3:-}" ] || data=(--data "$3")
  out=$(curl -sS -X "$method" -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
    -H 'Accept: application/json' -H 'Content-Type: application/json' \
    ${data[@]+"${data[@]}"} -w '\n%{http_code}' "$JIRA_BASE$path")
  code="${out##*$'\n'}"
  case "$code" in
    2*) printf '%s' "${out%$'\n'*}" ;;
    401|403) echo "sync-tickets: Jira returned $code — JIRA_API_TOKEN has likely expired" >&2; return 1 ;;
    *) echo "sync-tickets: Jira $method $path returned $code" >&2; return 1 ;;
  esac
}

me=$(jira GET /rest/api/3/myself | jq -r .accountId)

recent=$(glab api --paginate "merge_requests?scope=created_by_me&state=all&updated_after=$since&per_page=100" | jq -s 'add // []')
open=$(glab api --paginate "merge_requests?scope=created_by_me&state=opened&per_page=100" | jq -s 'add // []')

# One line per ticket touched in the window: key, target status, its MRs as JSON.
plan=$(jq -rn --argjson recent "$recent" --argjson open "$open" --arg p "$JIRA_PROJECT" '
  def key: first((.source_branch, .title) | scan("\($p)-[0-9]+")) // null;
  ([$recent[] | key] | map(select(. != null)) | unique) as $touched
  | ($recent + $open | unique_by(.id) | map(select(.state == "opened" or .state == "merged"))
     | map(. + {key: key}) | map(select(.key != null))) as $mrs
  | $touched[] as $k
  | [$mrs[] | select(.key == $k)] as $m
  | select($m | length > 0)
  | (if any($m[]; .state == "opened" and (.draft | not)) then "In MR"
     elif any($m[]; .state == "opened") then "In Progress"
     else "In QA" end) as $target
  | [$k, $target, ($m | map({url: .web_url, ref: .references.full, title}) | tojson)] | @tsv')

rank() {
  case "$1" in
    To-Do) echo 0 ;; "In Progress") echo 1 ;; "In MR") echo 2 ;; "In QA") echo 3 ;; *) echo -1 ;;
  esac
}

# In MR is only reachable from In Progress, so a To-Do ticket takes two steps.
transition_to() {
  local key="$1" target="$2" step id
  for step in 1 2 3; do
    [ "$(jira GET "/rest/api/3/issue/$key?fields=status" | jq -r .fields.status.name)" = "$target" ] && return 0
    id=$(jira GET "/rest/api/3/issue/$key/transitions" \
      | jq -r --arg t "$target" '.transitions as $all
          | (($all | map(select(.to.name == $t)) | first) // ($all | map(select(.to.name == "In Progress")) | first))
          | .id // empty')
    [ -n "$id" ] || { echo "sync-tickets: no transition from $key towards $target" >&2; return 1; }
    jira POST "/rest/api/3/issue/$key/transitions" "{\"transition\":{\"id\":\"$id\"}}" >/dev/null || return 1
  done
  return 1
}

moved=0 linked=0 behind=0 skipped=0 failed=0
while IFS=$'\t' read -r key target mrs; do
  [ -n "${key:-}" ] || continue
  refs=$(jq -r 'map(.ref | sub("^.*/"; "")) | join(", ")' <<<"$mrs")
  issue=$(jira GET "/rest/api/3/issue/$key?fields=status,assignee") || { failed=$((failed + 1)); continue; }
  status=$(jq -r .fields.status.name <<<"$issue")
  assignee=$(jq -r '.fields.assignee.accountId // ""' <<<"$issue")

  if [ "$assignee" != "$me" ]; then
    skipped=$((skipped + 1)); [ "$verbose" -eq 1 ] && echo "  skip   $key — assigned to $(jq -r '.fields.assignee.displayName // "nobody"' <<<"$issue")"
    continue
  fi
  if [ "$(rank "$status")" -lt 0 ]; then
    skipped=$((skipped + 1)); [ "$verbose" -eq 1 ] && echo "  skip   $key — $status is left alone"
    continue
  fi

  if [ "$(rank "$target")" -gt "$(rank "$status")" ]; then
    if [ "$dry" -eq 1 ]; then echo "  would  $key $status → $target ($refs)"; moved=$((moved + 1))
    elif transition_to "$key" "$target"; then echo "  moved  $key $status → $target ($refs)"; moved=$((moved + 1))
    else failed=$((failed + 1)); fi
  elif [ "$(rank "$target")" -lt "$(rank "$status")" ]; then
    echo "  behind $key is $status, MRs say $target ($refs) — left alone"; behind=$((behind + 1))
  fi

  existing=$(jira GET "/rest/api/3/issue/$key/remotelink" | jq -c '[.[].object.url]') || { failed=$((failed + 1)); continue; }
  while IFS=$'\t' read -r url ref title; do
    jq -e --arg u "$url" 'index($u)' <<<"$existing" >/dev/null && continue
    repo="${ref%%!*}"; repo="${repo##*/}"; iid="${ref##*!}"
    if [ "$dry" -eq 1 ]; then echo "  would  link $key ← $repo!$iid"; linked=$((linked + 1)); continue; fi
    link=$(jq -cn --arg g "gitlab-mr-$repo-$iid" --arg u "$url" --arg t "$repo!$iid — $title" '{
      globalId: $g, relationship: "merge request",
      application: {type: "com.gitlab", name: "GitLab"},
      object: {url: $u, title: $t, icon: {url16x16: "https://gitlab.com/favicon.ico", title: "GitLab"}}}')
    if jira POST "/rest/api/3/issue/$key/remotelink" "$link" >/dev/null; then
      echo "  linked $key ← $repo!$iid"; linked=$((linked + 1))
    else failed=$((failed + 1)); fi
  done < <(jq -r '.[] | [.url, .ref, .title] | @tsv' <<<"$mrs")
done <<<"$plan"

echo "since $since: $moved moved, $linked linked, $behind behind, $skipped skipped, $failed failed$([ "$dry" -eq 1 ] && echo ' (dry run)')"

if [ "$dry" -eq 0 ] && [ "$failed" -eq 0 ]; then
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$started" > "$STATE_FILE"
fi
[ "$failed" -eq 0 ]
