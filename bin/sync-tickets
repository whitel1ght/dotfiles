#!/usr/bin/env bash
# Verify my Jira tickets against my GitLab MRs and worktrees, and move the ones behind.
#
# The day session moves each ticket itself as its work starts (wt add), its MR goes ready
# (mr-ship) and merges (run-day), all through bin/ticket-move. This runs at start-day and
# end-day as the check on that: whatever it still has to move is printed as drift.
#
#   sync-tickets              MRs updated since the last run (since midnight on the first)
#   sync-tickets --since 3d   override the window: Nd, Nh, or an ISO-8601 timestamp
#   sync-tickets -n           dry run, print what would change
#   sync-tickets -v           also print tickets skipped and why
#
# Each ticket is judged on ALL of its MRs, across every repo, found by the key in
# the branch name (title as fallback): any open ready MR → In MR; otherwise any
# open draft → In Progress; otherwise merged → Ready for QA (not In QA: QA
# has not started, and they move it on themselves). Closed MRs don't count.
#
# Changes only go forward (To-Do → In Progress → In MR → Ready for QA)
# because they are applied unattended: a draft follow-up must not pull a ticket back out
# of QA.
# A ticket merged and already In QA is in step: nothing moved, nothing printed. A ticket
# behind its MRs is reported, never moved back. Tickets assigned to
# someone else, or in any other status (Rejected Incomplete, Awaiting Details,
# Done, Closed), are left alone.
#
# A Bug whose MRs all merged is not moved to Ready for QA while its Resolution Summary
# (customfield_10604) is empty: Jira refuses that move with HTTP 400. It is counted as
# needs_summary and listed, so the session can draft the summary and move it with
# `jira-write --resolution-summary`.
#
# Every MR is also linked on its ticket with the same globalId GitLab's own
# integration uses, so a link that already exists is updated, not duplicated.
#
# Needs JIRA_USER and JIRA_TOKEN in ~/.secrets/secrets.env (or JIRA_EMAIL and
# JIRA_API_TOKEN in the environment) and glab.
set -euo pipefail

JIRA_BASE="${JIRA_BASE:-https://ecfxdev.atlassian.net}"
JIRA_PROJECT="${JIRA_PROJECT:-ECFX}"
STATE_FILE="${SYNC_TICKETS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/sync-tickets/last-run}"

dry=0 verbose=0 since=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -v|--verbose) verbose=1 ;;
    --since) shift; since="${1:-}"; [ -n "$since" ] || { echo "sync-tickets: --since needs a value" >&2; exit 1; } ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "sync-tickets: unknown option $1" >&2; exit 1 ;;
  esac
  shift
done

: "${JIRA_EMAIL:=$(secret JIRA_USER 2>/dev/null)}" "${JIRA_API_TOKEN:=$(secret JIRA_TOKEN 2>/dev/null)}"
: "${JIRA_EMAIL:?sync-tickets: JIRA_USER missing — add it with \`secrets\`}"
: "${JIRA_API_TOKEN:?sync-tickets: JIRA_TOKEN missing — add it with \`secrets\`}"

iso() { date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }

now=$(date +%s)
started="$(iso "$now")"
case "$since" in
  "")
    if [ -s "$STATE_FILE" ]; then since="$(cat "$STATE_FILE")"
    else since="$(iso $((now - 10#$(date +%H) * 3600 - 10#$(date +%M) * 60 - 10#$(date +%S))))"; fi ;;
  *[0-9]d) since="$(iso $((now - ${since%d} * 86400)))" ;;
  *[0-9]h) since="$(iso $((now - ${since%h} * 3600)))" ;;
esac

# Prints the body; fails with the HTTP status so an expired token reads as one.
jira() {
  local method="$1" path="$2" out code
  local data=()
  [ -z "${3:-}" ] || data=(--data "$3")
  out=$(curl -sS -X "$method" -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
    -H 'Accept: application/json' -H 'Content-Type: application/json' \
    ${data[@]+"${data[@]}"} -w '\n%{http_code}' "$JIRA_BASE$path")
  code="${out##*$'\n'}"
  case "$code" in
    2*) printf '%s' "${out%$'\n'*}" ;;
    401|403) echo "sync-tickets: Jira returned $code — JIRA_TOKEN has likely expired" >&2; return 1 ;;
    *) echo "sync-tickets: Jira $method $path returned $code" >&2; return 1 ;;
  esac
}

me=$(jira GET /rest/api/3/myself | jq -r .accountId)

recent=$(glab api --paginate "merge_requests?scope=created_by_me&state=all&updated_after=$since&per_page=100" | jq -s 'add // []')
open=$(glab api --paginate "merge_requests?scope=created_by_me&state=opened&per_page=100" | jq -s 'add // []')

# One line per ticket touched in the window: key, target status, its MRs as JSON.
#
# WHY NOT @tsv, which reads more naturally here. It was @tsv until a title containing a
# double quote (ECFX-17417: 'ECFX-17417: "Retrieve again" row action') took the whole run
# down with "jq: parse error: Invalid numeric literal": @tsv escapes the backslash that
# tojson had just put there, so the field read back as \" instead of " and stopped being
# valid JSON. A title with a real tab or newline shifts every later field the same way.
# The failure is not loud — the script dies mid-loop, after it has already moved tickets
# and posted links, so the next run re-does the window with a half-applied state behind it.
#
# The MR list is base64'd as one field; key and target stay plain text because neither can
# contain a tab (a Jira key is KEY-nnn, a status is a fixed word). base64 is the one encoding
# nothing in a title can corrupt.
plan=$(jq -rn --argjson recent "$recent" --argjson open "$open" --arg p "$JIRA_PROJECT" '
  def key: first((.source_branch, .title) | scan("\($p)-[0-9]+")) // null;
  ([$recent[] | key] | map(select(. != null)) | unique) as $touched
  | ($recent + $open | unique_by(.id) | map(select(.state == "opened" or .state == "merged"))
     | map(. + {key: key}) | map(select(.key != null))) as $mrs
  | $touched[] as $k
  | [$mrs[] | select(.key == $k)] as $m
  | select($m | length > 0)
  | (if any($m[]; .state == "opened" and (.draft | not)) then "In MR"
     elif any($m[]; .state == "opened") then "In Progress"
     else "Ready for QA" end) as $target
  | [$k, $target, ($m | map({url: .web_url, ref: .references.full, title}) | tojson | @base64)] | @tsv')

TICKET_MOVE="${TICKET_MOVE:-$(dirname "$0")/ticket-move}"
WORKTREES_DIR="${WORKTREES_DIR:-${PROJECTS_DIR:-$HOME/projects}/worktrees}"
export JIRA_EMAIL JIRA_API_TOKEN

moved=0 linked=0 behind=0 skipped=0 needs_summary=0 failed=0
needs_keys=() drift_keys=() seen=" "

# One ticket through ticket-move, where the rules live (the day's own moves use it too),
# counting what it says. Whatever it moves now is a move the day missed.
move() { # key target [refs the target was judged from]
  local out rc=0 args=("$1" "$2" -v --by sync-tickets)
  [ -z "${3:-}" ] || args+=(--judged "$3")
  [ "$dry" -eq 0 ] || args+=(-n)
  out=$("$TICKET_MOVE" "${args[@]}") || rc=$?
  case "$rc:$out" in
    3:*) needs_summary=$((needs_summary + 1)); needs_keys+=("$1"); [ "$verbose" -eq 0 ] || echo "$out" ;;
    "0:  moved"*|"0:  would"*) echo "$out"; moved=$((moved + 1)); drift_keys+=("$1") ;;
    "0:  behind"*) echo "$out"; behind=$((behind + 1)) ;;
    "0:  skip"*) skipped=$((skipped + 1)); [ "$verbose" -eq 0 ] || echo "$out" ;;
    0:*) [ "$verbose" -eq 0 ] || [ -z "$out" ] || echo "$out" ;;
    *) failed=$((failed + 1)); [ -z "$out" ] || echo "$out" ;;
  esac
}

while IFS=$'\t' read -r key target mrs_b64; do
  [ -n "${key:-}" ] || continue
  seen="$seen$key "
  mrs=$(base64 -d <<<"$mrs_b64")
  refs=$(jq -r 'map(.ref | sub("^.*/"; "")) | join(", ")' <<<"$mrs")
  move "$key" "$target" "$refs"

  existing=$(jira GET "/rest/api/3/issue/$key/remotelink" | jq -c '[.[].object.url]') || { failed=$((failed + 1)); continue; }
  while IFS= read -r mr; do
    url=$(jq -r .url <<<"$mr"); ref=$(jq -r .ref <<<"$mr"); title=$(jq -r .title <<<"$mr")
    jq -e --arg u "$url" 'index($u)' <<<"$existing" >/dev/null && continue
    repo="${ref%%!*}"; repo="${repo##*/}"; iid="${ref##*!}"
    if [ "$dry" -eq 1 ]; then echo "  would  link $key ← $repo!$iid"; linked=$((linked + 1)); continue; fi
    link=$(jq -cn --arg g "gitlab-mr-$repo-$iid" --arg u "$url" --arg t "$repo!$iid — $title" '{
      globalId: $g, relationship: "merge request",
      application: {type: "com.gitlab", name: "GitLab"},
      object: {url: $u, title: $t, icon: {url16x16: "https://gitlab.com/favicon.ico", title: "GitLab"}}}')
    if jira POST "/rest/api/3/issue/$key/remotelink" "$link" >/dev/null; then
      echo "  linked $key ← $repo!$iid"; linked=$((linked + 1))
    else failed=$((failed + 1)); fi
  # -c keeps one compact JSON object per line, so each MR arrives whole however its title is
  # punctuated. No delimiter is involved, so nothing in the payload can be read as structure.
  done < <(jq -c '.[]' <<<"$mrs")
done <<<"$plan"

# Work with no MR yet: a ticket-named worktree with a commit or checkout in the window was
# taken into work, so its ticket is at least In Progress.
since_epoch=$(date -j -u -f %Y-%m-%dT%H:%M:%SZ "$since" +%s 2>/dev/null || date -u -d "$since" +%s 2>/dev/null) \
  || echo "sync-tickets: cannot read --since $since as a time; worktrees not checked" >&2
for wt in "$WORKTREES_DIR"/*/"$JIRA_PROJECT"-*; do
  [ -n "$since_epoch" ] && [ -f "$wt/.git" ] || continue
  key=$(basename "$wt")
  case "$key" in *[!A-Z0-9-]*) continue ;; esac
  case "$seen" in *" $key "*) continue ;; esac
  admin=$(sed -n 's/^gitdir: //p' "$wt/.git")
  touched="$admin/logs/HEAD"; [ -f "$touched" ] || touched="$admin/HEAD"
  [ -f "$touched" ] || continue
  [ "$(stat -f %m "$touched" 2>/dev/null || stat -c %Y "$touched")" -ge "$since_epoch" ] || continue
  seen="$seen$key "
  move "$key" "In Progress"
done

# The day moves tickets as work starts, goes ready and merges (ticket-move); this run only
# verifies, so each move it had to make is one the day missed.
[ "$moved" -eq 0 ] || echo "drift: the day missed $(IFS=,; echo "${drift_keys[*]}" | sed 's/,/, /g')"
echo "since $since: $moved moved (drift), $linked linked, $behind behind, $skipped skipped, $needs_summary needs_summary, $failed failed$([ "$dry" -eq 1 ] && echo ' (dry run)')"
[ "$needs_summary" -eq 0 ] || echo "needs summary: $(IFS=,; echo "${needs_keys[*]}" | sed 's/,/, /g')"

if [ "$dry" -eq 0 ] && [ "$failed" -eq 0 ]; then
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$started" > "$STATE_FILE"
fi
[ "$failed" -eq 0 ]
