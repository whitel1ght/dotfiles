#!/usr/bin/env bash
# Relink the Pi config into ~/.pi/agent without running the whole install.sh.
#
#   plink       relink everything
#   plink -n    show what would change, touch nothing
#   plink -h    this help
#
# install.sh links these too, but this helper repairs only symlinks owned by
# this checkout. Foreign links are preserved. Reach for it after moving the
# repo, or when a skill or extension simply never appears. Start a new Pi session afterwards to pick
# up startup defaults and the complete resource configuration.
#
# Only config items are linked. ~/.pi/agent also holds auth.json, sessions/,
# install/ and npm/, which Pi owns and which are machine-local. settings.json is
# seeded as a per-host file rather than linked, because Pi writes changelog and
# device state into it; an owned legacy link is converted, never re-created.
#
# Env overrides (used by bin/plink.test.sh):
#   DOTFILES_DIR  repo root; defaults to the parent of this script
#   PI_AGENT_DIR  agent dir; defaults to ~/.pi/agent
set -uo pipefail

# Resolve this script through any symlink so the repo is found from
# ~/.local/bin/plink as well as from a checkout.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    self_dir="$(cd -P "$(dirname "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
REPO_DIR="$(cd -P "$(dirname "$self")/.." && pwd)"

DOTFILES_DIR="${DOTFILES_DIR:-$REPO_DIR}"
PI_SRC="$DOTFILES_DIR/pi"
PI_DEST="${PI_AGENT_DIR:-$HOME/.pi/agent}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()  { echo -e "${GREEN}[plink]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[plink]${NC} $1"; }
log_error() { echo -e "${RED}[plink]${NC} $1" >&2; }

usage() {
    cat <<'EOF2'
Usage: plink [options]

Relink the Pi config into ~/.pi/agent.

Options:
  -n, --dry-run  show what would change, touch nothing
  -h, --help     show this help

Env:
  DOTFILES_DIR   repo root (default: parent of this script)
  PI_AGENT_DIR   agent dir (default: ~/.pi/agent)
EOF2
}

DRY_RUN=0
CHANGED=0
SKIPPED=0
FAILURES=0

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        -h|--help)    usage; exit 0 ;;
        *) log_error "unknown option: $arg"; exit 2 ;;
    esac
done

# Point $dest at $src, replacing only links whose resolved targets are inside
# this checkout. Never delete a foreign/user-owned symlink.
link_item() {
    local src="$1" dest="$2" src_real dest_real backup n
    src_real="$(readlink -m -- "$src")"

    if [ -L "$dest" ]; then
        dest_real="$(readlink -m -- "$dest")"
        [ "$dest_real" = "$src_real" ] && return 0
        case "$dest_real" in
            "$DOTFILES_DIR"/*) ;;
            *)
                log_warn "leaving foreign link untouched: $dest -> $(readlink "$dest")"
                SKIPPED=$((SKIPPED + 1))
                return 0
                ;;
        esac
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would re-point owned link $dest -> $src (now $(readlink "$dest"))"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        rm -f -- "$dest"
        ln -s -- "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_info "re-pointed owned link $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi

    if [ -e "$dest" ]; then
        backup="$dest.backup"; n=1
        while [ -e "$backup" ] || [ -L "$backup" ]; do
            backup="$dest.backup.$n"
            n=$((n + 1))
        done
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would back up $dest to $backup and link it -> $src"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        mv -- "$dest" "$backup" || { log_error "failed to back up $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_warn "backed up $dest -> $backup"
    fi

    if [ "$DRY_RUN" = 1 ]; then
        log_info "would link $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi
    ln -s -- "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
    log_info "linked $dest -> $src"
    CHANGED=$((CHANGED + 1))
}

if [ ! -d "$PI_SRC" ]; then
    log_error "no Pi config at $PI_SRC (set DOTFILES_DIR)"
    exit 1
fi

[ "$DRY_RUN" = 1 ] || { mkdir -p "$PI_DEST"; mkdir -p "$HOME/.agents"; }

# settings.json is per-host state: Pi writes changelog markers and device
# identity into it, so pi/settings.json is only a seed. install.sh seeds it and
# this helper never links it. A legacy link owned by this checkout is converted
# into a regular copy of the same content so Pi's writes stop dirtying the repo;
# real files and foreign links are left untouched.
per_host_settings() {
    local src="$1" dest="$2" src_real dest_real tmp backup n
    src_real="$(readlink -m -- "$src")"
    dest_real="$(readlink -m -- "$dest")"
    if [ -L "$dest" ]; then
        if [ "$dest_real" != "$src_real" ]; then
            log_warn "leaving foreign settings link untouched: $dest -> $(readlink "$dest")"
            SKIPPED=$((SKIPPED + 1))
            return 0
        fi
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would convert owned settings link $dest into a per-host file"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        backup="$dest.symlink.backup"; n=1
        while [ -e "$backup" ] || [ -L "$backup" ]; do
            backup="$dest.symlink.backup.$n"
            n=$((n + 1))
        done
        cp -P -- "$dest" "$backup" \
            || { log_error "failed to record the old $dest link"; FAILURES=$((FAILURES + 1)); return 0; }
        tmp="$(mktemp "$dest.XXXXXX")" \
            || { log_error "failed to stage $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        if ! cat -- "$src_real" > "$tmp"; then
            rm -f -- "$tmp"
            log_error "failed to copy $src_real"
            FAILURES=$((FAILURES + 1))
            return 0
        fi
        chmod 664 -- "$tmp"
        mv -f -- "$tmp" "$dest" \
            || { log_error "failed to convert $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_info "converted owned settings link $dest into a per-host file (old link recorded at $backup)"
        CHANGED=$((CHANGED + 1))
        return 0
    fi
    [ -e "$dest" ] && return 0
    [ -f "$src" ] || return 0
    if [ "$DRY_RUN" = 1 ]; then
        log_info "would seed $dest from $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi
    tmp="$(mktemp "$dest.XXXXXX")" \
        || { log_error "failed to stage $dest"; FAILURES=$((FAILURES + 1)); return 0; }
    if ! cat -- "$src" > "$tmp"; then
        rm -f -- "$tmp"
        log_error "failed to copy $src"
        FAILURES=$((FAILURES + 1))
        return 0
    fi
    chmod 664 -- "$tmp"
    mv -f -- "$tmp" "$dest" \
        || { log_error "failed to seed $dest"; FAILURES=$((FAILURES + 1)); return 0; }
    log_info "seeded $dest from $src as a per-host file"
    CHANGED=$((CHANGED + 1))
}

for name in models.json mcp-servers.json model-selection.md APPEND_SYSTEM.md; do
    [ -f "$PI_SRC/$name" ] && link_item "$PI_SRC/$name" "$PI_DEST/$name"
done

per_host_settings "$PI_SRC/settings.json" "$PI_DEST/settings.json"

# mcp.json used to be linked here. Pi does not expand ${VAR} in its url or
# oauth.clientId, so the servers now live in mcp-servers.json, which the mcp-env
# extension expands and registers. A leftover link would win over them.
old_mcp="$PI_DEST/mcp.json"
if [ -L "$old_mcp" ] && [ "$(readlink -m "$old_mcp")" = "$(readlink -m "$PI_SRC/mcp.json")" ]; then
    if [ "$DRY_RUN" = 1 ]; then
        log_warn "would remove $old_mcp (replaced by mcp-servers.json)"
    else
        rm -f "$old_mcp" && log_info "removed $old_mcp (replaced by mcp-servers.json)"
    fi
    CHANGED=$((CHANGED + 1))
fi

# Retire only links owned by this checkout, never user files or foreign links.
for name in subagents.json subagent-models.json subagent-model-guide.md subagents-research.md; do
    dest="$PI_DEST/$name"
    if [ -L "$dest" ] && [ "$(readlink -m "$dest")" = "$(readlink -m "$PI_SRC/$name")" ]; then
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would remove retired $dest"
        elif ! rm -f "$dest"; then
            log_error "failed to remove $dest"
            FAILURES=$((FAILURES + 1))
            continue
        else
            log_info "removed retired $dest"
        fi
        CHANGED=$((CHANGED + 1))
    fi
done

# Pi reads CLAUDE.md-style instructions from the agent dir. One file serves
# both tools, so the Claude Code instructions are linked rather than copied.
[ -f "$DOTFILES_DIR/claude/CLAUDE.md" ] && \
    link_item "$DOTFILES_DIR/claude/CLAUDE.md" "$PI_DEST/AGENTS.md"

# Skills pi discovers under the agent dir. Modules are the shared context files
# the skills and agents reference as ~/.agents/modules/ — the cross-runtime
# directory every agent reads, so the skills stay agent-agnostic rather than
# pi-specific. Lives outside ~/.pi/agent on purpose.
[ -d "$PI_SRC/skills" ] && \
    link_item "$PI_SRC/skills" "$PI_DEST/skills"
[ -d "$PI_SRC/modules" ] && \
    link_item "$PI_SRC/modules" "$HOME/.agents/modules"

# Slash commands. The shared source is claude/commands; pi/prompts holds the
# Pi-specific ports of the ones whose subagent mechanics differ.
if [ -d "$PI_SRC/prompts" ]; then
    link_item "$PI_SRC/prompts" "$PI_DEST/prompts"
fi

# Pi agent metadata and tool restrictions differ from skill frontmatter.
[ -d "$PI_SRC/agents" ] && \
    link_item "$PI_SRC/agents" "$PI_DEST/agents"

[ -d "$PI_SRC/extensions" ] && link_item "$PI_SRC/extensions" "$PI_DEST/extensions"

# Vendored Pi packages: patched copies of upstream extensions. Pi resolves a
# relative package path against the settings file it read, which is the link at
# $PI_DEST/settings.json, so packages/ has to sit beside it in the agent dir.
[ -d "$PI_SRC/packages" ] && link_item "$PI_SRC/packages" "$PI_DEST/packages"

if [ "$DRY_RUN" = 1 ]; then
    log_info "$CHANGED change(s) pending (dry run)"
elif [ "$CHANGED" = 0 ] && [ "$SKIPPED" = 0 ]; then
    log_info "already linked; nothing to do"
elif [ "$CHANGED" = 0 ]; then
    log_warn "$SKIPPED foreign link(s) left untouched"
else
    [ "$SKIPPED" = 0 ] || log_warn "$SKIPPED foreign link(s) left untouched"
    log_info "start a new Pi session to pick up the changes"
fi

[ "$FAILURES" -eq 0 ] || exit 1
exit 0
