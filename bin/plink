#!/usr/bin/env bash
# Relink the Pi config into ~/.pi/agent without running the whole install.sh.
#
#   plink       relink everything
#   plink -n    show what would change, touch nothing
#   plink -h    this help
#
# install.sh links these too, but its create_symlink skips any target that is
# already a symlink — even a broken one, or one pointing at the wrong place.
# plink re-points it. Reach for it after moving the repo, or when a skill or
# extension simply never appears. Start a new Pi session afterwards to pick
# up startup defaults and the complete resource configuration.
#
# Only config items are linked. ~/.pi/agent also holds auth.json, sessions/,
# install/ and npm/, which Pi owns and which are machine-local.
#
# Env overrides (used by bin/plink.test.sh):
#   DOTFILES_DIR  repo root; defaults to the parent of this script
#   PI_AGENT_DIR  agent dir; defaults to ~/.pi/agent
set -uo pipefail

# Resolve this script through any symlink so the repo is found from
# ~/.local/bin/plink as well as from a checkout.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    self_dir="$(cd -P "$(dirname "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$self_dir/$self" ;; esac
done
REPO_DIR="$(cd -P "$(dirname "$self")/.." && pwd)"

DOTFILES_DIR="${DOTFILES_DIR:-$REPO_DIR}"
PI_SRC="$DOTFILES_DIR/pi"
PI_DEST="${PI_AGENT_DIR:-$HOME/.pi/agent}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()  { echo -e "${GREEN}[plink]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[plink]${NC} $1"; }
log_error() { echo -e "${RED}[plink]${NC} $1" >&2; }

usage() {
    cat <<'EOF2'
Usage: plink [options]

Relink the Pi config into ~/.pi/agent.

Options:
  -n, --dry-run  show what would change, touch nothing
  -h, --help     show this help

Env:
  DOTFILES_DIR   repo root (default: parent of this script)
  PI_AGENT_DIR   agent dir (default: ~/.pi/agent)
EOF2
}

DRY_RUN=0
CHANGED=0
FAILURES=0

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        -h|--help)    usage; exit 0 ;;
        *) log_error "unknown option: $arg"; exit 2 ;;
    esac
done

# Point $dest at $src, repairing rather than skipping what is already there.
link_item() {
    local src="$1" dest="$2"

    if [ -L "$dest" ]; then
        [ "$(readlink "$dest")" = "$src" ] && return 0
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would re-point $dest -> $src (now $(readlink "$dest"))"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        rm -f "$dest"
        ln -s "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_info "re-pointed $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi

    if [ -e "$dest" ]; then
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would back up $dest and link it -> $src"
            CHANGED=$((CHANGED + 1))
            return 0
        fi
        mv "$dest" "$dest.backup" || { log_error "failed to back up $dest"; FAILURES=$((FAILURES + 1)); return 0; }
        log_warn "backed up $dest -> $dest.backup"
    fi

    if [ "$DRY_RUN" = 1 ]; then
        log_info "would link $dest -> $src"
        CHANGED=$((CHANGED + 1))
        return 0
    fi
    ln -s "$src" "$dest" || { log_error "failed to link $dest"; FAILURES=$((FAILURES + 1)); return 0; }
    log_info "linked $dest -> $src"
    CHANGED=$((CHANGED + 1))
}

if [ ! -d "$PI_SRC" ]; then
    log_error "no Pi config at $PI_SRC (set DOTFILES_DIR)"
    exit 1
fi

[ "$DRY_RUN" = 1 ] || { mkdir -p "$PI_DEST"; mkdir -p "$HOME/.agents"; }

for name in settings.json models.json mcp-servers.json model-selection.md APPEND_SYSTEM.md; do
    [ -f "$PI_SRC/$name" ] && link_item "$PI_SRC/$name" "$PI_DEST/$name"
done

# mcp.json used to be linked here. Pi does not expand ${VAR} in its url or
# oauth.clientId, so the servers now live in mcp-servers.json, which the mcp-env
# extension expands and registers. A leftover link would win over them.
old_mcp="$PI_DEST/mcp.json"
if [ -L "$old_mcp" ] && [ "$(readlink "$old_mcp")" = "$PI_SRC/mcp.json" ]; then
    if [ "$DRY_RUN" = 1 ]; then
        log_warn "would remove $old_mcp (replaced by mcp-servers.json)"
    else
        rm -f "$old_mcp" && log_info "removed $old_mcp (replaced by mcp-servers.json)"
    fi
    CHANGED=$((CHANGED + 1))
fi

# Retire only links owned by this checkout, never user files or foreign links.
for name in subagents.json subagent-models.json subagent-model-guide.md subagents-research.md; do
    dest="$PI_DEST/$name"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$PI_SRC/$name" ]; then
        if [ "$DRY_RUN" = 1 ]; then
            log_warn "would remove retired $dest"
        elif ! rm -f "$dest"; then
            log_error "failed to remove $dest"
            FAILURES=$((FAILURES + 1))
            continue
        else
            log_info "removed retired $dest"
        fi
        CHANGED=$((CHANGED + 1))
    fi
done

# Pi reads CLAUDE.md-style instructions from the agent dir. One file serves
# both tools, so the Claude Code instructions are linked rather than copied.
[ -f "$DOTFILES_DIR/claude/CLAUDE.md" ] && \
    link_item "$DOTFILES_DIR/claude/CLAUDE.md" "$PI_DEST/AGENTS.md"

# Skills pi discovers under the agent dir. Modules are the shared context files
# the skills and agents reference as ~/.agents/modules/ — the cross-runtime
# directory every agent reads, so the skills stay agent-agnostic rather than
# pi-specific. Lives outside ~/.pi/agent on purpose.
[ -d "$PI_SRC/skills" ] && \
    link_item "$PI_SRC/skills" "$PI_DEST/skills"
[ -d "$PI_SRC/modules" ] && \
    link_item "$PI_SRC/modules" "$HOME/.agents/modules"

# Team skills: generated from the claude-components clone Claude Code loads its
# plugins from, so pi follows `git pull` there instead of keeping hand forks.
# pi/settings.json lists skills-team; pi/gen/pi_skills.py explains the rewrite.
# pi/team-skills.json picks what is mirrored: the plugins Claude Code enables, plus single skills
# pi uses from the others (D-661). Every mirrored description is in every pi session's prompt.
CC_SRC="${CLAUDE_COMPONENTS_DIR:-$HOME/projects/claude-components}"
PI_TEAM_SELECT=""
[ -f "$PI_SRC/team-skills.json" ] && PI_TEAM_SELECT="$PI_SRC/team-skills.json"
if [ ! -d "$CC_SRC/plugins" ]; then
    log_warn "claude-components not found at $CC_SRC; team skills not regenerated"
elif [ "$DRY_RUN" = 1 ]; then
    log_info "would regenerate team skills from $CC_SRC into $PI_DEST/skills-team"
    CHANGED=$((CHANGED + 1))
elif python3 "$PI_SRC/gen/pi_skills.py" --src "$CC_SRC" --out "$PI_DEST/skills-team" \
        ${PI_TEAM_SELECT:+--select "$PI_TEAM_SELECT"} >/dev/null; then
    log_info "regenerated team skills from $CC_SRC ($(git -C "$CC_SRC" rev-parse --short HEAD 2>/dev/null || echo '?'))"
else
    log_error "team skill generation failed"
    FAILURES=$((FAILURES + 1))
fi

# billion-context (context compression) reads its config from
# ~/.config/billion-context/billion-context.json. It seeds that file once with {"providers":{}} and never overwrites an existing
# one, so the versioned copy is safe to link; a hand-edited file is backed up
# instead of clobbered. Lives outside ~/.pi/agent because that is where the
# package looks, not where Pi does.
if [ -f "$PI_SRC/billion-context.json" ]; then
    [ "$DRY_RUN" = 1 ] || mkdir -p "$HOME/.config/billion-context"
    link_item "$PI_SRC/billion-context.json" "$HOME/.config/billion-context/billion-context.json"
fi

# Slash commands. The shared source is claude/commands; pi/prompts holds the
# Pi-specific ports of the ones whose subagent mechanics differ.
if [ -d "$PI_SRC/prompts" ]; then
    link_item "$PI_SRC/prompts" "$PI_DEST/prompts"
fi

# Agents: the team's come from the same claude-components clone, written with
# pi's header (pi/gen/pi_agents.py); the pi-only ones in pi/agents are linked in
# beside them. Without the clone, agents/ links straight to pi/agents, unless an
# earlier run already generated it, which is kept rather than lose the team ones.
if [ -d "$CC_SRC/plugins" ] && [ -f "$PI_SRC/gen/pi_agents.py" ]; then
    if [ "$DRY_RUN" = 1 ]; then
        log_info "would regenerate agents from $CC_SRC and $PI_SRC/agents into $PI_DEST/agents"
        CHANGED=$((CHANGED + 1))
    elif out="$(python3 "$PI_SRC/gen/pi_agents.py" --src "$CC_SRC" --local "$PI_SRC/agents" --out "$PI_DEST/agents" 2>&1)"; then
        log_info "${out#pi_agents: }"
    else
        log_error "agent generation failed: $out"
        FAILURES=$((FAILURES + 1))
    fi
elif [ -f "$PI_DEST/agents/.generated.json" ]; then
    log_warn "claude-components not found; keeping the generated $PI_DEST/agents"
elif [ -d "$PI_SRC/agents" ]; then
    link_item "$PI_SRC/agents" "$PI_DEST/agents"
fi

[ -d "$PI_SRC/extensions" ] && link_item "$PI_SRC/extensions" "$PI_DEST/extensions"

# Playbooks are hand-kept on both sides; say when a Claude one moved on.
if [ -x "$DOTFILES_DIR/bin/pi-parity" ] && git -C "$DOTFILES_DIR" rev-parse >/dev/null 2>&1; then
    parity="$(cd "$DOTFILES_DIR" && bin/pi-parity check 2>&1)" || log_warn "$parity"
fi

if [ "$DRY_RUN" = 1 ]; then
    log_info "$CHANGED change(s) pending (dry run)"
elif [ "$CHANGED" = 0 ]; then
    log_info "already linked; nothing to do"
else
    log_info "start a new Pi session to pick up the changes"
fi

[ "$FAILURES" -eq 0 ] || exit 1
exit 0
