#!/usr/bin/env python3
"""PreToolUse hook (Bash): keep stored credentials out of agent transcripts.

secrets-guard covers the secrets folder. This covers the other places a token
lives, after a watch-mrs fixer on the ThinkPad (2026-11-16) pulled the GitLab
token from the keyring and prod CI variables (a Duplo token, a Slack webhook)
into /tmp files and its transcript. Blocked:

- GitLab CI/CD variables: `glab variable get|list|export`, and any GitLab API
  call (`glab api`, curl to gitlab.com/api) whose path holds `/variables`;
- token stores: `secret-tool lookup`, macOS `security find-*-password`,
  `glab auth status -t|--show-token`, `glab config get token`, `gh auth token`,
  `git credential fill`;
- credential files: ~/.aws/credentials, ~/.config/glab-cli/config.yml,
  ~/.docker/config.json, ~/.netrc, ~/.pgpass, ~/.git-credentials;
- `aws configure get|export-credentials`;
- `aws codeartifact get-authorization-token` unless its output goes straight
  into `$(...)` (e.g. `export CODEARTIFACT_AUTH_TOKEN=$(aws codeartifact ...)`),
  so the token never lands in a file or on screen.

Exit 2 blocks with the reason on stderr; anything unreadable passes. Like
secrets-guard it stops accidents, not a determined process running as you.
Claude Code runs this from ~/.claude/settings.json, pi through claude-hooks.
"""

import json
import re
import sys

RULES = [
    (re.compile(r"\bglab\s+variable\s+(?:get|list|ls|export)\b"),
     "GitLab CI/CD variables hold deploy and prod credentials"),
    (re.compile(r"\bsecret-tool\s+lookup\b"), "the keyring holds stored tokens"),
    (re.compile(r"\bsecurity\s+find-(?:generic|internet)-password\b"), "the macOS keychain holds stored tokens"),
    (re.compile(r"\bglab\s+auth\s+status\b[^;&|\n]*\s(?:-t\b|--show-token\b)"), "it prints the GitLab token"),
    (re.compile(r"\bglab\s+config\s+get\s+token\b"), "it prints the GitLab token"),
    (re.compile(r"\bgh\s+auth\s+token\b"), "it prints the GitHub token"),
    (re.compile(r"\bgit\s+credential\s+fill\b"), "it prints stored git credentials"),
    (re.compile(r"\.aws/credentials\b"), "~/.aws/credentials holds AWS keys"),
    (re.compile(r"glab-cli/config\.yml\b"), "glab's config holds the GitLab token"),
    (re.compile(r"\.docker/config\.json\b"), "Docker's config holds registry tokens"),
    (re.compile(r"(?:^|[\s/'\"=])\.netrc\b"), ".netrc holds passwords"),
    (re.compile(r"(?:^|[\s/'\"=])\.pgpass\b"), ".pgpass holds database passwords"),
    (re.compile(r"\.git-credentials\b"), ".git-credentials holds git passwords"),
    (re.compile(r"\baws\s+configure\s+(?:get|export-credentials)\b"), "it prints AWS credentials"),
]
GITLAB_API = re.compile(r"\bglab\s+api\b|gitlab\.com/api\b", re.I)
VARIABLES = re.compile(r"/variables\b")
CODEARTIFACT = re.compile(r"\baws\s+codeartifact\s+get-authorization-token\b")
INLINE_CODEARTIFACT = re.compile(r"\$\(\s*aws\s+codeartifact\s+get-authorization-token\b[^()]*\)")
# A redirect into a file (not /dev/null or another descriptor), or a command that shows a value.
FILE_REDIRECT = re.compile(r"(?<![<\d&])>>?\s*(?!/dev/null\b|&)\S")
PRINTS = re.compile(r"(?:^|[;&|(\s])(?:echo|printf|cat|tee)\b")


def reason(command: str) -> str | None:
    for rule, why in RULES:
        if rule.search(command):
            return why
    if GITLAB_API.search(command) and VARIABLES.search(command):
        return "GitLab CI/CD variables hold deploy and prod credentials"
    if CODEARTIFACT.search(command):
        rest = INLINE_CODEARTIFACT.sub("", command)
        if CODEARTIFACT.search(rest) or FILE_REDIRECT.search(rest) or PRINTS.search(rest):
            return ("a CodeArtifact token goes straight into the build, never a file or the screen: "
                    "export CODEARTIFACT_AUTH_TOKEN=$(aws codeartifact get-authorization-token ... --output text)")
    return None


def main() -> int:
    try:
        event = json.load(sys.stdin)
        command = event["tool_input"]["command"]
    except Exception:
        return 0
    if event.get("tool_name") != "Bash" or not isinstance(command, str):
        return 0
    why = reason(command)
    if why is None:
        return 0
    print(f"Blocked: {why}. Credentials stay out of agent transcripts, files and /tmp. "
          "If a task really needs one, stop and ask the user.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
