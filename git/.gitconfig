[user]
	# Set your personal info in ~/.gitconfig.local
	# name = Your Name
	# email = your.email@example.com

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	merges = log --oneline --decorate --graph --all --merges

[core]
	excludesfile = ~/.gitignore_global
	pager = delta

[delta]
	side-by-side = true

# Include private git configuration
[include]
	path = ~/.gitconfig.local